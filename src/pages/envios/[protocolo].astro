---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { NOME_PRODUTO } from '../../config';
import { db } from '../../lib/db.js';
import { autenticado } from '../../lib/auth.js';

if (!autenticado(Astro.request)) return Astro.redirect('/entrar');

const protocolo = Astro.params.protocolo ?? '';
if (!/^[A-Z]{4}-\d{3}$/.test(protocolo)) return Astro.redirect('/envios');

type Envio = {
  protocolo: string; nome_negocio: string; responsavel: string; whatsapp: string;
  endereco: string | null; cidade: string | null; instagram: string | null;
  sobre: string | null; servicos: string; horarios: string; observacoes: string | null;
  arquivos: string; criado_em: string; status: string;
};

const e = db.prepare('SELECT * FROM onboarding WHERE protocolo = ?').get(protocolo) as Envio | undefined;
if (!e) return Astro.redirect('/envios');

const parse = <T,>(s: string): T[] => { try { return JSON.parse(s) as T[]; } catch { return []; } };
const servicos = parse<{ nome: string; preco: string; duracao: string }>(e.servicos);
const horarios = parse<{ dia: string; horario: string }>(e.horarios);
const fotos = parse<{ nome: string; arquivo: string; bytes: number }>(e.arquivos);

const quando = new Date(e.criado_em.replace(' ', 'T') + 'Z')
  .toLocaleString('pt-BR', { timeZone: 'America/Fortaleza', dateStyle: 'short', timeStyle: 'short' });

/** Só dígitos, com DDI, para o link do WhatsApp funcionar. */
const zap = (() => {
  const d = (e.whatsapp || '').replace(/\D/g, '');
  if (d.length < 10) return null;
  return d.startsWith('55') ? d : `55${d}`;
})();

// Texto pronto para colar no seu fluxo de implantação — evita reler a tela inteira.
const resumo = [
  `${e.nome_negocio} (${e.protocolo})`,
  `Responsável: ${e.responsavel} — ${e.whatsapp}`,
  e.endereco || e.cidade ? `Endereço: ${[e.endereco, e.cidade].filter(Boolean).join(' — ')}` : '',
  e.instagram ? `Instagram: ${e.instagram}` : '',
  e.sobre ? `\nSobre:\n${e.sobre}` : '',
  servicos.length ? `\nServiços:\n${servicos.map((s) => `- ${s.nome} — ${s.preco} — ${s.duracao}`).join('\n')}` : '',
  horarios.length ? `\nHorários:\n${horarios.map((h) => `- ${h.dia}: ${h.horario}`).join('\n')}` : '',
  e.observacoes ? `\nObservações:\n${e.observacoes}` : '',
].filter(Boolean).join('\n');
---

<Layout title={`${e.nome_negocio} — ${NOME_PRODUTO}`}>
  <header class="border-b border-line/60 sticky top-0 bg-card/95 backdrop-blur z-20">
    <div class="max-w-4xl mx-auto px-5 h-16 flex items-center justify-between">
      <a href="/envios" class="text-xs text-cream/45 hover:text-cream transition-colors">← Envios</a>
      <span class="font-mono text-xs text-brand-light">{e.protocolo}</span>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-5 py-8 pb-28">

    <div class="flex items-start justify-between gap-4 flex-wrap mb-8">
      <div>
        <h1 class="font-serif text-3xl text-cream leading-tight">{e.nome_negocio}</h1>
        <p class="text-sm text-cream/45 mt-1.5">Enviado em {quando}</p>
      </div>
      {zap && (
        <a href={`https://wa.me/${zap}`} target="_blank" rel="noopener"
          class="shrink-0 inline-flex items-center gap-2 border border-brand/40 text-brand-light hover:bg-brand hover:text-on-brand text-xs font-semibold uppercase tracking-widest px-4 py-2.5 rounded-sm transition-colors">
          Chamar no WhatsApp
        </a>
      )}
    </div>

    <div class="grid sm:grid-cols-2 gap-px bg-line/60 border border-line/60 rounded-lg overflow-hidden mb-8">
      {[
        ['Responsável', e.responsavel],
        ['WhatsApp', e.whatsapp],
        ['Endereço', e.endereco],
        ['Cidade', e.cidade],
        ['Instagram', e.instagram],
      ].filter(([, v]) => v).map(([r, v]) => (
        <div class="bg-card p-4">
          <p class="text-[11px] uppercase tracking-[0.15em] text-cream/45 mb-1">{r}</p>
          <p class="text-cream text-sm break-words">{v}</p>
        </div>
      ))}
    </div>

    {e.sobre && (
      <section class="mb-8">
        <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-cream/50 mb-3">Como ele descreve a barbearia</h2>
        <p class="text-cream/80 leading-relaxed border-l-2 border-brand/40 pl-4">{e.sobre}</p>
      </section>
    )}

    {servicos.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-cream/50 mb-3">Serviços ({servicos.length})</h2>
        <div class="border border-line/60 rounded-lg overflow-hidden divide-y divide-line/60">
          {servicos.map((s) => (
            <div class="bg-card px-4 py-2.5 flex items-center justify-between gap-4 text-sm">
              <span class="text-cream truncate">{s.nome}</span>
              <span class="shrink-0 text-cream/50 tabular-nums">{s.preco}{s.duracao && ` · ${s.duracao}`}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {horarios.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-cream/50 mb-3">Horários</h2>
        <div class="border border-line/60 rounded-lg overflow-hidden divide-y divide-line/60">
          {horarios.map((h) => (
            <div class="bg-card px-4 py-2.5 flex items-center justify-between gap-4 text-sm">
              <span class="text-cream">{h.dia}</span>
              <span class="text-cream/50">{h.horario}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {e.observacoes && (
      <section class="mb-8">
        <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-cream/50 mb-3">Observações</h2>
        <p class="text-cream/80 leading-relaxed border-l-2 border-brand/40 pl-4">{e.observacoes}</p>
      </section>
    )}

    <section class="mb-8">
      <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-cream/50 mb-3">
        Fotos ({fotos.length})
      </h2>
      {fotos.length === 0 ? (
        <p class="text-sm text-cream/45 border border-dashed border-line rounded-lg py-8 text-center">
          Não mandou foto nenhuma. Vale cobrar no WhatsApp — é o que mais atrasa a entrega.
        </p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {fotos.map((f) => (
            <a href={`/api/uploads/${e.protocolo}/${f.arquivo}`} target="_blank" rel="noopener"
              class="block border border-line/60 rounded-lg overflow-hidden hover:border-brand/40 transition-colors group">
              <img src={`/api/uploads/${e.protocolo}/${f.arquivo}`} alt={f.nome} loading="lazy"
                class="w-full aspect-square object-cover bg-card" />
              <p class="px-2 py-1.5 text-[10px] text-cream/45 truncate" title={f.nome}>
                {f.nome} · {(f.bytes / 1024).toFixed(0)} KB
              </p>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>

  <div class="fixed bottom-0 left-0 right-0 border-t border-line/60 bg-card/95 backdrop-blur px-5 py-3 z-30">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 flex-wrap">
      <button id="copiar" data-resumo={resumo}
        class="text-xs text-cream/50 hover:text-brand-light border border-line hover:border-brand/40 px-3 py-2 rounded transition-colors">
        Copiar tudo em texto
      </button>
      <div class="flex items-center gap-2">
        <span id="status-msg" class="text-xs text-cream/45"></span>
        {['novo', 'em_andamento', 'concluido'].map((st) => (
          <button data-status={st} data-protocolo={e.protocolo}
            class:list={['btn-status text-xs px-3 py-2 rounded border transition-colors',
              e.status === st ? 'border-brand/50 text-brand-light bg-brand/10' : 'border-line text-cream/40 hover:text-cream/70']}>
            {st === 'novo' ? 'Novo' : st === 'em_andamento' ? 'Em andamento' : 'Concluído'}
          </button>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const msg = document.getElementById('status-msg');

  document.getElementById('copiar')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget;
    try {
      await navigator.clipboard.writeText(btn.dataset.resumo);
      const t = btn.textContent; btn.textContent = 'Copiado';
      setTimeout(() => { btn.textContent = t; }, 1500);
    } catch {
      msg.textContent = 'O navegador bloqueou a cópia';
    }
  });

  document.querySelectorAll('.btn-status').forEach((b) => {
    b.addEventListener('click', async () => {
      const { status, protocolo } = b.dataset;
      msg.textContent = 'Salvando…';
      try {
        const res = await fetch(`/api/envios/${protocolo}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status }),
        });
        if (res.ok) { location.reload(); return; }
        const d = await res.json();
        msg.textContent = d.error ?? 'Não deu certo';
      } catch { msg.textContent = 'Erro de conexão'; }
    });
  });
</script>
