---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { NOME_PRODUTO, EXEMPLO_URL, whatsappUrl } from '../config';

const wa = whatsappUrl('Olá! Vi a demonstração e queria ver o sistema funcionando de verdade.');

// Cada item vira um bloco com espaço para a imagem. Coloque os arquivos em
// public/demo/ com estes nomes e as molduras se preenchem sozinhas.
const telas = [
  { img: '/demo/site.png',      titulo: 'O site',              texto: 'A página que o cliente vê: suas fotos, seus serviços com preço, onde você fica e o botão de agendar. Abre bem no celular, que é de onde quase todo mundo entra.' },
  { img: '/demo/agendamento.png', titulo: 'O agendamento',     texto: 'O cliente escolhe serviço, profissional e horário. Só aparecem horários realmente livres — não dá para marcar em cima de outro.' },
  { img: '/demo/agenda.png',    titulo: 'Sua agenda do dia',   texto: 'O que você abre de manhã: quem vem, a que horas, qual serviço. Dá para remarcar, cancelar, marcar quem faltou e fechar a comanda.' },
  { img: '/demo/relatorio.png', titulo: 'Seu faturamento',     texto: 'Quanto entrou no dia, na semana e no mês. Qual serviço rende mais, qual profissional atendeu mais, e quanto os furos custaram.' },
];
---

<Layout title={`Como funciona na prática — ${NOME_PRODUTO}`}>
  <header class="border-b border-line/60">
    <div class="max-w-5xl mx-auto px-5 h-16 flex items-center justify-between">
      <a href="/" class="font-serif text-lg tracking-wide text-cream">{NOME_PRODUTO}</a>
      <a href={wa} target="_blank" rel="noopener"
        class="text-xs font-semibold uppercase tracking-widest border border-brand/40 text-brand-light hover:bg-brand hover:text-on-brand px-4 py-2 rounded-sm transition-colors">
        Falar no WhatsApp
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-5 py-16 sm:py-20">
    <h1 class="font-serif text-3xl sm:text-4xl text-cream leading-tight max-w-2xl">
      Como fica na prática
    </h1>
    <p class="mt-4 text-cream/55 max-w-xl leading-relaxed">
      São quatro telas. Duas o seu cliente usa, duas são suas.
    </p>

    {EXEMPLO_URL && (
      <a href={EXEMPLO_URL} target="_blank" rel="noopener"
        class="mt-8 inline-flex items-center gap-3 border border-brand/30 bg-card hover:border-brand/50 rounded-lg px-5 py-4 transition-colors group">
        <div>
          <p class="text-cream font-medium text-sm">Ver um site de verdade, no ar</p>
          <p class="text-xs text-cream/45 mt-0.5">Uma barbearia que já usa o sistema</p>
        </div>
        <span class="text-brand-light group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    )}

    <div class="mt-14 space-y-16">
      {telas.map((t, i) => (
        <section class:list={['grid lg:grid-cols-2 gap-8 items-center', i % 2 === 1 && 'lg:[direction:rtl]']}>
          <div class="lg:[direction:ltr]">
            <p class="text-brand-light text-xs font-semibold tracking-[0.25em] uppercase mb-3">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h2 class="font-serif text-2xl text-cream mb-3">{t.titulo}</h2>
            <p class="text-cream/55 leading-relaxed">{t.texto}</p>
          </div>
          <div class="lg:[direction:ltr] rounded-lg border border-line/60 bg-card overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-line/60">
              <span class="w-2.5 h-2.5 rounded-full bg-cream/10"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-cream/10"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-cream/10"></span>
            </div>
            <img src={t.img} alt={t.titulo} loading="lazy"
              class="w-full block bg-card"
              onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'aspect-[4/3] flex items-center justify-center text-center text-xs text-cream/40 px-6',textContent:'Coloque a imagem em public' + this.getAttribute('src')}))" />
          </div>
        </section>
      ))}
    </div>

    <div class="mt-20 border-t border-line/60 pt-12 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl text-cream">Quer ver com as suas fotos?</h2>
      <p class="mt-3 text-cream/55 max-w-lg mx-auto leading-relaxed">
        Me manda três fotos dos seus cortes no WhatsApp e eu te mostro como a sua página ficaria.
      </p>
      <a href={wa} target="_blank" rel="noopener"
        class="mt-7 inline-flex items-center justify-center bg-brand hover:bg-brand-hover text-on-brand font-bold uppercase tracking-widest text-sm px-10 py-4 rounded-sm transition-colors">
        Chamar no WhatsApp
      </a>
    </div>
  </main>

  <footer class="border-t border-line/60 mt-16">
    <div class="max-w-5xl mx-auto px-5 py-8 text-xs text-cream/45">
      <a href="/" class="hover:text-cream/60 transition-colors">← Voltar para a página inicial</a>
    </div>
  </footer>
</Layout>
