---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { NOME_PRODUTO } from '../config';
import { autenticado, senhaConfigurada } from '../lib/auth.js';

if (autenticado(Astro.request)) return Astro.redirect('/envios');
const semSenha = !senhaConfigurada();
---
<Layout title={`Entrar — ${NOME_PRODUTO}`}>
  <main class="min-h-screen flex items-center justify-center px-5">
    <div class="w-full max-w-sm">
      <p class="font-serif text-xl text-cream text-center mb-1">{NOME_PRODUTO}</p>
      <p class="text-xs text-cream/45 text-center mb-8">Área de envios</p>

      {semSenha ? (
        <div class="border border-brand/30 bg-card rounded-lg p-5 text-sm text-cream/70 leading-relaxed">
          <p class="text-cream font-medium mb-2">Falta configurar a senha</p>
          <p>Crie um arquivo <code class="font-mono text-brand-light">.env</code> na raiz do projeto com:</p>
          <pre class="mt-3 bg-ground border border-line rounded p-3 text-xs text-brand-light overflow-x-auto">ADMIN_SENHA=sua-senha-aqui</pre>
          <p class="mt-3 text-cream/50 text-xs">Mínimo 6 caracteres. Depois reinicie o servidor.</p>
        </div>
      ) : (
        <div class="border border-line/60 bg-card rounded-lg p-6">
          <label for="senha" class="block text-xs font-medium text-cream/60 mb-1.5">Senha</label>
          <input id="senha" type="password" autocomplete="current-password"
            class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream focus:border-brand/50 focus:outline-none transition-colors" />
          <p id="erro" class="hidden mt-3 text-xs text-red-400"></p>
          <button id="btn"
            class="mt-4 w-full bg-brand hover:bg-brand-hover text-on-brand font-bold uppercase tracking-widest text-sm py-3 rounded-sm transition-colors disabled:opacity-50">
            Entrar
          </button>
        </div>
      )}
      <p class="mt-6 text-center"><a href="/" class="text-xs text-cream/40 hover:text-cream/50 transition-colors">← Voltar ao site</a></p>
    </div>
  </main>
</Layout>

<script is:inline>
  const btn = document.getElementById('btn');
  if (btn) {
    const campo = document.getElementById('senha');
    const erro = document.getElementById('erro');
    async function entrar() {
      erro.classList.add('hidden');
      btn.disabled = true; btn.textContent = 'Entrando…';
      try {
        const res = await fetch('/api/entrar', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ senha: campo.value }),
        });
        if (res.ok) { location.href = '/envios'; return; }
        const d = await res.json();
        erro.textContent = d.error ?? 'Não deu certo.';
        erro.classList.remove('hidden');
      } catch { erro.textContent = 'Erro de conexão.'; erro.classList.remove('hidden'); }
      btn.disabled = false; btn.textContent = 'Entrar';
    }
    btn.addEventListener('click', entrar);
    campo.addEventListener('keydown', (e) => { if (e.key === 'Enter') entrar(); });
    campo.focus();
  }
</script>
