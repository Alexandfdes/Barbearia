{
  "name": "barbearia-bayron",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/startup.mjs --so-migrations",
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --port 4321 --strictPort",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "astro": "astro",
    "db:migrate": "node --env-file-if-exists=.env scripts/startup.mjs",
    "db:provisionar": "tsx scripts/provisionar.mts",
    "db:seed-bayron": "node --env-file-if-exists=.env scripts/seed-bayron.mjs",
    "db:galeria-bayron": "node --env-file-if-exists=.env scripts/importar-galeria-bayron.mjs",
    "db:studio": "drizzle-kit studio",
    "db:generate": "node scripts/drizzle-kit-desativado.mjs",
    "db:push": "node scripts/drizzle-kit-desativado.mjs",
    "test": "vitest run",
    "test:db": "node scripts/testar.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@aws-sdk/client-s3": "^3.750.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
