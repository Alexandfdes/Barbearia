---
import { TOPSALAO_URL } from '../config';
import { getSettings } from '../lib/settings';
import { tenantAtual } from '../lib/tenant';
import { ehOBayron } from '../lib/bayron';
import { srcsetDe } from '../lib/uploads';
import { Image } from 'astro:assets';
import logoSrc from '../assets/Logo-Bayron3.png';

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
const s = await getSettings();

// O logo em `assets/` é do Bayron e vai junto no build. Barbearia que ainda não
// subiu logo mostra só o nome — nunca a marca de outra barbearia.
const BAYRON = ehOBayron(tenantAtual());
---

<header
  id="header"
  class:list={["fixed top-0 left-0 right-0 z-50 transition-colors duration-300", solid && "bg-black/95 backdrop-blur-md"]}
>
  <div class="w-full px-6 md:px-10 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 relative z-50">
      {s.logoPath ? (
        <img
          src={s.logoPath}
          srcset={srcsetDe(s.logoPath, [96, 256])}
          sizes="40px"
          alt={s.businessName}
          width="40" height="40"
          class="w-10 h-10 rounded-sm object-contain"
        />
      ) : BAYRON ? (
        <Image
          src={logoSrc}
          alt={s.businessName}
          width={80}
          class="w-10 h-10 rounded-sm object-contain"
        />
      ) : null}
      <span class="text-base font-semibold tracking-[0.2em] text-white uppercase">{s.shortName}</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8 text-sm text-neutral-400 uppercase tracking-wider font-medium">
      <a href="#servicos" data-secao="servicos" class="hover:text-white transition-colors duration-300">Serviços</a>
      <a href="#combo" data-secao="combo" class="hidden hover:text-white transition-colors duration-300">Combos</a>
      <a href="#produtos" data-secao="produtos" class="hover:text-white transition-colors duration-300">Produtos</a>
      <a href="#depoimentos" data-secao="depoimentos" class="hover:text-white transition-colors duration-300">Depoimentos</a>
      <a href="#faq" data-secao="faq" class="hover:text-white transition-colors duration-300">FAQ</a>
      <a href="#contato" data-secao="contato" class="hover:text-white transition-colors duration-300">Contato</a>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/portal"
        id="header-cta"
        class="hidden sm:inline-flex border border-white/20 bg-transparent hover:bg-white/10 text-white text-xs font-medium px-6 py-2.5 rounded-sm transition-all duration-300 uppercase tracking-widest"
      >
        Portal
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative z-50 p-2 text-gray-light hover:text-white"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay — FORA do <header> de propósito: o header ganha
     backdrop-blur ao rolar, e backdrop-filter cria um containing block que
     quebraria o position:fixed deste overlay se ele fosse filho do header. -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-dark z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  inert
>
  <nav class="flex flex-col items-center gap-8 text-xl font-medium text-neutral-400 uppercase tracking-wider">
    <a href="#servicos" data-secao="servicos" class="mobile-link hover:text-white transition-colors">Serviços</a>
    <a href="#combo" data-secao="combo" class="hidden mobile-link hover:text-white transition-colors">Combos</a>
    <a href="#produtos" data-secao="produtos" class="mobile-link hover:text-white transition-colors">Produtos</a>
    <a href="#depoimentos" data-secao="depoimentos" class="mobile-link hover:text-white transition-colors">Depoimentos</a>
    <a href="#faq" data-secao="faq" class="mobile-link hover:text-white transition-colors">FAQ</a>
    <a href="#contato" data-secao="contato" class="mobile-link hover:text-white transition-colors">Contato</a>
    <a
      href="/portal"
      class="bg-teal hover:bg-teal-hover text-white px-8 py-3 rounded-md mt-4 tracking-widest font-bold"
    >
      Portal
    </a>
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Seção que não renderiza (barbearia sem produtos, sem depoimentos…) não
    // pode deixar um link no menu que rola para lugar nenhum. Perguntamos ao
    // DOM em vez de repetir aqui as condições de cada componente — assim o
    // menu não sai do lugar quando as regras dos componentes mudarem.
    // `#combo` é a exceção: existe sempre e o ComboBoris revela o link quando
    // há combo hoje.
    document.querySelectorAll('[data-secao]').forEach((a) => {
      const alvo = a.getAttribute('data-secao');
      if (alvo !== 'combo' && !document.getElementById(alvo!)) a.remove();
    });

    const header = document.getElementById('header');
    const hero = document.getElementById('hero');

    if (header) {
      function updateHeaderBg() {
        const threshold = (hero?.offsetHeight ?? 400) - 80;
        const past = window.scrollY > threshold;
        header!.classList.toggle('bg-black/80', past);
        header!.classList.toggle('backdrop-blur-md', past);
      }
      window.addEventListener('scroll', updateHeaderBg, { passive: true });
      updateHeaderBg();
    }

    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-link');
    const wa = document.getElementById('whatsapp-cta'); // botão flutuante do WhatsApp

    if (!btn || !menu || !iconMenu || !iconClose) return;

    // O que o menu aberto cobre — a página, o rodapé, o WhatsApp: tudo que não é o topo nem
    // o próprio menu. Até 13/10/2026 só a opacidade mudava, e o que estava invisível — o menu
    // fechado, ou a página por baixo do menu aberto — continuava no teclado e no leitor de
    // tela (`docs/PENDENCIAS-ABERTAS.md` §2.41). `inert` tira dos dois.
    const porBaixo = () => [...document.body.children].filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el !== menu && el !== header && !(el instanceof HTMLScriptElement),
    );

    function abrir(sim: boolean) {
      if (!btn || !menu || !iconMenu || !iconClose) return;
      menu.classList.toggle('opacity-0', !sim);
      menu.classList.toggle('pointer-events-none', !sim);
      menu.inert = !sim;
      porBaixo().forEach((el) => { el.inert = sim; });
      // O WhatsApp flutua por cima do menu: some da vista enquanto ele está aberto.
      wa?.classList.toggle('opacity-0', sim);
      wa?.classList.toggle('pointer-events-none', sim);
      iconMenu.classList.toggle('hidden', sim);
      iconClose.classList.toggle('hidden', !sim);
      btn.setAttribute('aria-expanded', String(sim));
      document.body.style.overflow = sim ? 'hidden' : '';
    }
    const aberto = () => !menu.classList.contains('opacity-0');

    btn.addEventListener('click', () => abrir(!aberto()));

    links.forEach(link => {
      link.addEventListener('click', () => abrir(false));
    });

    // Esc fecha, e o foco volta ao botão — o link onde ele estava acabou de sair do teclado.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !aberto()) return;
      abrir(false);
      btn.focus();
    });
  });
</script>
