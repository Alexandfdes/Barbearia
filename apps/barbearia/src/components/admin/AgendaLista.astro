---
// Visão em lista da agenda do dia — alternativa densa à timeline proporcional.
// Cada item abre o modal de detalhes via data-action="open-detail" (a delegação
// de cliques vive no [date].astro e cobre o document inteiro), então não há
// lógica de ação duplicada aqui.
//
// O número da linha é o VALOR do atendimento, não o preço do serviço agendado: o
// concluído soma os itens da comanda (`lib/valorDoAtendimento.ts`). Até 15/10/2026 o corte
// de R$ 50 fechado com mais R$ 30 continuava "R$ 50" aqui, e a receita do topo somava 80
// (`docs/PENDENCIAS-ABERTAS.md` §2.43).
//
// Concluído, cancelado ou falta, o script da página refaz a linha sem recarregar — pelos
// `data-list-*` e com a mesma aparência daqui (`lib/situacaoNaAgenda.ts`): a linha que muda
// na hora tem de ser a que a página recarregada mostra.
import { aparenciaDaSituacao, linhaApagada, nomeRiscado } from '../../lib/situacaoNaAgenda.js';

interface Appt {
  id: number;
  status: string;
  isLate?: boolean;
  timeLocal: string;
  endTimeLocal: string;
  customerName: string;
  serviceName: string;
  barberName: string;
  valor: string;
  durationMinutes: number;
}
interface Props {
  appts: Appt[];
  role: 'admin' | 'barber';
}
const { appts, role } = Astro.props;
---

<div class="space-y-2">
  {appts.map(a => {
    const st = aparenciaDaSituacao(a.status, a.isLate);
    const muted = linhaApagada(a.status);
    const riscado = nomeRiscado(a.status);
    return (
      <button
        type="button"
        data-action="open-detail"
        data-id={String(a.id)}
        data-list-appt={String(a.id)}
        class:list={[
          'w-full text-left flex items-center gap-3 bg-white border border-slate-200 border-l-[3px] rounded-md px-4 py-3 hover:border-teal/40 transition-colors',
          st.borda,
          muted && 'opacity-70',
        ]}
      >
        <div class="w-12 shrink-0">
          <p data-list-hora class:list={['text-sm font-bold tabular-nums', muted ? 'text-slate-500' : 'text-slate-900']}>{a.timeLocal}</p>
          <p class="text-[10px] text-slate-400 tabular-nums">{a.endTimeLocal}</p>
        </div>

        <div class="flex-1 min-w-0">
          <p data-list-nome class:list={['text-sm font-medium truncate', muted ? 'text-slate-500' : 'text-slate-900', riscado && 'line-through decoration-1']}>
            {a.customerName}
          </p>
          <p class="text-xs text-slate-500 truncate">
            {a.serviceName}
            {role === 'admin' && <span class="text-slate-400"> · {a.barberName.split(' ')[0]}</span>}
            <span class="text-slate-400"> · {a.durationMinutes}min</span>
          </p>
        </div>

        <div class="text-right shrink-0">
          <p data-list-valor class:list={['text-sm font-semibold tabular-nums', muted ? 'text-slate-400' : 'text-teal']}>{a.valor}</p>
          <p data-list-status class:list={['text-[10px] tabular-nums', st.classe]}>{st.rotulo}</p>
        </div>
      </button>
    );
  })}
</div>
