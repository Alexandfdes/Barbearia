---
/**
 * O painel do operador, por fora: a mesma lateral do painel do barbeiro
 * (`AdminLayout.astro`) — escura, em grupos, o acento só no item ativo —, para o
 * dono do produto reconhecer a casa. Decisão do dono em 12/10/2026
 * (`docs/PENDENCIAS-ABERTAS.md` §3.9).
 *
 * ⚠️ O layout NÃO é a porta. Quem decide se a tela abre é a página, na primeira
 * linha, com `exigirOperador` (`lib/operador.ts`) — antes de qualquer consulta. O
 * layout só desenha o que a página já decidiu mostrar.
 */
import '../styles/global.css';
import { iconeComLetra } from '../lib/iconeDaAba.js';
import { ACCENT_PADRAO } from '../lib/accent.js';
import { NOME_PRODUTO } from '../lib/produto.js';

export type TelaDoOperador = 'inicio' | 'barbearias' | 'cobranca' | 'registro' | 'sistema';

interface Props {
  titulo: string;
  ativo: TelaDoOperador;
}
const { titulo, ativo } = Astro.props;

const grupos: { titulo: string; itens: { id: TelaDoOperador; href: string; label: string; icone: string }[] }[] = [
  {
    titulo: 'Visão geral',
    itens: [
      { id: 'inicio', href: '/operador', label: 'Início', icone: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
    ],
  },
  {
    titulo: 'Clientes',
    itens: [
      { id: 'barbearias', href: '/operador/barbearias', label: 'Barbearias', icone: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
    ],
  },
  {
    titulo: 'Dinheiro',
    itens: [
      { id: 'cobranca', href: '/operador/cobranca', label: 'Cobrança', icone: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
    ],
  },
  {
    titulo: 'Operação',
    itens: [
      { id: 'registro', href: '/operador/registro', label: 'Registro', icone: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
      { id: 'sistema', href: '/operador/sistema', label: 'Sistema', icone: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01' },
    ],
  },
];
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={iconeComLetra(NOME_PRODUTO, ACCENT_PADRAO.color)} />
    <title>{titulo} — Operador · {NOME_PRODUTO}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen font-sans">
    <div class="flex min-h-screen">

      <aside id="lateral"
        class="fixed lg:static inset-y-0 left-0 z-40 w-64 shrink-0 bg-slate-900 text-slate-300 flex flex-col
               -translate-x-full lg:translate-x-0 transition-transform duration-200">
        <div class="h-16 flex items-center gap-2.5 px-5 border-b border-white/10">
          <span class="font-semibold text-white truncate">{NOME_PRODUTO}</span>
          <span class="text-[10px] uppercase tracking-wider bg-teal/25 text-teal-light border border-teal/40 px-1.5 py-0.5 rounded">Operador</span>
        </div>

        <nav class="flex-1 overflow-y-auto py-4" aria-label="Telas do operador">
          {grupos.map((g) => (
            <div class="mb-5">
              <p class="px-5 mb-1.5 text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-500">{g.titulo}</p>
              {g.itens.map((i) => (
                <a href={i.href} aria-current={i.id === ativo ? 'page' : undefined}
                  class:list={['flex items-center gap-3 px-5 py-2.5 text-sm transition-colors border-l-2',
                    i.id === ativo
                      ? 'border-teal bg-white/5 text-white font-medium'
                      : 'border-transparent text-slate-400 hover:text-white hover:bg-white/5']}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={i.icone} />
                  </svg>
                  {i.label}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="border-t border-white/10 px-5 py-3.5">
          <p class="text-xs text-slate-400">A sessão dura 8 horas.</p>
          <form method="post" action="/api/operador/sair">
            <button id="sair" class="mt-1 text-xs text-slate-400 hover:text-red-400 transition-colors">Sair</button>
          </form>
        </div>
      </aside>

      <div id="veu" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden"></div>

      <div class="flex-1 min-w-0 flex flex-col">
        <header class="h-16 bg-white border-b border-slate-200 flex items-center gap-3 px-4 sm:px-6 sticky top-0 z-20">
          <button id="abrir-menu" class="lg:hidden p-1.5 -ml-1.5 text-slate-500 hover:text-slate-800" aria-label="Abrir menu">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 class="text-sm font-semibold text-slate-800 truncate">{titulo}</h1>
          <div class="ml-auto flex items-center gap-3"><slot name="cabecalho" /></div>
        </header>

        <main class="flex-1">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-6"><slot /></div>
        </main>
      </div>
    </div>

    <script>
      const lateral = document.getElementById('lateral');
      const veu = document.getElementById('veu');
      function alterna(abrir: boolean) {
        lateral?.classList.toggle('-translate-x-full', !abrir);
        veu?.classList.toggle('hidden', !abrir);
      }
      document.getElementById('abrir-menu')?.addEventListener('click', () => alterna(true));
      veu?.addEventListener('click', () => alterna(false));
    </script>
  </body>
</html>
