---
import '../styles/global.css';
import { getSettings } from '../lib/settings';
import { tenantAtual, urlDoSite } from '../lib/tenant.js';
import { iconeDaAba } from '../lib/iconeDaAba.js';
import { situacaoDe } from '../lib/situacao.js';
import { avisoDoPainel, TELA_DE_ASSINATURA } from '../lib/assinatura.js';
import { formatInTimeZone } from 'date-fns-tz';
import { fusoDe } from '../lib/timezone.js';

const s = await getSettings();
const barbearia = tenantAtual();
const fuso = fusoDe(barbearia);
// Vazio quando não há domínio próprio nem DOMINIO_BASE: aí o link some,
// em vez de levar o dono para uma página de "barbearia não encontrada".
const enderecoDoSite = urlDoSite(barbearia);
// A faixa do teste e da carência, em toda tela do painel: o prazo que ele não
// vê é o prazo que ele perde (decisão de 08/10/2026, `lib/assinatura.ts`).
const aviso = avisoDoPainel(situacaoDe(barbearia), fuso);

interface Props {
  title?:     string;
  barberName: string;
  role:       'admin' | 'barber';
}
const { title = 'Painel', barberName, role } = Astro.props;
const path = Astro.url.pathname;
const norm = path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
// A agenda de hoje é a do dia da barbearia, não a do servidor (regra 5 do `CLAUDE.md`).
const hoje = formatInTimeZone(new Date(), fuso, 'yyyy-MM-dd');

/**
 * Navegação em grupos, não em fila de abas.
 *
 * A barra horizontal anterior tinha 11 itens que rolavam de lado: no desktop
 * sobrava espaço vazio e no celular metade dos itens ficava escondida sem
 * nenhuma pista de que existia. Agrupar por assunto resolve os dois.
 */
const grupos: { titulo: string; itens: { href: string; label: string; ativo: boolean; icone: string }[] }[] = [
  {
    titulo: 'Atendimento',
    itens: [
      // Até 10/10/2026, "Agenda do dia" levava a esta tela de resumo, que se chama
      // Início — e a agenda de verdade ficava atrás de um botão dela.
      { href: '/admin',          label: 'Início',        ativo: norm === '/admin', icone: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
      { href: `/admin/dia/${hoje}`, label: 'Agenda do dia', ativo: norm.startsWith('/admin/dia'), icone: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { href: '/admin/buscar',   label: 'Buscar cliente', ativo: norm === '/admin/buscar', icone: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' },
      // De PRODUTO: o site chama o agendamento de "Reservar horário", e o barbeiro
      // procurava o agendamento aqui (roteiro de 10/10/2026).
      { href: '/admin/reservas', label: 'Reservas de produto', ativo: norm === '/admin/reservas', icone: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4' },
    ],
  },
  {
    titulo: 'Minha agenda',
    itens: [
      { href: '/admin/servicos',  label: 'Serviços',  ativo: norm === '/admin/servicos', icone: 'M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
      { href: '/admin/horarios',  label: 'Expediente', ativo: norm === '/admin/horarios', icone: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
      { href: '/admin/bloqueios', label: 'Bloqueios', ativo: norm === '/admin/bloqueios', icone: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636' },
    ],
  },
  ...(role === 'admin' ? [{
    titulo: 'Meu estabelecimento',
    itens: [
      { href: '/admin/produtos',      label: 'Produtos',      ativo: norm === '/admin/produtos', icone: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
      { href: '/admin/combos',        label: 'Combos',        ativo: norm === '/admin/combos', icone: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z' },
      { href: '/admin/galeria',       label: 'Galeria',       ativo: norm === '/admin/galeria', icone: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { href: '/admin/barbeiros',     label: 'Equipe',        ativo: norm === '/admin/barbeiros', icone: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
      { href: TELA_DE_ASSINATURA,     label: 'Assinatura',    ativo: norm === TELA_DE_ASSINATURA, icone: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
      { href: '/admin/configuracoes', label: 'Configurações', ativo: norm === '/admin/configuracoes', icone: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
    ],
  }] : []),
  {
    titulo: 'Números',
    itens: [
      { href: '/admin/relatorios', label: 'Relatórios', ativo: norm === '/admin/relatorios', icone: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
    ],
  },
];
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={iconeDaAba(s)} />
    <title>{title} — {s.shortName}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen font-sans">
    <div class="flex min-h-screen">

      <!-- Lateral. Fundo escuro neutro de propósito: a cor de destaque é
           configurável por barbearia (Fase 5), e uma lateral inteira na cor
           escolhida pelo cliente pode ficar horrível. O acento entra só no
           item ativo, onde qualquer cor funciona. -->
      <aside id="lateral"
        class="fixed lg:static inset-y-0 left-0 z-40 w-64 shrink-0 bg-slate-900 text-slate-300 flex flex-col
               -translate-x-full lg:translate-x-0 transition-transform duration-200">
        <div class="h-16 flex items-center gap-2.5 px-5 border-b border-white/10">
          <span class="font-semibold text-white truncate">{s.shortName}</span>
          {role === 'admin' && (
            <span class="text-[10px] uppercase tracking-wider bg-teal/25 text-teal-light border border-teal/40 px-1.5 py-0.5 rounded">Dono</span>
          )}
        </div>

        <nav class="flex-1 overflow-y-auto py-4">
          {grupos.map((g) => (
            <div class="mb-5">
              <p class="px-5 mb-1.5 text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-500">{g.titulo}</p>
              {g.itens.map((i) => (
                <a href={i.href}
                  class:list={['flex items-center gap-3 px-5 py-2.5 text-sm transition-colors border-l-2',
                    i.ativo
                      ? 'border-teal bg-white/5 text-white font-medium'
                      : 'border-transparent text-slate-400 hover:text-white hover:bg-white/5']}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={i.icone} />
                  </svg>
                  {i.label}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="border-t border-white/10 px-5 py-3.5">
          <p class="text-xs text-slate-400 truncate">{barberName}</p>
          <button id="__logout" class="mt-1 text-xs text-slate-500 hover:text-red-400 transition-colors">Sair</button>
        </div>
      </aside>

      <!-- Véu do menu no celular -->
      <div id="veu" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden"></div>

      <div class="flex-1 min-w-0 flex flex-col">
        <header class="h-16 bg-white border-b border-slate-200 flex items-center gap-3 px-4 sm:px-6 sticky top-0 z-20">
          <button id="abrir-menu" class="lg:hidden p-1.5 -ml-1.5 text-slate-500 hover:text-slate-800" aria-label="Abrir menu">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 class="text-sm font-semibold text-slate-800 truncate">{title}</h1>
          <a href={enderecoDoSite} target="_blank" rel="noopener"
            class:list={['ml-auto text-xs text-slate-500 hover:text-teal transition-colors whitespace-nowrap',
                         !enderecoDoSite && 'hidden']}>
            Ver meu site ↗
          </a>
        </header>

        {aviso && (
          <div id="aviso-assinatura" role="status"
            class:list={['px-4 sm:px-6 py-2.5 text-sm flex flex-wrap items-center gap-x-4 gap-y-1 border-b',
                         aviso.tom === 'alerta'
                           ? 'bg-amber-50 border-amber-200 text-amber-950'
                           : 'bg-white border-slate-200 text-slate-700']}>
            <span>{aviso.texto}</span>
            {role === 'admin' && norm !== TELA_DE_ASSINATURA && (
              <a href={TELA_DE_ASSINATURA} class="font-semibold underline underline-offset-2 whitespace-nowrap">{aviso.acao}</a>
            )}
          </div>
        )}

        {/* A única área principal da tela, a que o leitor de tela anuncia e para onde ele
            pula: as páginas do painel não abrem outra. Até 13/10/2026, treze abriam —
            duas, uma dentro da outra (tests/area-principal.test.ts). */}
        <main class="flex-1"><slot /></main>
      </div>
    </div>

    <script>
      const lateral = document.getElementById('lateral');
      const veu = document.getElementById('veu');
      function alterna(abrir: boolean) {
        lateral?.classList.toggle('-translate-x-full', !abrir);
        veu?.classList.toggle('hidden', !abrir);
      }
      document.getElementById('abrir-menu')?.addEventListener('click', () => alterna(true));
      veu?.addEventListener('click', () => alterna(false));

      document.getElementById('__logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        location.href = '/admin/login';
      });
    </script>
  </body>
</html>
