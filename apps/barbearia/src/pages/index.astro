---
// SSR: a landing lê `settings` do banco. Com prerender = true os valores
// congelariam no build e mudar algo no painel não mudaria o site.
// Ver ARQUITETURA-PRODUTO-V1 D3 e §3.5.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ComboBoris from '../components/ComboBoris.astro';
import Services from '../components/Services.astro';
import Products from '../components/Products.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Location from '../components/Location.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';

import { tenantDoHost } from '../lib/tenant.js';

// Endereço que não é de barbearia nenhuma: 404 seco, sem renderizar.
//
// ⚠️ Sem esta guarda a página renderizaria com `tenantAtual()` caindo na
// barbearia única — ou seja, um host desconhecido mostraria o site do PRIMEIRO
// cliente. É o defeito que o passo 6 existe para não criar.
if (!tenantDoHost(Astro.request)) {
  return new Response('Barbearia não encontrada', { status: 404 });
}


---

<Layout>
  <Header />
  <main>
    <Hero />
    <Gallery />
    <ComboBoris />
    <Services />
    <Products />
    <Testimonials />
    <Location />
    <FAQ />
  </main>
  <Footer />
  <WhatsAppBar />
</Layout>
