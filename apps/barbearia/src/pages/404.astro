---
// SSR: ver ARQUITETURA-PRODUTO-V1 D3.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/settings';
import { tenantDoHost } from '../lib/tenant.js';

// ⚠️ A página de 404 lê `settings`, e `getSettings()` sem barbearia identificada
// cai na barbearia única. Num endereço que não é de ninguém isso mostraria a
// marca do PRIMEIRO cliente para quem apontar qualquer domínio para o servidor.
if (!tenantDoHost(Astro.request)) {
  return new Response('Barbearia não encontrada', { status: 404 });
}

const s = await getSettings();
---

<Layout title={`Página não encontrada — ${s.businessName}`}>
  <main class="min-h-screen bg-dark flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <p class="text-teal-light text-sm font-medium tracking-[0.25em] uppercase mb-4">404</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium text-neutral-100 mb-4">
        Página não encontrada
      </h1>
      <p class="text-neutral-500 mb-8">
        O endereço que você acessou não existe ou foi movido.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition-colors duration-300 text-sm"
      >
        Voltar ao início
      </a>
    </div>
  </main>
</Layout>
