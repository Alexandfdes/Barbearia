---
export const prerender = false;

/**
 * O painel do operador: as barbearias do produto, a fase de cada uma, e as três
 * ações — estender o teste, tirar do ar, reativar (decisão de 11/10/2026,
 * `docs/PENDENCIAS-ABERTAS.md` §3.9).
 *
 * Quem entra: `lib/operador.ts` (só no endereço do painel, só com a senha). O que
 * aparece e o que as ações fazem: `lib/operadorBarbearias.ts`. Nenhum dado de
 * cliente de barbearia passa por esta tela — só o contato do dono e contagens.
 */
import '../styles/global.css';
import { iconeComLetra } from '../lib/iconeDaAba.js';
import { ACCENT_PADRAO } from '../lib/accent.js';
import { NOME_PRODUTO } from '../lib/produto.js';
import { formatarTelefone } from '../lib/phone.js';
import { waLink, waPhone } from '../lib/whatsapp.js';
import { diaDe } from '../lib/situacao.js';
import { TZ } from '../lib/timezone.js';
import { formatInTimeZone } from 'date-fns-tz';
import { naoEncontrado, operadorAutenticado, portaoDoOperador } from '../lib/operador.js';
import {
  DIAS_MAXIMOS_DE_EXTENSAO, descreverAcao, eventosQuePedemOlho, listarBarbearias, resumoDasFases,
  statusPorExtenso, ultimasAcoes, type Tom,
} from '../lib/operadorBarbearias.js';

// Desligado (sem a senha configurada) ou fora do endereço do painel: o mesmo 404
// de qualquer endereço que não existe.
if (portaoDoOperador(Astro.request) !== 'aberto') return naoEncontrado();

// Nada desta tela vai para cache, aparece dentro de outro site ou entra em busca.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Content-Security-Policy', "frame-ancestors 'none'");
// `same-origin`, e NÃO `no-referrer`: com `no-referrer`, o navegador manda
// `Origin: null` no POST de formulário — e o "Sair" (um `<form method="post">`) era
// recusado pela conferência de origem do `src/middleware.ts`. Achado no E2E de
// 11/10/2026. `same-origin` dá o mesmo resultado para fora: o site da barbearia e
// o WhatsApp abertos daqui não ficam sabendo de onde o clique veio.
Astro.response.headers.set('Referrer-Policy', 'same-origin');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const dentro = await operadorAutenticado(Astro.request);
const lista = dentro ? await listarBarbearias() : [];
const resumo = resumoDasFases(lista);
const eventos = dentro ? await eventosQuePedemOlho() : [];
const acoes = dentro ? await ultimasAcoes() : [];

const FILTROS: { id: string; rotulo: string; n: number }[] = [
  { id: 'todas', rotulo: 'Todas', n: resumo.total },
  { id: 'no-ar', rotulo: 'No ar', n: resumo.noAr },
  { id: 'ativa', rotulo: 'Em dia', n: resumo.ativa },
  { id: 'teste', rotulo: 'Teste', n: resumo.teste },
  { id: 'carencia', rotulo: 'Carência', n: resumo.carencia },
  { id: 'suspensa', rotulo: 'Fora do ar', n: resumo.suspensa },
  { id: 'cancelada', rotulo: 'Encerradas', n: resumo.cancelada },
];

const PILULA: Record<Tom, string> = {
  'em-dia': 'bg-emerald-50 text-emerald-900 ring-emerald-600/25',
  teste: 'bg-sky-50 text-sky-900 ring-sky-600/25',
  atencao: 'bg-amber-50 text-amber-950 ring-amber-600/30',
  fora: 'bg-red-50 text-red-900 ring-red-600/25',
  encerrada: 'bg-slate-100 text-slate-700 ring-slate-500/25',
};

// Quem acabou de agir volta para cá com `?feito=` e a âncora da linha. A frase sai
// do estado de AGORA, lido do banco — não do que o navegador disse que aconteceu.
const feito = Astro.url.searchParams.get('feito');
const alvo = lista.find((b) => b.id === Number(Astro.url.searchParams.get('barbearia')));
let mensagem = '';
if (alvo && feito === 'estender-teste') {
  mensagem = `Teste de ${alvo.nome} estendido — ${alvo.tela.rotulo.toLowerCase()}, ${alvo.tela.detalhe}.`;
} else if (alvo && feito === 'suspender') {
  mensagem = `${alvo.nome} saiu do ar.` + (alvo.temAssinatura
    ? ' A assinatura na Asaas continua cobrando: se ela não deve mais pagar, cancele lá.' : '');
} else if (alvo && feito === 'reativar') {
  mensagem = alvo.tela.tom === 'fora'
    ? `${alvo.nome} voltou ao status de antes, mas continua fora do ar: ${alvo.tela.detalhe}.`
    : `${alvo.nome} voltou ao ar — ${alvo.tela.rotulo.toLowerCase()}, ${alvo.tela.detalhe}.`;
}

const hostDe = (url: string) => url.replace(/^https?:\/\//, '');
const diaDoTextoUtc = (t: string | null) => (t ? diaDe(new Date(`${t.replace(' ', 'T')}Z`)) : null);
const buscaDe = (b: (typeof lista)[number]) =>
  [b.nome, b.slug, b.dono?.nome, b.dono?.email, b.dono?.telefone].filter(Boolean).join(' ').toLowerCase();
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={iconeComLetra(NOME_PRODUTO, ACCENT_PADRAO.color)} />
    <title>Operador — {NOME_PRODUTO}</title>
  </head>

  <body class:list={[dentro
    ? 'bg-slate-50 text-slate-800 min-h-screen font-sans'
    : 'bg-dark text-cream min-h-screen flex items-center justify-center px-4']}>
  {!dentro ? (
      <div class="w-full max-w-sm">
        <div class="text-center mb-8">
          <p class="text-xs text-gray uppercase tracking-widest mb-1">{NOME_PRODUTO}</p>
          <h1 class="font-serif text-2xl font-medium text-white">Operador</h1>
        </div>
        <form id="entrar" class="bg-dark-card border border-white/10 rounded-md p-6 space-y-4">
          <div>
            <label for="senha" class="block text-xs text-gray-light uppercase tracking-widest mb-2">Senha</label>
            <input id="senha" type="password" autocomplete="current-password" required autofocus
              class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2.5 text-sm text-cream focus:outline-none focus:border-teal-light/60 transition-colors" />
          </div>
          <p id="entrar-erro" role="alert" class="hidden text-red-400 text-sm text-center"></p>
          <button id="entrar-btn" type="submit"
            class="w-full bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest px-6 py-3 rounded transition-colors text-sm">
            Entrar
          </button>
        </form>
      </div>
  ) : (
    <>
      <header class="bg-slate-900 text-slate-300">
        <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-3">
          <span class="font-semibold text-white">{NOME_PRODUTO}</span>
          <span class="text-[10px] uppercase tracking-wider bg-teal/25 text-teal-light border border-teal/40 px-1.5 py-0.5 rounded">Operador</span>
          <form method="post" action="/api/operador/sair" class="ml-auto">
            <button id="sair" class="text-xs text-slate-400 hover:text-white transition-colors">Sair</button>
          </form>
        </div>
      </header>

      <main class="max-w-5xl mx-auto px-4 py-6 space-y-8">
        <section aria-labelledby="titulo-barbearias">
          <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
            <div>
              <h1 id="titulo-barbearias" class="text-lg font-semibold text-slate-900">Barbearias</h1>
              <p id="contagem" class="text-sm text-slate-500 mt-0.5">
                {resumo.total} {resumo.total === 1 ? 'cadastrada' : 'cadastradas'} · {resumo.noAr} no ar
              </p>
            </div>
            <label class="w-full sm:w-64">
              <span class="sr-only">Buscar barbearia, dono, e-mail ou telefone</span>
              <input id="busca" type="search" placeholder="Buscar nome, dono, e-mail…"
                class="w-full bg-white border border-slate-300 rounded px-3 py-2 text-sm placeholder-slate-400 focus:outline-none focus:border-teal" />
            </label>
          </div>

          {mensagem && (
            <p id="feito" role="status" class="mb-4 text-sm bg-white border border-slate-200 border-l-4 border-l-teal rounded px-4 py-3">{mensagem}</p>
          )}

          <div id="filtros" class="flex flex-wrap gap-2 mb-4" role="group" aria-label="Filtrar por fase">
            {FILTROS.map((f) => (
              <button type="button" data-filtro={f.id} aria-pressed={f.id === 'todas' ? 'true' : 'false'}
                class="text-xs rounded-full border px-3 py-1.5 transition-colors border-slate-300 bg-white text-slate-700 hover:border-slate-400 aria-pressed:bg-slate-900 aria-pressed:text-white aria-pressed:border-slate-900">
                {f.rotulo} <span class="tabular-nums">{f.n}</span>
              </button>
            ))}
          </div>

          {lista.length === 0 ? (
            <p class="text-sm text-slate-500 bg-white border border-slate-200 rounded px-4 py-6 text-center">Nenhuma barbearia cadastrada ainda.</p>
          ) : (
            <ul id="lista" class="bg-white border border-slate-200 rounded-md divide-y divide-slate-200">
              {lista.map((b) => {
                const noAr = b.situacao.fase === 'ativa' || b.situacao.fase === 'teste' || b.situacao.fase === 'carencia';
                const wa = b.dono?.telefone ? waPhone(b.dono.telefone) : null;
                const ultimo = diaDoTextoUtc(b.ultimoAgendamento);
                return (
                  <li id={`barbearia-${b.id}`} data-fase={b.situacao.fase} data-no-ar={noAr ? '1' : '0'} data-busca={buscaDe(b)}
                    class="px-4 py-4 target:bg-teal/5 scroll-mt-4">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <h2 class="font-semibold text-slate-900">{b.nome}</h2>
                      <span class:list={['text-xs font-medium rounded-full px-2 py-0.5 ring-1 ring-inset', PILULA[b.tela.tom]]}>{b.tela.rotulo}</span>
                      <span class="text-xs text-slate-600">{b.tela.detalhe}</span>
                      {b.criadaEm && <span class="ml-auto text-xs text-slate-500 tabular-nums">desde {diaDe(b.criadaEm, TZ, 'dd/MM/yy')}</span>}
                    </div>

                    <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
                      <dt class="text-slate-500">Site</dt>
                      <dd class="min-w-0">
                        {b.site
                          ? <a href={b.site} target="_blank" rel="noopener noreferrer" class="text-teal hover:underline break-all">{hostDe(b.site)} ↗</a>
                          : <span class="text-slate-600">{b.slug}</span>}
                        {b.temAssinatura && <span class="ml-2 text-xs text-slate-500">· assinatura na Asaas</span>}
                      </dd>
                      <dt class="text-slate-500">Dono</dt>
                      <dd class="min-w-0">
                        {b.dono ? (
                          <span class="flex flex-wrap gap-x-3 gap-y-0.5">
                            <span>{b.dono.nome}</span>
                            {b.dono.telefone && (wa
                              ? <a href={waLink(wa)} target="_blank" rel="noopener noreferrer" class="text-teal hover:underline tabular-nums">{formatarTelefone(b.dono.telefone)}</a>
                              : <span class="tabular-nums">{formatarTelefone(b.dono.telefone)}</span>)}
                            {b.dono.email && <a href={`mailto:${b.dono.email}`} class="text-teal hover:underline break-all">{b.dono.email}</a>}
                          </span>
                        ) : <span class="text-slate-500">sem dono cadastrado</span>}
                      </dd>
                      <dt class="text-slate-500">Uso</dt>
                      <dd class="text-slate-700">
                        <span class="tabular-nums">{b.barbeirosAtivos}</span> {b.barbeirosAtivos === 1 ? 'barbeiro ativo' : 'barbeiros ativos'} ·
                        <span class="tabular-nums">{b.agendamentos30Dias}</span> {b.agendamentos30Dias === 1 ? 'agendamento' : 'agendamentos'} em 30 dias
                        {ultimo && <> · último em <span class="tabular-nums">{ultimo}</span></>}
                      </dd>
                    </dl>

                    <div class="mt-3 flex flex-wrap items-start gap-2">
                      {b.status === 'trial' && (
                        <details class="group w-full sm:w-auto" data-painel-acao>
                          <summary class="cursor-pointer select-none text-xs font-medium border border-slate-300 rounded px-3 py-1.5 hover:border-slate-400 inline-block">Estender o teste</summary>
                          <form data-acao="estender-teste" data-barbearia={b.id} class="mt-2 bg-slate-50 border border-slate-200 rounded p-3 space-y-2 sm:w-80">
                            <label for={`dias-${b.id}`} class="block text-xs text-slate-600">Quantos dias a mais</label>
                            <input id={`dias-${b.id}`} name="dias" type="number" min="1" max={DIAS_MAXIMOS_DE_EXTENSAO} value="7" required
                              class="w-24 bg-white border border-slate-300 rounded px-2 py-1.5 text-sm tabular-nums focus:outline-none focus:border-teal" />
                            <p class="text-xs text-slate-500">Contados do último dia do teste — ou de hoje, se ele já venceu. Se ela estava fora do ar pelo teste, volta na hora.</p>
                            <button type="submit" class="text-xs px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest rounded transition-colors">Estender</button>
                            <p data-erro role="alert" class="hidden text-sm text-red-700"></p>
                          </form>
                        </details>
                      )}

                      {(b.status === 'trial' || b.status === 'active' || b.status === 'past_due') && (
                        <details class="group w-full sm:w-auto" data-painel-acao>
                          <summary class="cursor-pointer select-none text-xs font-medium border border-slate-300 rounded px-3 py-1.5 hover:border-red-400 text-red-800 inline-block">Tirar do ar</summary>
                          <form data-acao="suspender" data-barbearia={b.id} class="mt-2 bg-slate-50 border border-slate-200 rounded p-3 space-y-2 sm:w-96">
                            <p class="text-xs text-slate-600">O site passa a dizer "temporariamente indisponível", com o WhatsApp dela, e o painel do dono abre só a tela de assinatura. Nada é apagado.</p>
                            <p class:list={['text-xs rounded px-2 py-1.5', b.temAssinatura ? 'bg-amber-50 text-amber-950 border border-amber-200' : 'text-slate-600']}>
                              {b.temAssinatura
                                ? 'Ela tem assinatura na Asaas: tirar do ar não cancela a cobrança. Se ela não deve mais pagar, cancele lá.'
                                : 'Não há assinatura registrada na Asaas para ela: nada está sendo cobrado.'}
                            </p>
                            <label for={`motivo-${b.id}`} class="block text-xs text-slate-600">Motivo — fica no registro</label>
                            <input id={`motivo-${b.id}`} name="motivo" maxlength="300" autocomplete="off"
                              class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:border-teal" />
                            <label for={`confirmacao-${b.id}`} class="block text-xs text-slate-600">Para confirmar, digite <code class="font-mono text-slate-900">{b.slug}</code></label>
                            <input id={`confirmacao-${b.id}`} name="confirmacao" required autocomplete="off" spellcheck="false" autocapitalize="off"
                              class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-sm font-mono focus:outline-none focus:border-teal" />
                            <button type="submit" class="text-xs px-4 py-2 bg-red-700 hover:bg-red-800 text-white font-bold uppercase tracking-widest rounded transition-colors">Tirar do ar</button>
                            <p data-erro role="alert" class="hidden text-sm text-red-700"></p>
                          </form>
                        </details>
                      )}

                      {b.status === 'suspended' && (
                        <details class="group w-full sm:w-auto" data-painel-acao>
                          <summary class="cursor-pointer select-none text-xs font-medium border border-slate-300 rounded px-3 py-1.5 hover:border-slate-400 inline-block">Reativar</summary>
                          <form data-acao="reativar" data-barbearia={b.id} class="mt-2 bg-slate-50 border border-slate-200 rounded p-3 space-y-2 sm:w-96">
                            {b.antesDaSuspensao ? (
                              <p class="text-xs text-slate-600">
                                Volta como estava quando saiu do ar — <strong class="text-slate-900">{statusPorExtenso(b.antesDaSuspensao)}</strong> —,
                                com os prazos de antes: o relógio não parou. Se o teste ou a carência venceram nesse meio-tempo, ela continua fora do ar.
                              </p>
                            ) : (
                              <fieldset class="space-y-1.5">
                                <legend class="text-xs text-slate-600 mb-1">Ela saiu do ar fora deste painel, e não há registro de como estava. Volta como:</legend>
                                <label class="flex gap-2 text-sm"><input type="radio" name="comoEra" value="trial" checked /> em teste — com o prazo que tinha, ou 7 dias a partir de hoje se não tinha nenhum</label>
                                <label class="flex gap-2 text-sm"><input type="radio" name="comoEra" value="active" /> em dia — {b.temAssinatura ? 'a assinatura na Asaas segue valendo' : 'sem assinatura na Asaas, isto é de graça e sem prazo'}</label>
                              </fieldset>
                            )}
                            <button type="submit" class="text-xs px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest rounded transition-colors">Reativar</button>
                            <p data-erro role="alert" class="hidden text-sm text-red-700"></p>
                          </form>
                        </details>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          <p id="nada-no-filtro" class="hidden mt-3 text-sm text-slate-500">Nenhuma barbearia neste filtro.</p>
        </section>

        {eventos.length > 0 && (
          <section aria-labelledby="titulo-eventos">
            <h2 id="titulo-eventos" class="text-sm font-semibold text-slate-900">Asaas — eventos que pedem olho</h2>
            <p class="text-xs text-slate-500 mt-0.5 mb-2">O webhook não resolveu sozinho: falhou, não achou barbearia, ou chegou para barbearia fora do ar à mão ou encerrada — um pagamento aqui é dinheiro de quem não está no ar.</p>
            <ul id="eventos" class="bg-white border border-slate-200 rounded-md divide-y divide-slate-200 text-sm">
              {eventos.map((e) => (
                <li class="px-4 py-2.5 flex flex-wrap gap-x-3 gap-y-0.5">
                  <span class="text-slate-500 tabular-nums">{e.recebidoEm ? formatInTimeZone(e.recebidoEm, TZ, 'dd/MM HH:mm') : '—'}</span>
                  <span class="font-mono text-xs self-center">{e.evento}</span>
                  <span class="text-slate-700">{e.slug ?? 'sem barbearia'}</span>
                  <span class="text-slate-600 basis-full">{e.desfecho}</span>
                  <span class="text-xs text-slate-500 font-mono basis-full break-all">{e.idNaAsaas}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="titulo-acoes">
          <h2 id="titulo-acoes" class="text-sm font-semibold text-slate-900 mb-2">Últimas ações</h2>
          {acoes.length === 0 ? (
            <p class="text-sm text-slate-500">Nenhuma ainda.</p>
          ) : (
            <ul id="acoes" class="bg-white border border-slate-200 rounded-md divide-y divide-slate-200 text-sm">
              {acoes.map((a) => (
                <li class="px-4 py-2 flex flex-wrap gap-x-3 gap-y-0.5">
                  <span class="text-slate-500 tabular-nums">{a.quando ? formatInTimeZone(a.quando, TZ, 'dd/MM HH:mm') : '—'}</span>
                  <span class="text-slate-800">{descreverAcao(a)}</span>
                  {a.ip && <span class="ml-auto text-xs text-slate-500 font-mono">{a.ip}</span>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </main>
    </>
  )}

  <script>
    // ── Entrar ──────────────────────────────────────────────────────────────
    const entrar = document.getElementById('entrar') as HTMLFormElement | null;
    entrar?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const erro = document.getElementById('entrar-erro') as HTMLParagraphElement;
      const btn = document.getElementById('entrar-btn') as HTMLButtonElement;
      const senha = (document.getElementById('senha') as HTMLInputElement).value;
      erro.classList.add('hidden');
      btn.disabled = true;
      try {
        const r = await fetch('/api/operador/entrar', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ senha }),
        });
        if (r.ok) { location.replace('/operador'); return; }
        const d = await r.json().catch(() => ({}));
        erro.textContent = d.error ?? 'Não deu para entrar.';
      } catch {
        erro.textContent = 'Erro de conexão. Tente de novo.';
      }
      erro.classList.remove('hidden');
      btn.disabled = false;
    });

    // ── Filtrar e buscar ────────────────────────────────────────────────────
    const itens = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
    const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const busca = document.getElementById('busca') as HTMLInputElement | null;
    const vazio = document.getElementById('nada-no-filtro');
    let filtro = 'todas';

    function aplicar() {
      const termo = (busca?.value ?? '').trim().toLowerCase();
      let visiveis = 0;
      for (const li of itens) {
        const naFase = filtro === 'todas' || (filtro === 'no-ar' ? li.dataset.noAr === '1' : li.dataset.fase === filtro);
        const naBusca = !termo || (li.dataset.busca ?? '').includes(termo);
        li.hidden = !(naFase && naBusca);
        if (!li.hidden) visiveis++;
      }
      vazio?.classList.toggle('hidden', visiveis > 0 || itens.length === 0);
    }
    for (const b of botoes) {
      b.addEventListener('click', () => {
        filtro = b.dataset.filtro ?? 'todas';
        for (const outro of botoes) outro.setAttribute('aria-pressed', String(outro === b));
        aplicar();
      });
    }
    busca?.addEventListener('input', aplicar);

    // ── As ações ────────────────────────────────────────────────────────────
    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-acao]')) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const acao = form.dataset.acao ?? '';
        const barbearia = Number(form.dataset.barbearia);
        const erro = form.querySelector<HTMLParagraphElement>('[data-erro]');
        const botao = form.querySelector<HTMLButtonElement>('button[type=submit]');
        const campo = (nome: string) => form.querySelector<HTMLInputElement>(`[name="${nome}"]`);
        const corpo: Record<string, unknown> = { acao, barbearia };
        if (acao === 'estender-teste') corpo.dias = Number(campo('dias')?.value);
        if (acao === 'suspender') {
          corpo.confirmacao = campo('confirmacao')?.value ?? '';
          const motivo = campo('motivo')?.value.trim();
          if (motivo) corpo.motivo = motivo;
        }
        if (acao === 'reativar') {
          const escolhido = form.querySelector<HTMLInputElement>('[name="comoEra"]:checked');
          if (escolhido) corpo.comoEra = escolhido.value;
        }
        erro?.classList.add('hidden');
        if (botao) botao.disabled = true;
        try {
          const r = await fetch('/api/operador/acao', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo),
          });
          if (r.status === 401) { location.reload(); return; }
          if (r.ok) {
            // O `t` muda a cada vez: sem ele, a segunda ação seguida na mesma linha
            // daria o MESMO endereço, e o navegador só rolaria até a âncora, sem
            // recarregar — a tela ficaria mostrando o estado de antes.
            location.replace(`/operador?feito=${encodeURIComponent(acao)}&barbearia=${barbearia}&t=${Date.now()}#barbearia-${barbearia}`);
            return;
          }
          const d = await r.json().catch(() => ({}));
          if (erro) erro.textContent = d.error ?? 'Não deu certo.';
        } catch {
          if (erro) erro.textContent = 'Erro de conexão. Tente de novo.';
        }
        erro?.classList.remove('hidden');
        if (botao) botao.disabled = false;
      });
    }
  </script>
  </body>
</html>
