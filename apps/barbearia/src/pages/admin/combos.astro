---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../lib/session.js';
import { db } from '../../db/index.js';
import { barbers, combos, services, products } from '../../db/schema.js';
import { and, eq } from 'drizzle-orm';
import { tenantDaSessao } from '../../lib/tenant.js';
import { fusoDe } from '../../lib/timezone.js';
import { formatInTimeZone } from 'date-fns-tz';
import { painelDePromocoes } from '../../lib/promocoesDaBarbearia.js';
import { nomeDoDia, precoDoCombo, rotuloDaFaixa } from '../../lib/combo.js';
import { reais } from '../../lib/dinheiro.js';
import { CLIENTES_NOVOS, textoDoPorcento } from '../../lib/promocoes.js';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login');
const tenant = tenantDaSessao(session);

const barberRow = (await db.select({ id: barbers.id, name: barbers.name, role: barbers.role })
  .from(barbers).where(and(eq(barbers.id, session.barberId), eq(barbers.tenantId, tenant.id))))[0];
if (!barberRow) return Astro.redirect('/admin/login');
if (session.role !== 'admin') return Astro.redirect('/admin');

const list = (await db.select({
  id: combos.id, name: combos.name, serviceId: combos.serviceId, productId: combos.productId,
  discountPct: combos.discountPct, weekdays: combos.weekdays, image: combos.image, active: combos.active,
  serviceName: services.name, productName: products.name,
})
  .from(combos)
  .leftJoin(services, eq(services.id, combos.serviceId))
  .leftJoin(products, eq(products.id, combos.productId))
  .where(eq(combos.tenantId, tenant.id))
  .orderBy(combos.sortOrder, combos.id));

const serviceOpts = (await db.select({ id: services.id, name: services.name }).from(services).where(and(eq(services.active, true), eq(services.tenantId, tenant.id))).orderBy(services.name));
const productOpts = (await db.select({ id: products.id, name: products.name }).from(products).where(and(eq(products.active, true), eq(products.tenantId, tenant.id))).orderBy(products.sortOrder));

const WD_SHORT = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
const brl = (c: number) => 'R$ ' + (c / 100).toFixed(2).replace('.', ',');
function weekdayLabels(mask: number): string {
  const days = WD_SHORT.filter((_, i) => mask & (1 << i));
  return days.length === 7 ? 'Todos os dias' : (days.length ? days.join(', ') : 'Nenhum dia');
}

// A aba Promoções (17/11/2026, `lib/promocoesDaBarbearia.ts`): os horários ociosos com o
// desconto máximo que mantém o lucro, e as promoções ativas. Nada se ativa sozinho.
const fuso = fusoDe(tenant);
const promo = await painelDePromocoes(tenant);
// Um cartão por combo, uma linha por horário vazio (18/11/2026): com um cartão inteiro por
// dia × faixa, o mesmo combo se repetia seis, doze vezes, e o preço cheio junto. Dentro do
// combo, de segunda a domingo e da manhã à noite; as bloqueadas no fim.
const ordemDoDia = (d: number) => (d + 6) % 7;
const gruposDeSugestoes = [...promo.sugestoes.reduce((m, s) => {
  const g = m.get(s.comboId) ?? [];
  g.push(s);
  return m.set(s.comboId, g);
}, new Map<number, typeof promo.sugestoes>()).values()].map((linhas) =>
  linhas.sort((a, b) =>
    Number(a.bloqueio !== null) - Number(b.bloqueio !== null)
    || ordemDoDia(a.diaDaSemana) - ordemDoDia(b.diaDaSemana)
    || a.faixa.inicioMin - b.faixa.inicioMin));
const quando = (d: Date | null) => (d ? formatInTimeZone(d, fuso, 'dd/MM/yyyy') : '');
const media = (decimos: number) => textoDoPorcento(decimos).replace('%', '');
const opcoesDeClientesNovos = Array.from(
  { length: CLIENTES_NOVOS.maximo - CLIENTES_NOVOS.minimo + 1 }, (_, i) => CLIENTES_NOVOS.minimo + i,
);
---

<AdminLayout title="Combos" barberName={barberRow.name} role={session.role}>
  <div class="max-w-3xl mx-auto px-4 py-6 space-y-6 pb-24">

    <div class="border-b border-slate-200">
      <div role="tablist" aria-label="Combos e promoções" class="flex overflow-x-auto">
        <button type="button" role="tab" id="aba-combos" aria-controls="combos" aria-selected="true" tabindex="0" data-aba="combos"
                class="shrink-0 px-3 sm:px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors aria-selected:border-teal aria-selected:text-teal focus-visible:outline-none focus-visible:bg-teal/10">
          Combos
        </button>
        <button type="button" role="tab" id="aba-promocoes" aria-controls="promocoes" aria-selected="false" tabindex="-1" data-aba="promocoes"
                class="shrink-0 px-3 sm:px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors aria-selected:border-teal aria-selected:text-teal focus-visible:outline-none focus-visible:bg-teal/10">
          Promoções{promo.ativas.length > 0 ? ` (${promo.ativas.length} ativa${promo.ativas.length === 1 ? '' : 's'})` : ''}
        </button>
      </div>
    </div>

    <div role="tabpanel" id="combos" aria-labelledby="aba-combos" class="space-y-6">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h1 class="text-lg font-medium text-slate-900">Combos do dia</h1>
        <p class="text-sm text-slate-500 mt-1">Serviço + produto com desconto. Aparece no site nos dias marcados.</p>
      </div>
      <button id="btn-add" class="shrink-0 flex items-center gap-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest text-xs px-4 py-2.5 rounded transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Adicionar
      </button>
    </div>

    {(serviceOpts.length === 0 || productOpts.length === 0) && (
      <div class="bg-amber-50 border border-amber-500/20 rounded-lg p-3 text-xs text-amber-700/90">
        Para criar um combo você precisa de pelo menos um serviço e um produto ativos.
      </div>
    )}

    {list.length === 0 && (
      <div class="bg-white border border-slate-200 rounded-lg py-12 text-center">
        <p class="text-sm text-slate-500">Nenhum combo cadastrado.</p>
      </div>
    )}

    <div class="space-y-2">
      {list.map(c => (
        <div class="flex items-center gap-3 bg-white border border-slate-200 rounded-lg p-3"
             data-id={String(c.id)} data-name={c.name} data-service={String(c.serviceId)} data-product={String(c.productId)}
             data-discount={String(c.discountPct)} data-weekdays={String(c.weekdays)} data-active={String(c.active)} data-image={c.image ?? ''}>
          <div class="w-14 h-14 shrink-0 rounded-md overflow-hidden bg-slate-100 border border-slate-200">
            {c.image
              ? <img src={c.image} alt={c.name} class="w-full h-full object-cover" />
              : <div class="w-full h-full flex items-center justify-center text-slate-300 text-[10px]">sem foto</div>}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium text-slate-900 truncate">{c.name}</p>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-teal/15 text-teal shrink-0">{c.discountPct}% OFF</span>
              {!c.active && <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-200/50 text-slate-500 shrink-0">inativo</span>}
            </div>
            <p class="text-xs text-slate-500 truncate">{c.serviceName} + {c.productName}</p>
            <p class="text-[10px] text-slate-400 mt-0.5">{weekdayLabels(c.weekdays)}</p>
          </div>
          <div class="flex flex-col gap-1.5 shrink-0">
            <button data-action="edit" class="text-[11px] px-2.5 py-1 rounded border border-slate-200 hover:border-teal/30 text-slate-700 hover:text-teal transition-colors">Editar</button>
            <div class="flex gap-1.5">
              <button data-action="toggle" class="flex-1 text-[11px] px-2 py-1 rounded border border-slate-200 hover:border-slate-300 text-slate-500 transition-colors">{c.active ? 'Ocultar' : 'Ativar'}</button>
              <button data-action="delete" class="text-[11px] px-2 py-1 rounded border border-red-500/20 hover:bg-red-500/10 text-red-600/80 transition-colors" aria-label="Excluir">✕</button>
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>

    <div role="tabpanel" id="promocoes" aria-labelledby="aba-promocoes" class="space-y-6" hidden>
      <div>
        <h2 class="text-lg font-medium text-slate-900">Promoções em horários vazios</h2>
        <p class="text-sm text-slate-500 mt-1">
          Os horários dos combos que ficaram vazios nas últimas 8 semanas, com o maior desconto que ainda mantém
          o seu lucro. Você escolhe o desconto e ativa — nada entra no site sozinho.
        </p>
      </div>

      <div class="bg-white border border-slate-200 rounded-lg p-4 space-y-2">
        <label for="clientes-novos" class="block text-xs text-slate-500 uppercase tracking-widest">Clientes novos que uma promoção traz</label>
        <div class="flex items-center gap-2">
          <select id="clientes-novos" class="bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50 tabular-nums">
            {opcoesDeClientesNovos.map((n) => (
              <option value={String(n)} selected={n === promo.clientesNovos}>{n} por semana, no horário</option>
            ))}
          </select>
          <button id="salvar-clientes-novos" type="button" class="px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest text-xs rounded transition-colors disabled:opacity-50">Salvar</button>
        </div>
        <p class="text-[11px] text-slate-500">
          É uma estimativa sua: quanto mais clientes novos, maior o desconto que o painel aceita. Na dúvida, fique no {CLIENTES_NOVOS.padrao}.
        </p>
        <p id="clientes-novos-status" role="status" class="text-xs text-slate-600"></p>
      </div>

      {promo.produtosSemCusto.length > 0 && (
        <div class="bg-amber-50 border border-amber-500/20 rounded-lg p-3 text-xs text-amber-700/90">
          Sem o custo do produto não dá para saber o desconto que mantém o lucro. Informe o custo de
          {' '}{promo.produtosSemCusto.map((p) => `"${p.nome}"`).join(', ')}{' '}
          em <a href="/admin/produtos" class="underline font-medium">Produtos</a>.
        </div>
      )}

      <section aria-labelledby="titulo-ativas" class="space-y-2">
        <h3 id="titulo-ativas" class="text-sm font-medium text-slate-800">Ativas</h3>
        {promo.ativas.length === 0 && (
          <p class="text-sm text-slate-500">Nenhuma promoção ativa.</p>
        )}
        {promo.ativas.map((a) => (
          <div class="flex items-center gap-3 bg-white border border-slate-200 rounded-lg p-3"
               data-promocao={String(a.id)} data-nome={a.comboNome} data-desconto={String(a.descontoPct)}
               data-quando={`${nomeDoDia(a.diaDaSemana)}, das ${rotuloDaFaixa(a.inicioMin, a.fimMin)}`}>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <p class="text-sm font-medium text-slate-900 truncate">{a.comboNome}</p>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-teal/15 text-teal shrink-0">{a.descontoPct}% OFF</span>
              </div>
              <p class="text-xs text-slate-600">{nomeDoDia(a.diaDaSemana)}, das {rotuloDaFaixa(a.inicioMin, a.fimMin)}</p>
              {a.servicoCents + a.produtoCents > 0 && (
                <p class="text-xs text-slate-500 tabular-nums">
                  De {reais(a.servicoCents + a.produtoCents)} por {reais(precoDoCombo(a.servicoCents, a.produtoCents, a.descontoPct))}
                </p>
              )}
              <p class="text-[10px] text-slate-500 mt-0.5">
                Ativada{a.ativadaPorNome ? ` por ${a.ativadaPorNome}` : ''}{a.ativadaEm ? ` em ${quando(a.ativadaEm)}` : ''}
              </p>
            </div>
            <button type="button" data-acao="desativar" class="shrink-0 text-[11px] px-2.5 py-1 rounded border border-red-500/20 hover:bg-red-500/10 text-red-600 transition-colors">Desativar</button>
          </div>
        ))}
      </section>

      <section aria-labelledby="titulo-sugestoes" class="space-y-2">
        <h3 id="titulo-sugestoes" class="text-sm font-medium text-slate-800">Horários vazios</h3>
        {promo.sugestoes.length === 0 && (
          <div class="bg-white border border-slate-200 rounded-lg p-4 text-sm text-slate-500 space-y-1">
            <p>Nenhum horário de combo abaixo de 30% de ocupação agora.</p>
            {promo.diasSemHistorico > 0 && (
              <p class="text-xs">
                Alguns dias ainda não entram na conta: são precisas pelo menos 4 semanas com atendimento concluído naquele dia.
              </p>
            )}
          </div>
        )}
        {gruposDeSugestoes.map((linhas) => {
          const c = linhas[0];
          const semCusto = linhas.every((s) => s.bloqueio === 'sem-custo');
          return (
          <div class="bg-white border border-slate-200 rounded-lg">
            <div class="p-4 border-b border-slate-200">
              <p class="text-sm font-medium text-slate-900">{c.comboNome}</p>
              <p class="text-xs text-slate-500 tabular-nums">
                Preço cheio: {reais(c.precoCheioCents)}
                {c.comboPct > 0 && ` · o combo já dá ${c.comboPct}% (${reais(precoDoCombo(c.servicoCents, c.produtoCents, c.comboPct))})`}
              </p>
              {semCusto && (
                <p class="text-xs text-amber-700 mt-1">
                  Informe o custo de "{c.produtoNome}" em <a href="/admin/produtos" class="underline">Produtos</a> para ver o desconto máximo.
                </p>
              )}
            </div>
            {!semCusto && (
            <ul class="divide-y divide-slate-100">
              {linhas.map((s) => {
                const quando = `${nomeDoDia(s.diaDaSemana)} ${s.faixa.rotulo}, das ${rotuloDaFaixa(s.faixa.inicioMin, s.faixa.fimMin)}`;
                const idCampo = `desconto-${s.comboId}-${s.diaDaSemana}-${s.faixa.chave}`;
                return (
                <li class="px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-1"
                    data-sugestao
                    data-combo={String(s.comboId)} data-dia={String(s.diaDaSemana)} data-faixa={s.faixa.chave}
                    data-limite={String(s.limitePct ?? 0)} data-combo-pct={String(s.comboPct)}
                    data-servico={String(s.servicoCents)} data-produto={String(s.produtoCents)}
                    data-nome={s.comboNome} data-quando={quando}>
                  <div class="flex-1 min-w-[12rem]">
                    <p class="text-sm text-slate-800 first-letter:uppercase">{nomeDoDia(s.diaDaSemana)} {s.faixa.rotulo} <span class="text-xs text-slate-500">· {rotuloDaFaixa(s.faixa.inicioMin, s.faixa.fimMin)}</span></p>
                    <p class="text-xs text-slate-500"
                       title={`Em média ${media(s.mediaDecimos)} atendimento(s) por semana nesse horário, em ${s.semanas} semanas com atendimento`}>
                      Ocupação de {s.ocupacaoPct}%
                      {s.bloqueio === null && s.limiteDecimos !== null && <> · máximo que mantém o lucro: <strong class="tabular-nums text-slate-700">{textoDoPorcento(s.limiteDecimos)}</strong></>}
                      {s.bloqueio === 'sem-espaco' && s.limiteDecimos !== null && ` · o máximo que mantém o lucro (${textoDoPorcento(s.limiteDecimos)}) não passa do que o combo já dá`}
                    </p>
                  </div>
                  {s.bloqueio === null && s.limitePct !== null && (
                    <div class="flex items-center gap-2">
                      <label for={idCampo} class="sr-only">Desconto em %, {quando}</label>
                      <input id={idCampo} data-campo-desconto type="number"
                             min={String(s.comboPct + 1)} max={String(s.limitePct)} step="1" value={String(s.limitePct)}
                             class="w-20 bg-slate-100 border border-slate-200 rounded px-2 py-1.5 text-sm text-slate-800 focus:outline-none focus:border-teal/50 tabular-nums" />
                      <span class="text-sm text-slate-500" aria-hidden="true">%</span>
                      <button type="button" data-acao="ativar" class="px-3 py-1.5 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest text-[11px] rounded transition-colors">Ativar…</button>
                    </div>
                  )}
                  {s.bloqueio === null && (
                    <>
                      <p data-previa class="w-full text-xs text-slate-600 tabular-nums" aria-live="polite"></p>
                      <p data-erro class="hidden w-full text-xs text-red-600" role="alert"></p>
                    </>
                  )}
                </li>
                );
              })}
            </ul>
            )}
          </div>
          );
        })}
      </section>
    </div>

    <!-- Confirmação de desativar promoção -->
    <div id="confirmar-desativar" class="hidden fixed inset-0 z-50 flex items-center justify-center px-4"
         role="dialog" aria-modal="true" aria-labelledby="confirmar-desativar-titulo">
      <div class="absolute inset-0 bg-black/70" data-fechar-desativar></div>
      <div class="relative bg-white border border-slate-200 rounded-lg shadow-2xl max-w-sm w-full p-6">
        <p id="confirmar-desativar-titulo" class="text-base font-medium text-slate-900 mb-2">Desativar a promoção?</p>
        <p id="confirmar-desativar-texto" class="text-sm text-slate-600 mb-2 leading-relaxed"></p>
        <p class="text-xs text-slate-500 mb-5">O horário volta ao preço do combo para os agendamentos novos. Os já marcados continuam com o preço que tinham.</p>
        <p id="confirmar-desativar-erro" class="hidden text-xs text-red-600 mb-3" role="alert"></p>
        <div class="flex gap-2 justify-end">
          <button type="button" data-fechar-desativar class="px-4 py-2 rounded text-sm font-medium text-slate-700 border border-slate-200 hover:bg-slate-100 transition-colors">Voltar</button>
          <button type="button" id="confirmar-desativar-ok" class="px-4 py-2 rounded text-sm font-bold text-white bg-red-600 hover:bg-red-700 transition-colors disabled:opacity-50">Desativar</button>
        </div>
      </div>
    </div>

    <!-- Confirmação de ativar promoção -->
    <div id="confirmar-promocao" class="hidden fixed inset-0 z-50 flex items-center justify-center px-4">
      <div class="absolute inset-0 bg-black/70" data-fechar-confirmacao></div>
      <div class="relative bg-white border border-slate-200 rounded-lg shadow-2xl max-w-sm w-full p-6">
        <p class="text-base font-medium text-slate-900 mb-2">Ativar a promoção?</p>
        <p id="confirmar-promocao-texto" class="text-sm text-slate-600 mb-2 leading-relaxed"></p>
        <p class="text-xs text-slate-500 mb-5">Vale para os agendamentos novos pelo site. Os já marcados continuam com o preço que tinham.</p>
        <p id="confirmar-promocao-erro" class="hidden text-xs text-red-600 mb-3" role="alert"></p>
        <div class="flex gap-2 justify-end">
          <button type="button" data-fechar-confirmacao class="px-4 py-2 rounded text-sm font-medium text-slate-700 border border-slate-200 hover:bg-slate-100 transition-colors">Voltar</button>
          <button type="button" id="confirmar-promocao-ok" class="px-4 py-2 rounded text-sm font-bold text-white bg-teal hover:bg-teal-hover transition-colors disabled:opacity-50">Ativar promoção</button>
        </div>
      </div>
    </div>

    <!-- Modal add/editar -->
    <div id="combo-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center px-4">
      <div class="absolute inset-0 bg-black/70" data-close></div>
      <div class="relative bg-white border border-slate-200 rounded-lg p-5 w-full max-w-sm space-y-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-slate-800" id="modal-title">Novo combo</p>
          <button type="button" data-close class="text-slate-500 hover:text-slate-700 text-xs">✕ fechar</button>
        </div>
        <input type="hidden" id="f-id" />
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Nome</label>
          <input id="f-name" type="text" maxlength="100" placeholder="Ex.: Combo de Sexta" class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50" />
        </div>
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Serviço</label>
          <select id="f-service" class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50">
            {serviceOpts.map(s => <option value={String(s.id)}>{s.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Produto</label>
          <select id="f-product" class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50">
            {productOpts.map(p => <option value={String(p.id)}>{p.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Desconto (%)</label>
          <input id="f-discount" type="number" min="0" max="90" value="10" class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50 tabular-nums" />
        </div>
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Dias da semana</label>
          <div class="grid grid-cols-7 gap-1" id="f-weekdays">
            {WD_SHORT.map((d, i) => (
              <label class="flex flex-col items-center gap-1 text-[10px] text-slate-500 cursor-pointer">
                <span>{d}</span>
                <input type="checkbox" data-weekday={String(i)} class="accent-teal" />
              </label>
            ))}
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Foto (opcional)</label>
          <div class="flex items-center gap-3">
            <img id="f-preview" class="hidden w-14 h-14 rounded-md object-cover border border-slate-200" />
            <input id="f-image" type="file" accept="image/jpeg,image/png,image/webp" class="flex-1 text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:bg-teal/20 file:text-teal file:text-xs file:cursor-pointer" />
          </div>
          <p class="text-[10px] text-slate-400 mt-1">Se vazio, usa a foto do produto.</p>
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <input id="f-active" type="checkbox" checked class="accent-teal" /> Ativo
        </label>
        <div id="modal-error" class="hidden text-red-600 text-xs text-center"></div>
        <button id="f-save" type="button" class="w-full bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest text-xs py-3 rounded transition-colors disabled:opacity-50">Salvar</button>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  const modal   = document.getElementById('combo-modal') as HTMLElement;
  const title   = document.getElementById('modal-title') as HTMLElement;
  const fId     = document.getElementById('f-id') as HTMLInputElement;
  const fName   = document.getElementById('f-name') as HTMLInputElement;
  const fService = document.getElementById('f-service') as HTMLSelectElement;
  const fProduct = document.getElementById('f-product') as HTMLSelectElement;
  const fDiscount = document.getElementById('f-discount') as HTMLInputElement;
  const fImage  = document.getElementById('f-image') as HTMLInputElement;
  const fActive = document.getElementById('f-active') as HTMLInputElement;
  const fPrev   = document.getElementById('f-preview') as HTMLImageElement;
  const errEl   = document.getElementById('modal-error') as HTMLElement;
  const saveBtn = document.getElementById('f-save') as HTMLButtonElement;
  const wdBoxes = Array.from(document.querySelectorAll('#f-weekdays input[type=checkbox]')) as HTMLInputElement[];

  function setWeekdays(mask: number) {
    wdBoxes.forEach(b => { b.checked = (mask & (1 << Number(b.dataset.weekday))) !== 0; });
  }
  function getWeekdays(): number {
    return wdBoxes.reduce((m, b) => m | (b.checked ? (1 << Number(b.dataset.weekday)) : 0), 0);
  }

  function openModal(edit?: any) {
    errEl.classList.add('hidden'); errEl.textContent = '';
    fImage.value = '';
    if (edit) {
      title.textContent = 'Editar combo';
      fId.value = edit.id; fName.value = edit.name;
      fService.value = edit.service; fProduct.value = edit.product;
      fDiscount.value = edit.discount; fActive.checked = edit.active;
      setWeekdays(Number(edit.weekdays));
      if (edit.image) { fPrev.src = edit.image; fPrev.classList.remove('hidden'); } else fPrev.classList.add('hidden');
    } else {
      title.textContent = 'Novo combo';
      fId.value = ''; fName.value = ''; fDiscount.value = '10'; fActive.checked = true;
      fService.selectedIndex = 0; fProduct.selectedIndex = 0;
      setWeekdays(127);
      fPrev.classList.add('hidden');
    }
    modal.classList.remove('hidden');
  }
  function closeModal() { modal.classList.add('hidden'); }

  document.getElementById('btn-add')?.addEventListener('click', () => openModal());
  modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeModal));
  fImage.addEventListener('change', () => {
    const f = fImage.files?.[0];
    if (f) { fPrev.src = URL.createObjectURL(f); fPrev.classList.remove('hidden'); }
  });

  document.querySelectorAll('[data-id]').forEach(card => {
    const el = card as HTMLElement;
    const id = el.dataset.id!;
    el.querySelector('[data-action="edit"]')?.addEventListener('click', () => openModal({
      id, name: el.dataset.name, service: el.dataset.service, product: el.dataset.product,
      discount: el.dataset.discount, weekdays: el.dataset.weekdays, active: el.dataset.active === 'true', image: el.dataset.image,
    }));
    el.querySelector('[data-action="toggle"]')?.addEventListener('click', async () => {
      const fd = new FormData(); fd.set('active', el.dataset.active === 'true' ? 'false' : 'true');
      const res = await fetch(`/api/admin/combos/${id}`, { method: 'PATCH', body: fd });
      if (res.ok) location.reload();
    });
    el.querySelector('[data-action="delete"]')?.addEventListener('click', async () => {
      if (!confirm(`Excluir o combo "${el.dataset.name}"?`)) return;
      const res = await fetch(`/api/admin/combos/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload();
    });
  });

  saveBtn.addEventListener('click', async () => {
    errEl.classList.add('hidden');
    const name = fName.value.trim();
    if (name.length < 2) { errEl.textContent = 'Informe o nome'; errEl.classList.remove('hidden'); return; }
    if (!fService.value || !fProduct.value) { errEl.textContent = 'Escolha serviço e produto'; errEl.classList.remove('hidden'); return; }

    const fd = new FormData();
    fd.set('name', name);
    fd.set('serviceId', fService.value);
    fd.set('productId', fProduct.value);
    fd.set('discountPct', fDiscount.value || '0');
    fd.set('weekdays', String(getWeekdays()));
    fd.set('active', fActive.checked ? 'true' : 'false');
    if (fImage.files?.[0]) fd.set('image', fImage.files[0]);

    saveBtn.disabled = true; saveBtn.textContent = 'Salvando...';
    const id = fId.value;
    const url = id ? `/api/admin/combos/${id}` : '/api/admin/combos';
    const method = id ? 'PATCH' : 'POST';
    try {
      const res = await fetch(url, { method, body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.ok) { location.reload(); return; }
      errEl.textContent = data.error ?? 'Erro ao salvar'; errEl.classList.remove('hidden');
    } catch {
      errEl.textContent = 'Erro de conexão'; errEl.classList.remove('hidden');
    }
    saveBtn.disabled = false; saveBtn.textContent = 'Salvar';
  });
</script>

<script>
  // As abas (o mesmo desenho de Configurações) e a aba Promoções — `lib/promocoesDaBarbearia.ts`.
  import { precoDoCombo } from '../../lib/combo';
  import { reais } from '../../lib/dinheiro';

  const abas = Array.from(document.querySelectorAll<HTMLElement>('[role="tab"][data-aba]'));
  function abrirAba(id: string, foco = false) {
    for (const aba of abas) {
      const ativa = aba.dataset.aba === id;
      aba.setAttribute('aria-selected', ativa ? 'true' : 'false');
      aba.tabIndex = ativa ? 0 : -1;
      const painel = document.getElementById(aba.getAttribute('aria-controls') ?? '');
      if (painel) painel.hidden = !ativa;
      if (ativa && foco) aba.focus();
    }
  }
  function irParaOEndereco() {
    const id = location.hash.slice(1);
    if (abas.some((a) => a.dataset.aba === id)) abrirAba(id);
  }
  abas.forEach((aba, i) => {
    aba.addEventListener('click', () => {
      abrirAba(aba.dataset.aba!);
      history.replaceState(null, '', `#${aba.dataset.aba}`);
    });
    aba.addEventListener('keydown', (e) => {
      const alvo = e.key === 'ArrowRight' ? abas[(i + 1) % abas.length]
        : e.key === 'ArrowLeft' ? abas[(i - 1 + abas.length) % abas.length]
        : e.key === 'Home' ? abas[0]
        : e.key === 'End' ? abas[abas.length - 1]
        : null;
      if (!alvo) return;
      e.preventDefault();
      abrirAba(alvo.dataset.aba!, true);
      history.replaceState(null, '', `#${alvo.dataset.aba}`);
    });
  });
  irParaOEndereco();
  window.addEventListener('hashchange', irParaOEndereco);

  // ── O g: clientes novos que uma promoção traz ───────────────────────────────
  const seletorG = document.getElementById('clientes-novos') as HTMLSelectElement | null;
  const salvarG = document.getElementById('salvar-clientes-novos') as HTMLButtonElement | null;
  const statusG = document.getElementById('clientes-novos-status');
  salvarG?.addEventListener('click', async () => {
    if (!seletorG || !statusG) return;
    salvarG.disabled = true;
    statusG.textContent = 'Salvando…';
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ promoClientesNovos: Number(seletorG.value) }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        // Os limites mudam com o g: a lista se refaz.
        location.hash = 'promocoes';
        location.reload();
        return;
      }
      statusG.textContent = data.error ?? 'Não deu para salvar. Tente de novo.';
    } catch {
      statusG.textContent = 'Erro de conexão. Tente de novo.';
    }
    salvarG.disabled = false;
  });

  // ── Desativar ────────────────────────────────────────────────────────────────
  // A janela da tela, não o confirm() do navegador (18/11/2026, pedido do dono).
  const janelaDesativar = document.getElementById('confirmar-desativar') as HTMLElement;
  const textoDesativar = document.getElementById('confirmar-desativar-texto') as HTMLElement;
  const erroDesativar = document.getElementById('confirmar-desativar-erro') as HTMLElement;
  const okDesativar = document.getElementById('confirmar-desativar-ok') as HTMLButtonElement;
  let aDesativar: string | null = null;
  let voltarFocoPara: HTMLElement | null = null;

  function fecharDesativar() {
    janelaDesativar.classList.add('hidden');
    aDesativar = null;
    voltarFocoPara?.focus();
  }
  janelaDesativar.querySelectorAll('[data-fechar-desativar]').forEach((b) => b.addEventListener('click', fecharDesativar));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !janelaDesativar.classList.contains('hidden')) fecharDesativar();
  });

  document.querySelectorAll<HTMLElement>('[data-promocao]').forEach((el) => {
    const botao = el.querySelector<HTMLElement>('[data-acao="desativar"]');
    botao?.addEventListener('click', () => {
      aDesativar = el.dataset.promocao ?? null;
      voltarFocoPara = botao;
      textoDesativar.textContent = `${el.dataset.nome}, ${el.dataset.quando ?? ''}, ${el.dataset.desconto ?? ''}% OFF.`;
      erroDesativar.classList.add('hidden');
      okDesativar.disabled = false;
      janelaDesativar.classList.remove('hidden');
      okDesativar.focus();
    });
  });

  okDesativar.addEventListener('click', async () => {
    if (!aDesativar) return;
    okDesativar.disabled = true;
    try {
      const res = await fetch(`/api/admin/promocoes/${aDesativar}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ativa: false }),
      });
      if (res.ok) { location.hash = 'promocoes'; location.reload(); return; }
      const data = await res.json().catch(() => ({}));
      erroDesativar.textContent = data.error ?? 'Não deu para desativar. Atualize a tela.';
    } catch {
      erroDesativar.textContent = 'Erro de conexão. Tente de novo.';
    }
    erroDesativar.classList.remove('hidden');
    okDesativar.disabled = false;
  });

  // ── Ativar: o desconto, a prévia do preço e a confirmação ───────────────────
  const confirmacao = document.getElementById('confirmar-promocao') as HTMLElement;
  const textoDaConfirmacao = document.getElementById('confirmar-promocao-texto') as HTMLElement;
  const erroDaConfirmacao = document.getElementById('confirmar-promocao-erro') as HTMLElement;
  const okDaConfirmacao = document.getElementById('confirmar-promocao-ok') as HTMLButtonElement;
  let pedido: { comboId: number; diaDaSemana: number; faixa: string; descontoPct: number } | null = null;

  function fecharConfirmacao() {
    confirmacao.classList.add('hidden');
    pedido = null;
  }
  confirmacao.querySelectorAll('[data-fechar-confirmacao]').forEach((b) => b.addEventListener('click', fecharConfirmacao));

  document.querySelectorAll<HTMLElement>('[data-sugestao]').forEach((el) => {
    const campo = el.querySelector<HTMLInputElement>('[data-campo-desconto]');
    const previa = el.querySelector<HTMLElement>('[data-previa]');
    const erro = el.querySelector<HTMLElement>('[data-erro]');
    if (!campo || !previa || !erro) return;
    const limite = Number(el.dataset.limite);
    const comboPct = Number(el.dataset.comboPct);
    const servico = Number(el.dataset.servico);
    const produto = Number(el.dataset.produto);
    const cheio = servico + produto;

    // O que o dono digitou, se cabe: inteiro, acima do desconto do combo, até o limite.
    const lido = (): { pct: number } | { erro: string } => {
      const pct = Number(campo.value);
      if (!Number.isInteger(pct)) return { erro: 'Use um número inteiro.' };
      if (pct > limite) return { erro: `O limite deste horário é ${limite}%. Mais que isso, a promoção dá prejuízo.` };
      if (pct <= comboPct) return { erro: `O combo já dá ${comboPct}% nesse dia: a promoção precisa passar disso.` };
      return { pct };
    };
    const mostrar = () => {
      const r = lido();
      if ('erro' in r) {
        previa.textContent = '';
        erro.textContent = r.erro;
        erro.classList.remove('hidden');
        return;
      }
      erro.classList.add('hidden');
      previa.textContent = `O cliente paga ${reais(precoDoCombo(servico, produto, r.pct))} — de ${reais(cheio)}, o preço cheio.`;
    };
    // A prévia aparece quando o dono mexe no campo — aberta em toda linha, a lista virava texto.
    campo.addEventListener('input', mostrar);

    el.querySelector('[data-acao="ativar"]')?.addEventListener('click', () => {
      const r = lido();
      if ('erro' in r) { mostrar(); campo.focus(); return; }
      pedido = {
        comboId: Number(el.dataset.combo),
        diaDaSemana: Number(el.dataset.dia),
        faixa: el.dataset.faixa ?? '',
        descontoPct: r.pct,
      };
      textoDaConfirmacao.textContent =
        `${el.dataset.nome}, ${el.dataset.quando}: ${r.pct}% OFF. O cliente paga ${reais(precoDoCombo(servico, produto, r.pct))}, de ${reais(cheio)}.`;
      erroDaConfirmacao.classList.add('hidden');
      okDaConfirmacao.disabled = false;
      confirmacao.classList.remove('hidden');
      okDaConfirmacao.focus();
    });
  });

  okDaConfirmacao.addEventListener('click', async () => {
    if (!pedido) return;
    okDaConfirmacao.disabled = true;
    try {
      const res = await fetch('/api/admin/promocoes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...pedido, confirmacao: true }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) { location.hash = 'promocoes'; location.reload(); return; }
      erroDaConfirmacao.textContent = data.error ?? 'Não deu para ativar. Atualize a tela.';
    } catch {
      erroDaConfirmacao.textContent = 'Erro de conexão. Tente de novo.';
    }
    erroDaConfirmacao.classList.remove('hidden');
    okDaConfirmacao.disabled = false;
  });
</script>
