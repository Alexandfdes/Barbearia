---
export const prerender = false;

import { tenantDaSessao } from '../../lib/tenant.js';
import AdminLayout from '../../layouts/AdminLayout.astro';
import ExportarDados from '../../components/admin/ExportarDados.astro';
import SecaoDeCampos, { type Secao } from '../../components/admin/SecaoDeCampos.astro';
import { getSession } from '../../lib/session.js';
import { db, first } from '../../db/index.js';
import { barbers, settings } from '../../db/schema.js';
import { and, eq } from 'drizzle-orm';
import { parseBusinessHours } from '../../lib/settings.js';
import { embedDoMapa } from '../../lib/mapa.js';
import { FUSOS_DO_BRASIL, deslocamento, fusoDe } from '../../lib/timezone.js';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login');
// A marca da loja é do dono. Barbeiro comum vai para a tela dele.
if (session.role !== 'admin') return Astro.redirect('/admin/servicos');

const tenant = tenantDaSessao(session);
const barberRow = (await db.select({ id: barbers.id, name: barbers.name })
  .from(barbers).where(and(eq(barbers.id, session.barberId), eq(barbers.tenantId, tenant.id))))[0];
if (!barberRow) return Astro.redirect('/admin/login');

const cfg = (await first(db.select().from(settings).where(eq(settings.tenantId, tenant.id))));
const horarios = parseBusinessHours(cfg?.businessHours);
// O mapa que o site mostra agora — a prévia abaixo do endereço (`lib/mapa.ts`).
const mapaAgora = cfg ? embedDoMapa(cfg) : null;
// O fuso dos horários (`tenants.timezone`, 12/10/2026): nasce do estado do
// cadastro e se troca aqui. A distância do UTC é a de hoje — é ela que muda se o
// horário de verão voltar num estado e não no outro.
const fusoAtual = fusoDe(tenant);
const opcoesDeFuso = FUSOS_DO_BRASIL.map((f) => ({ id: f.id, texto: `${f.rotulo} · ${deslocamento(f.id)}` }));

// ── As abas (15/10/2026) ───────────────────────────────────────────────────────
// A tela era uma rolagem só, com nove blocos. Agora são quatro abas — as três primeiras
// são o formulário, e o Salvar grava as três de uma vez: os campos das abas escondidas
// continuam nele. O `id` de cada aba e de cada bloco é endereço: `#contato` abre a aba,
// `#endereco` abre a aba onde o bloco está e rola até ele.
// `curto`: o nome no celular, para as quatro caberem lado a lado numa tela de 390 px.
const ABAS: { id: string; titulo: string; curto?: string }[] = [
  { id: 'aparencia', titulo: 'Aparência' },
  { id: 'contato', titulo: 'Contato e endereço', curto: 'Contato' },
  { id: 'google', titulo: 'Google' },
  { id: 'dados', titulo: 'Seus dados' },
];
type AbaDoFormulario = 'aparencia' | 'contato' | 'google';

const secoes: (Secao & { aba: AbaDoFormulario })[] = [
  {
    titulo: 'Nomes e textos do site',
    ancora: 'textos',
    aba: 'aparencia',
    campos: [
      { id: 'businessName', label: 'Nome da barbearia', hint: 'Aparece no rodapé, no título da aba e nos dados que o Google lê.' },
      { id: 'shortName', label: 'Nome curto', hint: 'O que aparece no topo do site, ao lado do logo. Ex: "Cortes do Zé".' },
      // ⚠️ Até 27/09/2026 os dois avisos abaixo diziam que o topo do site não lia
      // estes campos. Lia: a frase É o título grande do topo (`components/Hero.astro`),
      // e o medidor do painel cobra ela com o nome "frase do topo". O dono
      // acreditava no aviso e deixava o topo genérico.
      { id: 'tagline', label: 'Frase do topo', hint: 'O título grande do topo do site — a primeira coisa que o cliente lê. Em branco, o topo mostra o nome da barbearia.' },
      { id: 'heroSubtitle', label: 'Texto abaixo da frase', tipo: 'textarea', hint: 'Aparece logo abaixo da frase do topo. Opcional.' },
      { id: 'aboutText', label: 'Sobre a barbearia', tipo: 'textarea', hint: 'O parágrafo do rodapé.' },
      // Morava em "Busca e compartilhamento" até 15/10/2026, mas é texto do site, não do Google.
      { id: 'productsSectionTitle', label: 'Título da seção de produtos', hint: 'O título grande acima dos produtos, no site. Ex: "Produtos".' },
    ],
  },
  {
    titulo: 'Contato',
    ancora: 'contatos',
    aba: 'contato',
    campos: [
      { id: 'whatsappNumber', label: 'WhatsApp (só números)', hint: 'DDI + DDD + número, sem espaços nem sinais. Ex: 5584999999999. É para onde vão todos os botões de WhatsApp.', placeholder: '5584999999999' },
      { id: 'whatsappDisplay', label: 'WhatsApp como aparece escrito', hint: 'Só o texto exibido no rodapé. Ex: +55 84 99999-9999.', placeholder: '+55 84 99999-9999' },
      { id: 'instagramUrl', label: 'Link do Instagram', placeholder: 'https://www.instagram.com/sua_barbearia/' },
      { id: 'instagramHandle', label: 'Arroba do Instagram', placeholder: '@sua_barbearia' },
    ],
  },
  {
    titulo: 'Endereço',
    // O "Não está — corrigir" do Início leva para cá (`admin/index.astro`).
    ancora: 'endereco',
    previaDoMapa: true,
    aba: 'contato',
    campos: [
      { id: 'addressStreet', label: 'Rua e número', placeholder: 'R. Exemplo, 123' },
      { id: 'addressCity', label: 'Cidade/UF', hint: 'Escreva no formato Cidade/UF — o site divide os dois para o Google.', placeholder: 'Mossoró/RN' },
      { id: 'fuso', label: 'Fuso horário', tipo: 'fuso', hint: 'Todo horário do site, da agenda e dos e-mails segue este fuso. Ele veio do estado no cadastro; troque se a sua cidade está numa ponta de estado com outro fuso.' },
      // Desde 10/10/2026 os dois são opcionais: em branco, o mapa e a rota saem do endereço
      // (`lib/mapa.ts`). Antes, sem o link, o "Traçar rota" abria o próprio site.
      { id: 'mapsUrl', label: 'Link "traçar rota"', hint: 'Opcional. Em branco, o site monta a rota pelo endereço. Preenchido, é ele que todo botão de mapa do site abre — pode ser do Google Maps ou do Waze.' },
      { id: 'mapsEmbedQuery', label: 'Busca do mapa embutido', hint: 'O texto que o mapa da página usa para achar a barbearia — e a rota também, se o link acima estiver em branco. Em branco, vale a rua e a cidade. Se o mapa mostrar outro lugar, escreva o nome da barbearia + rua + bairro + cidade.' },
    ],
  },
  {
    titulo: 'Avaliações do Google',
    ancora: 'avaliacoes',
    aba: 'google',
    campos: [
      { id: 'googleReviewsUrl', label: 'Link das avaliações' },
      { id: 'googleRating', label: 'Nota', hint: 'A do Google, com uma casa decimal. Ex: 4.8. Com a nota e a quantidade, o site mostra as duas; em branco, nada aparece.', placeholder: '5.0' },
      { id: 'googleReviewCount', label: 'Quantidade de avaliações', tipo: 'number' },
    ],
  },
  {
    titulo: 'Busca e compartilhamento',
    nota: 'É o que aparece no Google e na prévia quando alguém manda o link no WhatsApp.',
    ancora: 'busca',
    aba: 'google',
    campos: [
      { id: 'seoTitle', label: 'Título da página', hint: 'Até uns 60 caracteres aparecem no Google.' },
      { id: 'seoDescription', label: 'Descrição', tipo: 'textarea', hint: 'Até uns 155 caracteres aparecem no Google.' },
    ],
  },
];
const secoesDa = (aba: AbaDoFormulario) => secoes.filter((s) => s.aba === aba);

const valor = (id: string): string => {
  const v = (cfg as Record<string, unknown> | undefined)?.[id];
  return v === null || v === undefined ? '' : String(v);
};
// O que todo bloco de campos recebe (`components/admin/SecaoDeCampos.astro`).
const comuns = { valor, opcoesDeFuso, fusoAtual, mapaAgora };
---

<AdminLayout title="Configurações" barberName={barberRow.name} role="admin">
  <div class="max-w-3xl mx-auto px-4 py-6 pb-24">

    <div class="mb-4">
      <h1 class="text-lg font-medium text-slate-900">Configurações da barbearia</h1>
      <p class="text-sm text-slate-500 mt-1">
        Mude o que quiser em qualquer aba e clique em <strong class="font-medium text-slate-700">Salvar</strong>, lá
        embaixo: ele grava todas de uma vez. As imagens são a exceção — sobem assim que você escolhe o arquivo.
      </p>
    </div>

    {!cfg && (
      <div class="mb-6 border border-red-500/30 bg-red-500/10 rounded p-4 text-sm text-red-700">
        A configuração não foi encontrada no banco. Rode <code class="font-mono">npm run db:migrate</code> e recarregue.
      </div>
    )}

    {/* As abas, presas logo abaixo do topo do painel (64 px) enquanto a página rola. O
        ponto ao lado do nome aparece quando a aba tem mudança que ainda não foi salva. */}
    <div class="sticky top-16 z-10 -mx-4 px-4 mb-6 bg-slate-50/95 backdrop-blur border-b border-slate-200">
      <div role="tablist" aria-label="Partes das configurações" class="flex overflow-x-auto">
        {ABAS.map((aba, i) => (
          <button
            type="button"
            role="tab"
            id={`aba-${aba.id}`}
            aria-controls={aba.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-aba={aba.id}
            class="shrink-0 px-3 sm:px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors aria-selected:border-teal aria-selected:text-teal focus-visible:outline-none focus-visible:bg-teal/10"
          >
            {aba.curto
              ? <><span class="sm:hidden">{aba.curto}</span><span class="hidden sm:inline">{aba.titulo}</span></>
              : aba.titulo}<span data-aba-mudou hidden class="ml-1.5 inline-block h-1.5 w-1.5 rounded-full bg-amber-500 align-middle"><span class="sr-only"> (alterações não salvas)</span></span>
          </button>
        ))}
      </div>
    </div>

    <form id="form-cfg" class="space-y-8">

      <div role="tabpanel" id="aparencia" aria-labelledby="aba-aparencia" class="space-y-8">
        {secoesDa('aparencia').map((secao) => <SecaoDeCampos secao={secao} {...comuns} />)}

        <!-- Imagens da marca -->
        <section id="imagens" class="border border-slate-200 rounded-lg p-4 sm:p-5 bg-slate-50 scroll-mt-32">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-slate-700 mb-1">Imagens</h2>
          <p class="text-xs text-slate-500 mb-5">
            Trocar aqui muda o site na hora. Cada envio gera um arquivo novo, então o
            navegador de quem já visitou também vê a imagem nova.
          </p>

          <div class="grid sm:grid-cols-2 gap-4">
            {[
              { tipo: 'logo',    titulo: 'Logo',           dica: 'Aparece no topo e no rodapé. PNG com fundo transparente fica melhor.', valor: cfg?.logoPath },
              { tipo: 'hero',    titulo: 'Foto de capa',   dica: 'A foto grande do topo. Horizontal, no mínimo 1600px de largura.',      valor: cfg?.heroPath },
              { tipo: 'og',      titulo: 'Prévia de link', dica: 'A imagem que aparece quando alguém manda o link no WhatsApp. 1200×630.', valor: cfg?.ogPath },
              { tipo: 'favicon', titulo: 'Ícone da aba',   dica: 'O quadradinho na aba do navegador. Quadrado, a partir de 64px.',       valor: cfg?.faviconPath },
            ].map((img) => (
              <div class="border border-slate-200 rounded p-3 bg-slate-50">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <p class="text-xs font-medium text-slate-700">{img.titulo}</p>
                  {img.valor && (
                    <button type="button" data-remover={img.tipo}
                      class="text-[11px] text-slate-400 hover:text-red-600 transition-colors">remover</button>
                  )}
                </div>

                <div class="h-24 rounded border border-slate-200 bg-black/40 flex items-center justify-center overflow-hidden mb-2">
                  {img.valor
                    ? <img src={img.valor} alt={img.titulo} class="max-h-full max-w-full object-contain" />
                    : <span class="text-[11px] text-slate-300">usando a imagem padrão</span>}
                </div>

                <label class="block text-center text-[11px] text-teal hover:text-teal border border-slate-200 hover:border-teal/40 rounded py-1.5 cursor-pointer transition-colors">
                  {img.valor ? 'Trocar' : 'Escolher arquivo'}
                  <input type="file" accept="image/*" data-upload={img.tipo} class="hidden" />
                </label>
                <p class="text-[10px] text-slate-400 mt-1.5 leading-relaxed">{img.dica}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Cor do site -->
        <section id="cor" class="border border-slate-200 rounded-lg p-4 sm:p-5 bg-slate-50 scroll-mt-32">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-slate-700 mb-1">Cor do site</h2>
          <p class="text-xs text-slate-500 mb-4">
            A cor da sua marca, usada nos botões e destaques do site. O painel continua
            neutro de propósito — a cor é a sua, a ferramenta é a mesma para todo mundo.
          </p>

          <div class="flex flex-wrap items-end gap-4">
            <div>
              <label for="accentColor" class="block text-xs font-medium text-slate-500 mb-1.5">Escolher</label>
              <input
                type="color"
                id="accentColor"
                data-campo="accentColor"
                value={cfg?.accentColor ?? '#0f766e'}
                class="h-10 w-16 rounded border border-slate-200 bg-white p-1 cursor-pointer" />
            </div>
            <div>
              <label for="accentHex" class="block text-xs font-medium text-slate-500 mb-1.5">Código</label>
              <input
                type="text"
                id="accentHex"
                spellcheck="false"
                value={cfg?.accentColor ?? '#0f766e'}
                class="w-28 bg-white border border-slate-200 rounded px-3 py-2 text-sm font-mono text-slate-900 focus:border-teal focus:outline-none" />
            </div>
            <button type="button" id="accentPadrao"
              class="text-xs text-slate-500 hover:text-teal underline underline-offset-2 pb-2.5">
              voltar ao padrão
            </button>
          </div>

          <!-- As cores da logo: sugeridas no navegador, a partir da imagem — nunca aplicadas sozinhas. -->
          {cfg?.logoPath && (
            <div id="cores-da-logo" data-logo={cfg.logoPath} class="hidden mt-4">
              <p class="text-xs font-medium text-slate-500 mb-1.5">Cores da sua logo</p>
              <div id="cores-da-logo-lista" class="flex flex-wrap gap-2"></div>
              <p class="text-[11px] text-slate-400 mt-1.5">Toque numa para ver como fica no site. Só vale depois de salvar.</p>
            </div>
          )}

          <!-- Prévia: mostra a cor que o site VAI usar, não a que foi escolhida. -->
          <div class="mt-5 rounded-lg border border-slate-200 bg-slate-900 p-4">
            <p class="text-[11px] uppercase tracking-wider text-slate-500 mb-3">Como fica no site</p>
            <div class="flex flex-wrap items-center gap-4">
              <span id="accentBotao" class="inline-flex items-center justify-center rounded px-5 py-2.5 text-sm font-bold text-white">
                Reservar horário
              </span>
              <span id="accentTexto" class="text-sm font-medium">texto em destaque</span>
            </div>
          </div>

          <p id="accentAviso" class="hidden mt-3 text-[11px] leading-relaxed text-amber-700 bg-amber-50 border border-amber-200 rounded px-3 py-2"></p>
        </section>

        <!--
          Até 11/10/2026 este bloco dizia que a galeria, o catálogo de serviços e a cor de
          destaque "ainda não" se editavam — e as três já se editavam havia semanas (a
          Galeria e os Serviços têm tela própria; a cor está nesta mesma página, logo
          acima). Sobram de verdade só os depoimentos e as perguntas frequentes, que vêm
          do código e por isso só aparecem no site do Bayron (`lib/bayron.ts`).
        -->
        <section id="ainda-nao-editavel" class="border border-slate-200 rounded-lg p-4 text-xs text-slate-500 leading-relaxed scroll-mt-32">
          <p class="font-medium text-slate-600 mb-1.5">Ainda não existe no painel:</p>
          <p>Depoimentos de clientes e perguntas frequentes. Por isso o seu site ainda não tem
          essas duas seções. As fotos ficam em <a href="/admin/galeria" class="underline underline-offset-2">Galeria</a>,
          e os serviços, em <a href="/admin/servicos" class="underline underline-offset-2">Serviços</a>.</p>
        </section>
      </div>

      <div role="tabpanel" id="contato" aria-labelledby="aba-contato" hidden class="space-y-8">
        {secoesDa('contato').map((secao) => <SecaoDeCampos secao={secao} {...comuns} />)}

        <!-- Horário de vitrine -->
        <section id="horario-do-site" class="border border-slate-200 rounded-lg p-4 sm:p-5 bg-slate-50 scroll-mt-32">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-slate-700 mb-1">Horário exibido no site</h2>
          <p class="text-xs text-slate-500 mb-1">
            É só o texto que aparece no rodapé e na seção de localização.
          </p>
          <p class="text-[11px] text-amber-600/80 mb-4 leading-relaxed">
            Isto <strong>não</strong> muda a agenda. Os horários que o cliente consegue reservar
            continuam sendo os de <a href="/admin/horarios" class="underline hover:text-amber-700">Expediente</a>, no menu.
          </p>

          <div id="horarios" class="space-y-2"></div>

          <button type="button" id="add-horario"
            class="mt-3 text-xs text-teal hover:text-teal border border-teal/30 hover:border-teal/50 px-3 py-1.5 rounded transition-colors">
            + Adicionar linha
          </button>
        </section>
      </div>

      <div role="tabpanel" id="google" aria-labelledby="aba-google" hidden class="space-y-8">
        {secoesDa('google').map((secao) => <SecaoDeCampos secao={secao} {...comuns} />)}
      </div>

      <div id="cfg-msg" class="hidden text-sm rounded px-3 py-2"></div>
    </form>

    <!-- Fora do formulário: baixar não é salvar. -->
    <div role="tabpanel" id="dados" aria-labelledby="aba-dados" hidden>
      <ExportarDados />
    </div>
  </div>

  <!-- Barra de salvar fixa: o formulário é longo e o botão não pode sumir no fim da rolagem -->
  <div class="fixed bottom-0 left-0 right-0 border-t border-slate-200 bg-slate-50/95 backdrop-blur px-4 py-3 z-30">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-4">
      <span id="cfg-status" class="text-xs text-slate-400"></span>
      <button id="btn-salvar"
        class="shrink-0 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest px-8 py-2.5 rounded transition-colors text-xs disabled:opacity-50">
        Salvar
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  // Prévia da cor. Usa a MESMA função que o servidor usa ao gravar, para o que
  // aparece aqui ser exatamente o que vai para o site — sem lógica duplicada.
  import { derivarAccent, ACCENT_PADRAO } from '../../lib/accent.js';
  import { sugestoesDaLogo } from '../../lib/coresDaLogo.js';
  import { embedDoMapa } from '../../lib/mapa.js';

  // O fuso dos horários: a hora de agora no fuso escolhido, para o dono conferir
  // antes de salvar — "lá são 22:41?" responde melhor que "UTC−4".
  const seletorDeFuso = document.getElementById('fuso') as HTMLSelectElement | null;
  const fusoAgora = document.getElementById('fuso-agora');
  if (seletorDeFuso && fusoAgora) {
    const dizerAgora = () => {
      const hora = new Intl.DateTimeFormat('pt-BR', {
        timeZone: seletorDeFuso.value, hour: '2-digit', minute: '2-digit',
      }).format(new Date());
      fusoAgora.textContent = `Nesse fuso, agora são ${hora}.`;
    };
    seletorDeFuso.addEventListener('change', dizerAgora);
    dizerAgora();
  }

  // Prévia do mapa — a MESMA função do site (`lib/mapa.ts`), como a da cor abaixo:
  // o ponto que aparece aqui é o que o site vai mostrar. Espera o dono parar de
  // digitar para não pedir um mapa ao Google a cada letra.
  const previa = document.getElementById('mapa-previa') as HTMLIFrameElement | null;
  const previaVazia = document.getElementById('mapa-previa-vazia');
  const camposDoMapa = ['addressStreet', 'addressCity', 'mapsEmbedQuery']
    .map((id) => document.getElementById(id) as HTMLInputElement | null);
  let esperaDoMapa: ReturnType<typeof setTimeout> | undefined;
  const atualizarPrevia = () => {
    if (!previa || !previaVazia) return;
    const [rua, cidade, busca] = camposDoMapa.map((c) => c?.value ?? '');
    const src = embedDoMapa({ addressStreet: rua, addressCity: cidade, mapsEmbedQuery: busca });
    previa.hidden = !src;
    previaVazia.hidden = Boolean(src);
    if (src && previa.getAttribute('src') !== src) previa.setAttribute('src', src);
  };
  for (const campo of camposDoMapa) {
    campo?.addEventListener('input', () => {
      clearTimeout(esperaDoMapa);
      esperaDoMapa = setTimeout(atualizarPrevia, 800);
    });
  }

  const entrada = document.getElementById('accentColor') as HTMLInputElement | null;
  const hex     = document.getElementById('accentHex') as HTMLInputElement | null;
  const botao   = document.getElementById('accentBotao') as HTMLElement | null;
  const texto   = document.getElementById('accentTexto') as HTMLElement | null;
  const aviso   = document.getElementById('accentAviso') as HTMLElement | null;
  const padrao  = document.getElementById('accentPadrao');

  if (entrada && hex && botao && texto && aviso) {
    const pintar = (escolhida: string) => {
      const a = derivarAccent(escolhida);
      botao.style.backgroundColor = a.color;
      texto.style.color = a.light;

      // A cor gravada difere da escolhida quando a marca é clara demais para
      // segurar texto branco. Dizer isso é melhor do que mudar em silêncio.
      if (a.color.toLowerCase() !== escolhida.toLowerCase()) {
        aviso.textContent =
          `Essa cor é clara demais para o texto branco do botão ficar legível, então o site vai usar ${a.color}, ` +
          `que é o mesmo tom um pouco mais escuro. A prévia acima já mostra o resultado real.`;
        aviso.classList.remove('hidden');
      } else {
        aviso.classList.add('hidden');
      }
    };

    const sincronizar = (valor: string, vindoDoTexto: boolean) => {
      const v = valor.trim().toLowerCase();
      if (!/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/.test(v)) return;   // texto pela metade: espera
      if (vindoDoTexto) entrada.value = v.length === 4
        ? '#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3]
        : v;
      else hex.value = v;
      pintar(entrada.value);
    };

    entrada.addEventListener('input', () => sincronizar(entrada.value, false));
    hex.addEventListener('input', () => sincronizar(hex.value, true));
    padrao?.addEventListener('click', () => {
      entrada.value = ACCENT_PADRAO.color;
      hex.value = ACCENT_PADRAO.color;
      pintar(ACCENT_PADRAO.color);
    });

    pintar(entrada.value);

    // ── As cores da logo (`lib/coresDaLogo.ts`, §4.2): sugere, nunca aplica sozinho.
    // Tocar numa preenche o campo pelo mesmo caminho do seletor — a prévia e o aviso de
    // "clara demais" vêm junto —, e o site só muda depois de Salvar.
    const blocoDaLogo = document.getElementById('cores-da-logo');
    const listaDaLogo = document.getElementById('cores-da-logo-lista');
    if (blocoDaLogo && listaDaLogo && blocoDaLogo.dataset.logo) {
      const logo = new Image();
      logo.addEventListener('load', () => {
        try {
          // 96 px no lado maior bastam para achar as cores, e a conta é instantânea.
          const escala = Math.min(1, 96 / Math.max(logo.naturalWidth, logo.naturalHeight, 1));
          const tela = document.createElement('canvas');
          tela.width = Math.max(1, Math.round(logo.naturalWidth * escala));
          tela.height = Math.max(1, Math.round(logo.naturalHeight * escala));
          const ctx = tela.getContext('2d', { willReadFrequently: true });
          if (!ctx) return;
          ctx.drawImage(logo, 0, 0, tela.width, tela.height);
          const cores = sugestoesDaLogo(ctx.getImageData(0, 0, tela.width, tela.height).data);
          for (const cor of cores) {
            const amostra = document.createElement('button');
            amostra.type = 'button';
            amostra.className = 'h-9 w-9 rounded-full border-2 border-white shadow ring-1 ring-slate-300 hover:ring-teal focus:outline-none focus:ring-2 focus:ring-teal';
            amostra.style.backgroundColor = cor;
            amostra.title = cor;
            amostra.dataset.cor = cor;
            amostra.setAttribute('aria-label', `Usar ${cor}, da sua logo`);
            amostra.addEventListener('click', () => {
              entrada.value = cor;
              sincronizar(cor, false);
            });
            listaDaLogo.appendChild(amostra);
          }
          if (cores.length) blocoDaLogo.classList.remove('hidden');
        } catch {
          // Imagem que o navegador não deixa ler: fica sem sugestão, como antes.
        }
      });
      logo.src = blocoDaLogo.dataset.logo;
    }
    // ── fim das cores da logo
  }

  // ── As abas (15/10/2026) ────────────────────────────────────────────────────
  // Uma aba aberta por vez; as setas, Home e End andam entre elas, como o leitor de tela
  // espera de uma lista de abas. O endereço decide qual abre: `#contato` abre a aba, e
  // `#endereco`, a aba onde o bloco está — e rola até ele. É assim que o Início e o
  // medidor de completude levam ao campo certo.
  const abas = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-aba]')];
  const painelDa = (aba: HTMLElement) => document.getElementById(aba.getAttribute('aria-controls') ?? '');
  const abaDo = (painel: Element) => abas.find((a) => a.getAttribute('aria-controls') === painel.id) ?? null;

  function abrirAba(aba: HTMLButtonElement, foco = false) {
    for (const a of abas) {
      const esta = a === aba;
      a.setAttribute('aria-selected', String(esta));
      a.tabIndex = esta ? 0 : -1;
      const painel = painelDa(a);
      if (painel) painel.hidden = !esta;
    }
    if (foco) aba.focus();
  }

  // Abre a aba onde o elemento está. Devolve se achou uma. (Comentário de linha de
  // propósito: o `accept` das imagens abre um "comentário de bloco" para o leitor dos
  // testes, e um fim de comentário de bloco aqui o fecharia, engolindo a página no meio.)
  function abrirAbaDe(el: Element | null): boolean {
    const painel = el?.closest('[role="tabpanel"]');
    const aba = painel ? abaDo(painel) : null;
    if (aba) abrirAba(aba);
    return aba !== null;
  }

  function irParaOEndereco() {
    const id = decodeURIComponent(location.hash.slice(1));
    const alvo = id ? document.getElementById(id) : null;
    if (!alvo || !abrirAbaDe(alvo)) return;
    if (alvo.getAttribute('role') !== 'tabpanel') alvo.scrollIntoView({ block: 'start' });
  }

  abas.forEach((aba, i) => {
    aba.addEventListener('click', () => {
      abrirAba(aba);
      history.replaceState(null, '', `#${aba.dataset.aba}`);
    });
    aba.addEventListener('keydown', (e) => {
      const ultima = abas.length - 1;
      const destino = e.key === 'ArrowRight' ? (i === ultima ? 0 : i + 1)
        : e.key === 'ArrowLeft' ? (i === 0 ? ultima : i - 1)
        : e.key === 'Home' ? 0
        : e.key === 'End' ? ultima
        : -1;
      if (destino < 0) return;
      e.preventDefault();
      abrirAba(abas[destino], true);
      history.replaceState(null, '', `#${abas[destino].dataset.aba}`);
    });
  });
  irParaOEndereco();
  window.addEventListener('hashchange', irParaOEndereco);

  // O ponto na aba com mudança não salva. A conta compara com o que a página trouxe —
  // desfazer a mudança apaga o ponto —, e o Salvar recomeça a conta.
  const formulario = document.getElementById('form-cfg');
  const statusDoSalvar = document.getElementById('cfg-status');
  const paineisDoFormulario = [...(formulario?.querySelectorAll<HTMLElement>('[role="tabpanel"]') ?? [])];
  const NAO_SALVO = 'Alterações não salvas';
  const retratoDe = (painel: HTMLElement) => JSON.stringify(
    [...painel.querySelectorAll<HTMLInputElement>('[data-campo], [data-h-label], [data-h-hours], [data-h-closed]')]
      .map((el) => (el.type === 'checkbox' ? el.checked : el.value)));
  let retratos = new Map(paineisDoFormulario.map((p) => [p.id, retratoDe(p)]));

  // A linha ao lado do Salvar, que fica sempre à vista: em vermelho, quando é a recusa.
  function dizerNoSalvar(texto: string, erro = false) {
    if (!statusDoSalvar) return;
    statusDoSalvar.textContent = texto;
    statusDoSalvar.classList.toggle('text-red-700', erro);
    statusDoSalvar.classList.toggle('text-slate-400', !erro);
  }

  function conferirMudancas() {
    let alguma = false;
    for (const painel of paineisDoFormulario) {
      const mudou = retratoDe(painel) !== retratos.get(painel.id);
      alguma ||= mudou;
      const ponto = abaDo(painel)?.querySelector<HTMLElement>('[data-aba-mudou]');
      if (ponto) ponto.hidden = !mudou;
    }
    const agora = statusDoSalvar?.textContent ?? '';
    if (agora === 'Salvando…' || statusDoSalvar?.classList.contains('text-red-700')) return;
    if (alguma) dizerNoSalvar(NAO_SALVO);
    else if (agora === NAO_SALVO) dizerNoSalvar('');
  }
  formulario?.addEventListener('input', conferirMudancas);
  formulario?.addEventListener('change', conferirMudancas);
  // O que muda o formulário sem digitar: a cor da logo, "voltar ao padrão", as linhas do horário.
  formulario?.addEventListener('click', () => setTimeout(conferirMudancas));

  // Clicou em Salvar: a linha volta à cor de sempre — o "Salvando…" não é recusa.
  document.getElementById('btn-salvar')?.addEventListener('click', () => dizerNoSalvar(statusDoSalvar?.textContent ?? ''));

  document.addEventListener('configuracoes:salvo', () => {
    retratos = new Map(paineisDoFormulario.map((p) => [p.id, retratoDe(p)]));
    dizerNoSalvar(statusDoSalvar?.textContent ?? '');
    conferirMudancas();
  });

  // O Salvar recusou um campo: a aba dele abre, e o cursor vai para ele, com a borda
  // vermelha até ele ser corrigido; e o porquê fica ao lado do Salvar, à vista. Com a
  // tela em abas, o campo podia estar escondido.
  document.addEventListener('configuracoes:erro', (e) => {
    const { campo, erro } = (e as CustomEvent<{ campo: string | null; erro: string }>).detail ?? { campo: null, erro: '' };
    conferirMudancas();
    dizerNoSalvar(`Não salvou: ${erro}`, true);
    const nome = campo ?? '';
    const el = nome.startsWith('businessHours')
      ? document.getElementById('horarios')
      : nome ? document.querySelector<HTMLElement>(`[data-campo="${CSS.escape(nome)}"]`) : null;
    if (!el || !abrirAbaDe(el)) return;
    el.scrollIntoView({ block: 'center' });
    if (el.matches('input, select, textarea')) {
      el.setAttribute('aria-invalid', 'true');
      el.focus({ preventScroll: true });
      el.addEventListener('input', () => {
        el.removeAttribute('aria-invalid');
        dizerNoSalvar('');
        conferirMudancas();
      }, { once: true });
    }
  });
</script>

<script is:inline define:vars={{ horariosIniciais: horarios }}>
  const wrap = document.getElementById('horarios');

  function linhaHorario(h) {
    const div = document.createElement('div');
    div.className = 'flex flex-wrap items-center gap-2';
    div.innerHTML = `
      <input data-h-label placeholder="Segunda — Sexta"
        class="flex-1 min-w-[120px] bg-slate-50 border border-slate-200 rounded px-3 py-2 text-sm text-slate-900 placeholder:text-slate-300 focus:border-teal/50 focus:outline-none">
      <input data-h-hours placeholder="09:00 — 20:00"
        class="flex-1 min-w-[100px] bg-slate-50 border border-slate-200 rounded px-3 py-2 text-sm text-slate-900 placeholder:text-slate-300 focus:border-teal/50 focus:outline-none">
      <div class="flex items-center gap-2 ml-auto">
        <label class="flex items-center gap-1.5 text-xs text-slate-500 whitespace-nowrap">
          <input type="checkbox" data-h-closed class="accent-teal"> fechado
        </label>
        <button type="button" data-h-remove
          class="text-slate-400 hover:text-red-600 px-2 py-1 text-lg leading-none transition-colors" aria-label="Remover linha">&times;</button>
      </div>`;
    div.querySelector('[data-h-label]').value = h?.label ?? '';
    div.querySelector('[data-h-hours]').value = h?.hours ?? '';
    div.querySelector('[data-h-closed]').checked = Boolean(h?.closed);
    div.querySelector('[data-h-remove]').addEventListener('click', () => div.remove());
    return div;
  }

  (horariosIniciais.length ? horariosIniciais : [null]).forEach((h) => wrap.appendChild(linhaHorario(h)));
  document.getElementById('add-horario').addEventListener('click', () => wrap.appendChild(linhaHorario(null)));

  const msg = document.getElementById('cfg-msg');
  const status = document.getElementById('cfg-status');
  const btn = document.getElementById('btn-salvar');

  function mostrar(texto, erro) {
    msg.textContent = texto;
    msg.className = erro
      ? 'text-sm rounded px-3 py-2 bg-red-500/10 border border-red-500/30 text-red-700'
      : 'text-sm rounded px-3 py-2 bg-teal/10 border border-teal/30 text-teal';
    msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ── Imagens ────────────────────────────────────────────────────────────────
  // Sobem na hora em que o arquivo é escolhido, e não no "Salvar": upload é uma
  // operação com resultado visível, e misturar com o formulário faria o usuário
  // esperar sem entender o quê.
  document.querySelectorAll('[data-upload]').forEach((input) => {
    input.addEventListener('change', async () => {
      const arquivo = input.files?.[0];
      if (!arquivo) return;
      const fd = new FormData();
      fd.append('tipo', input.dataset.upload);
      fd.append('arquivo', arquivo);
      status.textContent = 'Enviando imagem…';
      try {
        const res = await fetch('/api/admin/settings/media', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok) { location.reload(); return; }
        mostrar(data.error ?? 'Não consegui enviar a imagem', true);
      } catch { mostrar('Erro de conexão ao enviar a imagem', true); }
      status.textContent = '';
      input.value = '';
    });
  });

  document.querySelectorAll('[data-remover]').forEach((b) => {
    b.addEventListener('click', async () => {
      status.textContent = 'Removendo…';
      try {
        const res = await fetch('/api/admin/settings/media', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tipo: b.dataset.remover }),
        });
        if (res.ok) { location.reload(); return; }
        const d = await res.json();
        mostrar(d.error ?? 'Não consegui remover', true);
      } catch { mostrar('Erro de conexão', true); }
      status.textContent = '';
    });
  });

  btn.addEventListener('click', async () => {
    msg.className = 'hidden';
    const payload = {};

    document.querySelectorAll('[data-campo]').forEach((el) => {
      const chave = el.dataset.campo;
      payload[chave] = el.dataset.tipo === 'number'
        ? Number(el.value || 0)
        : el.value.trim();
    });

    payload.businessHours = [...wrap.children]
      .map((linha) => ({
        label: linha.querySelector('[data-h-label]').value.trim(),
        hours: linha.querySelector('[data-h-hours]').value.trim(),
        closed: linha.querySelector('[data-h-closed]').checked,
      }))
      .filter((h) => h.label || h.hours);

    btn.disabled = true;
    status.textContent = 'Salvando…';
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        mostrar('Salvo. Abra o site numa outra aba do navegador para conferir.', false);
        status.textContent = 'Salvo às ' + new Date().toLocaleTimeString('pt-BR');
        document.dispatchEvent(new CustomEvent('configuracoes:salvo'));
      } else {
        mostrar(data.error ?? 'Erro ao salvar', true);
        status.textContent = '';
        // O campo recusado pode estar noutra aba: o script das abas a abre e põe o cursor nele.
        document.dispatchEvent(new CustomEvent('configuracoes:erro', { detail: { campo: data.campo ?? null, erro: data.error ?? 'Erro ao salvar' } }));
      }
    } catch {
      mostrar('Erro de conexão', true);
      status.textContent = '';
    }
    btn.disabled = false;
  });
</script>
