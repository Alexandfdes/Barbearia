  document.querySelector('[data-empty-block]')?.addEventListener('click',  () => document.getElementById('btn-block')?.click());

  // ─── Comanda: fechar atendimento com serviços extras ─────────────────────────
  const comandaModal = document.getElementById('comanda-modal');
  let comandaApptId: string | null = null;
  let comandaExtras: { serviceId: number; name: string; priceCents: number }[] = [];
  let servicesCatalog: any[] | null = null;

  async function ensureServicesCatalog() {
    if (servicesCatalog) return servicesCatalog;
    try {
      // A rota do PAINEL, pela sessão: a pública (`/api/services`) acha a barbearia pelo
      // endereço, e o painel central não é endereço de barbearia — até 13/10/2026 isto
      // voltava 404 e a comanda ficava sem os serviços extras (`api/admin/slots.ts`).
      const res = await fetch('/api/admin/services');
      servicesCatalog = res.ok ? await res.json() : [];
    } catch { servicesCatalog = []; }
    // As duas pontas acima gravam uma lista: aqui nunca é `null`.
    return servicesCatalog!;
  }

  /** Um texto num `<span>`, sem innerHTML: os nomes vêm do catálogo que a barbearia escreve. */
  function texto(classe: string, conteudo: string): HTMLSpanElement {
    const el = document.createElement('span');
    el.className = classe;
    el.textContent = conteudo;
    return el;
  }

  function renderComanda() {
    const appt = clientData.appts.find(a => String(a.id) === String(comandaApptId));
    const mainCents = appt ? appt.priceCents : 0;
    // O que o agendamento já trouxe — o produto do combo — entra na conta, e o total é o
    // que a linha vai mostrar depois de fechar. Até 15/10/2026 ele ficava de fora daqui:
    // a comanda dizia um total, e a linha e a receita, outro (`lib/valorDoAtendimento.ts`).
    const jaNoAgendamento = appt ? appt.items : [];
    const itens = document.getElementById('cm-itens');
    if (itens) {
      itens.replaceChildren(...jaNoAgendamento.map((it) => {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 text-sm mt-2';
        const nome = texto('text-slate-700 truncate', it.name);
        nome.append(texto('text-slate-400 text-xs', ' · já no agendamento'));
        row.append(nome, texto('text-slate-800 tabular-nums shrink-0 ml-3', reais(it.priceCents)));
        return row;
      }));
    }
    const list = document.getElementById('cm-extras');
    if (list) {
      list.replaceChildren(...comandaExtras.map((ex, i) => {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 text-sm bg-slate-100 rounded px-3 py-2';
        const direita = document.createElement('span');
        direita.className = 'flex items-center gap-3';
        const remover = document.createElement('button');
        remover.type = 'button';
        remover.dataset.cmRemove = String(i);
        remover.className = 'text-red-600/70 hover:text-red-600';
        remover.setAttribute('aria-label', 'Remover');
        remover.textContent = '✕';
        direita.append(texto('text-slate-500 tabular-nums', reais(ex.priceCents)), remover);
        row.append(texto('text-slate-700', ex.name), direita);
        return row;
      }));
    }
    const total = mainCents + somaDosItens(jaNoAgendamento) + somaDosItens(comandaExtras);
    const totalEl = document.getElementById('cm-total');
    if (totalEl) totalEl.textContent = reais(total);
  }

  async function openComanda(id: string) {
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (!appt) return;
    comandaApptId = id;
    comandaExtras = [];

    const apptEl  = document.getElementById('cm-appt');
    const nameEl  = document.getElementById('cm-main-name');
    const priceEl = document.getElementById('cm-main-price');
    if (apptEl)  apptEl.textContent  = `${appt.customerName} · ${appt.timeLocal}`;
    if (nameEl)  nameEl.textContent  = appt.serviceName;
    if (priceEl) priceEl.textContent = appt.price;

    const select = document.getElementById('cm-extra-select') as HTMLSelectElement | null;
    const catalog = await ensureServicesCatalog();
    if (select && select.options.length <= 1) {
      catalog.forEach((svc: any) => {
        const opt = document.createElement('option');
        opt.value = String(svc.id);
        opt.dataset.name  = svc.name;
        opt.dataset.cents = String(svc.priceCents);
        opt.textContent   = `${svc.name} — ${reais(svc.priceCents)}`;
        select.appendChild(opt);
      });
    }
    renderComanda();
    comandaModal?.classList.remove('hidden');
  }

  function closeComanda() {
    comandaModal?.classList.add('hidden');
    comandaApptId = null;
    comandaExtras = [];
  }

  document.getElementById('cm-extra-add')?.addEventListener('click', () => {
    const select = document.getElementById('cm-extra-select') as HTMLSelectElement | null;
    if (!select || !select.value) return;
    const opt = select.options[select.selectedIndex];
    comandaExtras.push({
      serviceId:  Number(select.value),
      name:       opt.dataset.name ?? 'Serviço',
      priceCents: Number(opt.dataset.cents ?? '0'),
    });
    select.value = '';
    renderComanda();
  });

  document.getElementById('cm-extras')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cm-remove]');
    if (!btn) return;
    comandaExtras.splice(Number(btn.dataset.cmRemove), 1);
    renderComanda();
  });

  document.getElementById('cm-cancel')?.addEventListener('click', closeComanda);
  document.getElementById('cm-close')?.addEventListener('click', closeComanda);
  comandaModal?.addEventListener('click', (e) => { if (e.target === comandaModal) closeComanda(); });

  document.getElementById('cm-confirm')?.addEventListener('click', async () => {
    if (comandaApptId == null) return;
    const id = comandaApptId;
    const btn = document.getElementById('cm-confirm') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = '...'; }
    const extras = comandaExtras.map(e => ({ serviceId: e.serviceId, priceCents: e.priceCents }));
    const { ok, data } = await callApi(`/api/admin/appointments/${id}/complete`, 'POST', { extras });
    if (ok) {
      // Os extras recém-lançados entram nos itens do agendamento — o produto do combo já
      // estava lá —, para a linha, o detalhe e a receita mudarem na hora, sem recarregar.
      const appt = clientData.appts.find(a => String(a.id) === String(id));
      if (appt) {
        appt.items = [...appt.items, ...comandaExtras.map(e => ({ name: e.name, priceCents: e.priceCents }))];
        appt.itemsCents = somaDosItens(appt.items);
      }
      updateApptCardStatus(id, 'completed');
      closeComanda();
      closeDetail();
      toast(extras.length ? 'Atendimento fechado' : 'Marcado como concluído', 'success');
    } else {
      toast(data.error ?? 'Erro', 'error');
    }
    if (btn) { btn.disabled = false; btn.textContent = 'Concluir e fechar'; }
  });

  // ─── Venda de produto avulsa ─────────────────────────────────────────────────
  (function setupProductSale() {
    const modal = document.getElementById('sale-modal');
    if (!modal) return;
    const productSel = document.getElementById('sale-product') as HTMLSelectElement;
    const nameWrap   = document.getElementById('sale-name-wrap') as HTMLElement;
    const nameInput  = document.getElementById('sale-name') as HTMLInputElement;
    const qtyInput   = document.getElementById('sale-qty') as HTMLInputElement;
    const priceInput = document.getElementById('sale-price') as HTMLInputElement;
    const totalEl    = document.getElementById('sale-total') as HTMLElement;
    const errEl      = document.getElementById('sale-error') as HTMLElement;
    const confirmBtn = document.getElementById('sale-confirm') as HTMLButtonElement;
    const barberSel  = document.getElementById('sale-barber') as HTMLSelectElement | null;
    const list       = document.getElementById('sales-list');
    const emptyEl    = document.getElementById('sales-empty');
    const countEl    = document.getElementById('sales-count');

    const brlSale = (cents: number) => reais(cents);
    const escSale = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const unitCents = () => { const v = parseFloat(priceInput.value); return isFinite(v) && v >= 0 ? Math.round(v * 100) : 0; };
    const qty = () => { const q = parseInt(qtyInput.value, 10); return isFinite(q) && q > 0 ? q : 1; };
    const refreshTotal = () => { totalEl.textContent = brlSale(unitCents() * qty()); };

    function applyProduct() {
      const opt = productSel.options[productSel.selectedIndex];
      if (productSel.value === '__outro__') {
        nameWrap.classList.remove('hidden');
        priceInput.value = '';
      } else {
        nameWrap.classList.add('hidden');
        priceInput.value = (parseInt(opt.dataset.cents || '0', 10) / 100).toFixed(2);
      }
      refreshTotal();
    }

    function refreshSalesMeta() {
      const n = list ? list.querySelectorAll('[data-sale-id]').length : 0;
      if (emptyEl) emptyEl.classList.toggle('hidden', n > 0);
      if (countEl) countEl.textContent = n ? `${n} ${n === 1 ? 'venda' : 'vendas'} · ${brlSale(clientData.salesCents || 0)}` : '';
    }

    function saleRow(sale: any) {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3 bg-white border border-slate-200 rounded-md px-4 py-2.5';
      row.dataset.saleId = String(sale.id);
      row.dataset.cents  = String(sale.priceCents);
      const who = (clientData.role === 'admin' && sale.barberName) ? `<p class="text-[10px] text-slate-400">${escSale(sale.barberName.split(' ')[0])}</p>` : '';
      const q = sale.quantity > 1 ? ` <span class="text-slate-500">×${sale.quantity}</span>` : '';
      row.innerHTML = `<div class="flex-1 min-w-0"><p class="text-sm text-slate-800 truncate">${escSale(sale.name)}${q}</p>${who}</div><span class="text-sm font-semibold text-teal tabular-nums shrink-0">${brlSale(sale.priceCents)}</span><button type="button" data-sale-remove="${sale.id}" class="text-slate-400 hover:text-red-600 transition-colors shrink-0" aria-label="Remover venda">✕</button>`;
      return row;
    }

    document.getElementById('btn-sale')?.addEventListener('click', () => {
      errEl.classList.add('hidden'); errEl.textContent = '';
      qtyInput.value = '1';
      productSel.selectedIndex = 0;
      applyProduct();
      modal.classList.remove('hidden');
    });
    modal.querySelectorAll('[data-sale-close]').forEach(el => el.addEventListener('click', () => modal.classList.add('hidden')));
    productSel.addEventListener('change', applyProduct);
    qtyInput.addEventListener('input', refreshTotal);
    priceInput.addEventListener('input', refreshTotal);

    confirmBtn.addEventListener('click', async () => {
      errEl.classList.add('hidden');
      const isOutro = productSel.value === '__outro__';
      const name = (isOutro ? nameInput.value : productSel.value).trim();
      const unit = unitCents();
      const q = qty();
      if (!name)     { errEl.textContent = 'Informe o nome do produto'; errEl.classList.remove('hidden'); return; }
      if (unit <= 0) { errEl.textContent = 'Informe o preço'; errEl.classList.remove('hidden'); return; }

      confirmBtn.disabled = true; confirmBtn.textContent = 'Registrando...';
      const payload: any = { name, quantity: q, unitPriceCents: unit, date: clientData.date };
      if (barberSel) payload.barberId = parseInt(barberSel.value, 10);
      const { ok, data } = await callApi('/api/admin/product-sales', 'POST', payload);
      if (ok && data.sale) {
        clientData.salesCents = (clientData.salesCents || 0) + data.sale.priceCents;
        list?.prepend(saleRow(data.sale));
        refreshSalesMeta();
        recalculateRevenue();
        modal.classList.add('hidden');
        toast('Venda registrada', 'success');
      } else {
        errEl.textContent = data.error ?? 'Erro ao registrar'; errEl.classList.remove('hidden');
      }
      confirmBtn.disabled = false; confirmBtn.textContent = 'Registrar venda';
    });

    list?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-sale-remove]') as HTMLElement | null;
      if (!btn) return;
      const id = btn.dataset.saleRemove;
      const row = list.querySelector(`[data-sale-id="${id}"]`) as HTMLElement | null;
      const confirmed = await showConfirm({ title: 'Remover venda?', message: 'A venda sai do faturamento do dia.', okLabel: 'Remover' });
      if (!confirmed) return;
      const { ok, data } = await callApi(`/api/admin/product-sales/${id}`, 'DELETE');
      if (ok) {
        const cents = row ? parseInt(row.dataset.cents || '0', 10) : 0;
        clientData.salesCents = Math.max(0, (clientData.salesCents || 0) - cents);
        row?.remove();
        refreshSalesMeta();
        recalculateRevenue();
        toast('Venda removida', 'success');
      } else {
        toast(data.error ?? 'Erro ao remover', 'error');
      }
    });
  })();


  // ─── Manual booking form ─────────────────────────────────────────────────────
  let selectedSlot: string | null = null;

  async function loadServices() {
    const serviceEl = document.getElementById('m-service') as HTMLSelectElement | null;
    if (!serviceEl || serviceEl.options.length > 1) return;
    // A do painel, pela sessão — ver `ensureServicesCatalog`.
    const res  = await fetch('/api/admin/services');
    const data = await res.json();
    data.forEach((svc: { id: number; name: string }) => {
      const opt = document.createElement('option');
      opt.value       = String(svc.id);
      opt.textContent = svc.name;
      serviceEl.appendChild(opt);
    });
  }

  async function loadSlots() {
    const slotsWrap = document.getElementById('m-slots-wrap');
    if (!slotsWrap) return;

    const barberId  = role === 'admin'
      ? (document.getElementById('m-barber') as HTMLSelectElement | null)?.value
      : String(sessionBarberId);
    const serviceId = (document.getElementById('m-service') as HTMLSelectElement | null)?.value;

    if (!barberId || !serviceId) {
      slotsWrap.innerHTML = '<span class="text-slate-500">Selecione barbeiro e serviço primeiro.</span>';
      selectedSlot = null;
      return;
    }

    slotsWrap.innerHTML = '<span class="text-slate-500">Carregando...</span>';
    selectedSlot = null;

    try {
      const res  = await fetch(`/api/admin/slots?barberId=${barberId}&serviceId=${serviceId}&date=${date}`);
      const data = await res.json();

      if (!data.slots?.length) {
        slotsWrap.innerHTML = '<span class="text-slate-500">Nenhum horário disponível.</span>';
        return;
      }

      slotsWrap.innerHTML = '';
      const grid = document.createElement('div');
      grid.className = 'flex flex-wrap gap-2';

      data.slots.forEach((slot: string | { utc: string; time: string }) => {
        const isoStr = typeof slot === 'string' ? slot : slot.utc;
        const label  = typeof slot === 'string'
          ? (() => {
              // Pelo fuso da barbearia, não por "- 3" (`PENDENCIAS-ABERTAS.md` §2.11).
              return formatInTimeZone(new Date(isoStr), TZ, 'HH:mm');
            })()
          : slot.time;
        const btn = document.createElement('button');
        btn.type        = 'button';
        btn.textContent = label;
        btn.dataset.iso = isoStr;
        btn.dataset.time = label;
        btn.className   = 'text-xs px-3 py-1.5 border border-slate-200 rounded text-slate-500 hover:border-teal/40 hover:text-teal transition-colors';
        btn.addEventListener('click', () => {
          slotsWrap.querySelectorAll('button').forEach(b =>
            b.classList.remove('bg-teal/20', 'border-teal/50', 'text-teal'));
          btn.classList.add('bg-teal/20', 'border-teal/50', 'text-teal');
          selectedSlot = isoStr;
        });
        grid.appendChild(btn);
      });
      slotsWrap.appendChild(grid);
    } catch {
      slotsWrap.innerHTML = '<span class="text-red-600">Erro ao carregar horários.</span>';
    }
  }

  document.getElementById('m-barber')?.addEventListener('change', loadSlots);
  document.getElementById('m-service')?.addEventListener('change', loadSlots);

  document.getElementById('m-submit')?.addEventListener('click', async () => {
    const errorEl = document.getElementById('m-error') as HTMLElement;
    const submitBtn = document.getElementById('m-submit') as HTMLButtonElement;

    const barberId  = role === 'admin'
      ? (document.getElementById('m-barber') as HTMLSelectElement | null)?.value
      : String(sessionBarberId);
    const serviceId = (document.getElementById('m-service') as HTMLSelectElement | null)?.value;
    const name      = (document.getElementById('m-name') as HTMLInputElement | null)?.value.trim();
    const phone     = (document.getElementById('m-phone') as HTMLInputElement | null)?.value.trim();

    const showErr = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    errorEl.classList.add('hidden');
    if (!barberId)  return showErr('Selecione um barbeiro');
    if (!serviceId) return showErr('Selecione um serviço');
    if (!selectedSlot) return showErr('Selecione um horário');
    if (!name)      return showErr('Informe o nome do cliente');
    if (!phone)     return showErr('Informe o WhatsApp do cliente');

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Agendando...';

    const { ok, data } = await callApi('/api/admin/appointments', 'POST', {
      barberId:      parseInt(barberId),
      serviceId:     parseInt(serviceId),
      customerName:  name,
      customerPhone: phone,
      startsAt:      selectedSlot,
    });

    if (ok) {
      location.reload();
    } else {
      showErr(data.error ?? 'Erro ao criar agendamento');
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Confirmar agendamento';
    }
  });

  // ─── Block time form ──────────────────────────────────────────────────────────
  document.getElementById('b-submit')?.addEventListener('click', async () => {
    const errorEl  = document.getElementById('b-error') as HTMLElement;
    const submitBtn = document.getElementById('b-submit') as HTMLButtonElement;

    const barberId = role === 'admin'
      ? ((document.getElementById('b-barber') as HTMLSelectElement | null)?.value || null)
      : sessionBarberId;
    const startTime = (document.getElementById('b-start') as HTMLInputElement | null)?.value;
    const endTime   = (document.getElementById('b-end') as HTMLInputElement | null)?.value;
    const reason    = (document.getElementById('b-reason') as HTMLInputElement | null)?.value.trim() || undefined;

    const showErr = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    errorEl.classList.add('hidden');
    if (!startTime || !endTime) return showErr('Informe os horários');

    const startsAt = localTimeToUtcIso(date, startTime);
    const endsAt   = localTimeToUtcIso(date, endTime);

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Bloqueando...';

    const { ok, data } = await callApi('/api/admin/time-off', 'POST', {
      // Do barbeiro, vem o número dele; do dono, o texto do seletor — o parseInt aceita os dois.
      barberId: barberId ? parseInt(barberId as string) : null,
      startsAt,
      endsAt,
      reason,
    });

    if (ok) {
      location.reload();
    } else {
      showErr(data.error ?? 'Erro ao bloquear');
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Bloquear';
    }
  });

  // ─── Scroll auto pra "Agora" se for hoje ──────────────────────────────────────
  // Restaura posição se vier de um auto-refresh
  const restoreScroll = sessionStorage.getItem('dia-scroll-y');
  if (restoreScroll) {
    sessionStorage.removeItem('dia-scroll-y');
    requestAnimationFrame(() => window.scrollTo(0, parseInt(restoreScroll, 10)));
  } else if (date === clientData.todayStr) {
    requestAnimationFrame(() => {
      const tlArea = document.getElementById('timeline-area');
      const now = tlArea?.querySelector('.bg-teal.h-px');
      if (now) {
        const rect = now.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + rect.top - 200, behavior: 'smooth' });
      }
    });
  } else {
    // Dia passado/futuro: abre já no primeiro agendamento, se houver
    requestAnimationFrame(() => {
      const firstCard = document.querySelector('.appt-card');
      if (firstCard) {
        const rect = firstCard.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + rect.top - 160, behavior: 'smooth' });
      }
    });
  }

  // ─── Auto-refresh discreto ──────────────────────────────────────────────────
  // A cada 60s verifica se mudou (count ou maxModified). Se sim e nada está
  // em foco, salva scroll e recarrega.
  (function setupAutoRefresh() {
    // Snapshot inicial: conta direto do DOM
    const initialCount = document.querySelectorAll('.appt-card').length;
    let lastKnownCount = initialCount;
    let lastKnownMod   = '';
    // A primeira resposta só marca o ponto de partida. Um sinal próprio, e não "o último
    // ainda vazio": no dia sem nenhum agendamento a assinatura É vazia, e o primeiro que
    // chegava virava ponto de partida de novo — a agenda nunca recarregava (até 17/10/2026).
    let temPontoDePartida = false;

    async function poll() {
      // Não checa em outras abas / janela escondida
      if (document.hidden) return;
      // Não recarrega se modal aberto ou form em uso
      if (!detailModal?.classList.contains('hidden')) return;
      if (!confirmModal?.classList.contains('hidden')) return;
      if (!formManual?.classList.contains('hidden')) return;
      if (!formBlock?.classList.contains('hidden')) return;
      // Não recarrega se usuário tá digitando algo
      const ae = document.activeElement;
      if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) return;

      try {
        const params = new URLSearchParams({ date });
        if (filterBarberId) params.set('barber', String(filterBarberId));
        const res = await fetch(`/api/admin/appointments/count?${params}`);
        if (!res.ok) return;
        const data = await res.json();
        const newCount = data.count;
        const newMod   = data.maxModified ?? '';

        // 1ª chamada: só guarda o baseline
        if (!temPontoDePartida) {
          temPontoDePartida = true;
          lastKnownMod = newMod;
          lastKnownCount = newCount;
          return;
        }

        if (newCount !== lastKnownCount || newMod !== lastKnownMod) {
          // Mudou no servidor — salva scroll e recarrega
          sessionStorage.setItem('dia-scroll-y', String(window.scrollY));
          location.reload();
        }
      } catch { /* silencioso */ }
    }

    setInterval(poll, 60_000);
  })();
</script>
