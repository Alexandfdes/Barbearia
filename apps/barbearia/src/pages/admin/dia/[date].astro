---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import AgendaLista from '../../../components/admin/AgendaLista.astro';
import { getSession } from '../../../lib/session.js';
import { db } from '../../../db/index.js';
import { appointments, appointmentItems, barbers, services, timeOff, workingHours, productSales, products } from '../../../db/schema.js';
import { eq, and, gt, gte, lt, or, isNull, inArray } from 'drizzle-orm';
import { fromZonedTime, formatInTimeZone } from 'date-fns-tz';
import { waPhone } from '../../../lib/whatsapp.js';
import { computeOccupancy, pickEmptiestBand } from '../../../lib/occupancy.js';
import { tenantDaSessao } from '../../../lib/tenant.js';
import { getSettings } from '../../../lib/settings.js';
import { reais } from '../../../lib/dinheiro.js';
import { diaDaSemana, faixaDoDia, type Semana } from '../../../lib/gradeDeHorarios.js';
import type { DadosDaAgenda, ItemDaComanda } from '../../../lib/agendaDoDia.js';
import { fusoDe } from '../../../lib/timezone.js';
import { receitaDe, somaDosItens, valorDoAtendimento } from '../../../lib/valorDoAtendimento.js';


// Até 13/10/2026 morava aqui a janela fixa de 08:00 às 19:00 da linha do tempo antiga —
// que saiu da tela antes de 06/09 —, alimentando contas que a página não mostrava mais: a
// posição de cada atendimento, a linha do "agora", as linhas de hora e o clique num espaço
// vazio, com o menu que ele abria. A agenda segue o expediente de cada barbeiro
// (`lib/gradeDeHorarios.ts`; `docs/PENDENCIAS-ABERTAS.md` §2.27).

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login');
const tenant = tenantDaSessao(session);
const fuso = fusoDe(tenant);

const { date } = Astro.params;
if (!date || !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
  return Astro.redirect('/admin');
}

const barberRow = (await db.select({ id: barbers.id, name: barbers.name, role: barbers.role })
  .from(barbers).where(and(eq(barbers.id, session.barberId), eq(barbers.tenantId, tenant.id))))[0];
if (!barberRow) return Astro.redirect('/admin/login');

const barberParam = Astro.url.searchParams.get('barber');
let filterBarberId: number | null = null;
if (session.role === 'admin') {
  if (barberParam) {
    const n = parseInt(barberParam, 10);
    if (!isNaN(n)) filterBarberId = n;
  }
} else {
  filterBarberId = session.barberId;
}

const dayStart = fromZonedTime(`${date}T00:00:00`, fuso).toISOString();
const dayEnd   = fromZonedTime(`${date}T23:59:59`, fuso).toISOString();

const apptRows = (await db
  .select({
    id:                appointments.id,
    status:            appointments.status,
    startsAt:          appointments.startsAt,
    endsAt:            appointments.endsAt,
    durationMinutes:   appointments.durationMinutes,
    priceCents:        appointments.priceCents,
    customerName:      appointments.customerName,
    customerPhone:     appointments.customerPhone,
    customerBirthdate: appointments.customerBirthdate,
    notes:             appointments.notes,
    lastModifiedById:  appointments.lastModifiedById,
    lastModifiedAt:    appointments.lastModifiedAt,
    barberId:          appointments.barberId,
    barberName:        barbers.name,
    serviceName:       services.name,
  })
  .from(appointments)
  .innerJoin(barbers,  eq(barbers.id,  appointments.barberId))
  .innerJoin(services, eq(services.id, appointments.serviceId))
  .where(and(
    filterBarberId !== null
      ? and(gte(appointments.startsAt, dayStart), lt(appointments.startsAt, dayEnd), eq(appointments.barberId, filterBarberId))
      : and(gte(appointments.startsAt, dayStart), lt(appointments.startsAt, dayEnd))
  , eq(appointments.tenantId, tenant.id)))
  .orderBy(appointments.startsAt)
  );

// Os itens da comanda de cada agendamento: o produto do combo, que nasce com o
// agendamento, e os extras lançados ao fechar. Quando eles contam — na linha, no
// detalhe e na receita — é a regra de `lib/valorDoAtendimento.ts`.
const apptIds = apptRows.map(a => a.id);
const itensPorAtendimento = new Map<number, ItemDaComanda[]>();
if (apptIds.length > 0) {
  const itemRows = (await db
    .select({ appointmentId: appointmentItems.appointmentId, name: appointmentItems.name, priceCents: appointmentItems.priceCents })
    .from(appointmentItems)
    .where(and(inArray(appointmentItems.appointmentId, apptIds), eq(appointmentItems.tenantId, tenant.id)))
    .orderBy(appointmentItems.id)
    );
  for (const it of itemRows) {
    itensPorAtendimento.set(it.appointmentId, [
      ...(itensPorAtendimento.get(it.appointmentId) ?? []),
      { name: it.name, priceCents: it.priceCents },
    ]);
  }
}
const itensDe = (id: number): ItemDaComanda[] => itensPorAtendimento.get(id) ?? [];
/** O agendamento com a soma dos itens dele — o que a regra do valor pede. */
const paraOValor = (a: { id: number; status: string; priceCents: number }) =>
  ({ status: a.status, priceCents: a.priceCents, itemsCents: somaDosItens(itensDe(a.id)) });

// Vendas de produto avulsas do dia (sem agendamento) — entram no faturamento como produto.
const saleRows = (await db
  .select({
    id:         productSales.id,
    name:       productSales.name,
    quantity:   productSales.quantity,
    priceCents: productSales.priceCents,
    barberId:   productSales.barberId,
    barberName: barbers.name,
    soldAt:     productSales.soldAt,
  })
  .from(productSales)
  .innerJoin(barbers, eq(barbers.id, productSales.barberId))
  .where(and(
    filterBarberId !== null
      ? and(gte(productSales.soldAt, dayStart), lt(productSales.soldAt, dayEnd), eq(productSales.barberId, filterBarberId))
      : and(gte(productSales.soldAt, dayStart), lt(productSales.soldAt, dayEnd))
  , eq(productSales.tenantId, tenant.id)))
  .orderBy(productSales.soldAt)
  );
const salesCents = saleRows.reduce((s, r) => s + r.priceCents, 0);

// Produtos ativos (catálogo do banco) — alimentam o seletor da venda avulsa.
const productListForSale = (await db
  .select({ name: products.name, priceCents: products.priceCents })
  .from(products)
  .where(and(eq(products.active, true), eq(products.tenantId, tenant.id)))
  .orderBy(products.sortOrder, products.id)
  );

const allBarbers = session.role === 'admin'
  ? (await db.select({ id: barbers.id, name: barbers.name }).from(barbers).where(and(eq(barbers.active, true), eq(barbers.tenantId, tenant.id))))
  : [];

// Map id→nome de TODOS os barbeiros (ativos + inativos), pra mostrar quem modificou
// mesmo que tenha sido um barbeiro hoje desativado
const barberNameById = new Map<number, string>(
  (await db.select({ id: barbers.id, name: barbers.name }).from(barbers).where(eq(barbers.tenantId, tenant.id))).map(b => [b.id, b.name])
);

// Bloqueios (time_off) que tocam o dia. Filtra por barbeiro respeitando a regra:
// barber_id NULL = feriado pra todos.
const timeOffRows = (await db
  .select({
    id:       timeOff.id,
    startsAt: timeOff.startsAt,
    endsAt:   timeOff.endsAt,
    reason:   timeOff.reason,
    barberId: timeOff.barberId,
  })
  .from(timeOff)
  .where(and(
    filterBarberId !== null
      ? and(
          lt(timeOff.startsAt, dayEnd),
          gte(timeOff.endsAt, dayStart),
          or(eq(timeOff.barberId, filterBarberId), isNull(timeOff.barberId))
        )
      : and(
          lt(timeOff.startsAt, dayEnd),
          gte(timeOff.endsAt, dayStart)
        )
  , eq(timeOff.tenantId, tenant.id)))
  .orderBy(timeOff.startsAt)
  );

const nowUtc = new Date();

// Calcula tudo que a timeline precisa por agendamento
interface ApptView {
  startsAt:        string;
  id: number;
  status: string;
  durationMinutes: number;
  priceCents: number;
  customerName: string;
  customerPhone: string;
  customerPhoneDisplay: string;
  customerBirthdate: string | null;
  notes: string | null;
  lastModifiedLabel: string | null;
  barberName: string;
  barberId: number;
  serviceName: string;
  timeLocal: string;
  endTimeLocal: string;
  /** O preço do serviço agendado. */
  price: string;
  /** Quanto o atendimento vale — com os itens da comanda, se concluído (`lib/valorDoAtendimento.ts`). */
  valor: string;
  /** Telefone normalizado p/ wa.me (55+DDD+número) ou null se inválido */
  wa: string | null;
  telUrl: string;
  isPast: boolean;
  isLate: boolean;
}

interface BlockView {
  id: number;
  reason: string;
  timeLocal: string;
  endTimeLocal: string;
}

function formatPhoneDisplay(phone: string): string {
  const d = (phone ?? '').replace(/\D/g, '').slice(-11);
  if (d.length === 11) return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`;
  if (d.length === 10) return `(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`;
  return phone;
}

const apptList: ApptView[] = apptRows.map(a => {
  const time     = formatInTimeZone(new Date(a.startsAt), fuso, 'HH:mm');
  const endTime  = formatInTimeZone(new Date(a.endsAt),   fuso, 'HH:mm');
  const wa       = waPhone(a.customerPhone);
  const digits   = (a.customerPhone ?? '').replace(/\D/g, '');
  const telDigits = wa ?? (digits.startsWith('55') ? digits : `55${digits}`);

  return {
    id:              a.id,
    startsAt:        a.startsAt,
    status:          a.status,
    durationMinutes: a.durationMinutes,
    priceCents:      a.priceCents,
    customerName:    a.customerName,
    customerPhone:   a.customerPhone,
    customerPhoneDisplay: formatPhoneDisplay(a.customerPhone),
    customerBirthdate: a.customerBirthdate,
    notes:           a.notes,
    lastModifiedLabel: a.lastModifiedAt && a.lastModifiedById
      ? `${barberNameById.get(a.lastModifiedById) ?? '—'} · ${formatInTimeZone(new Date(a.lastModifiedAt), fuso, "dd/MM 'às' HH:mm")}`
      : null,
    barberName:      a.barberName,
    barberId:        a.barberId,
    serviceName:     a.serviceName,
    timeLocal:       time,
    endTimeLocal:    endTime,
    price:           reais(a.priceCents),
    valor:           reais(valorDoAtendimento(paraOValor(a))),
    wa,
    telUrl:          `tel:+${telDigits}`,
    isPast:          new Date(a.endsAt) <= nowUtc,
    isLate:          a.status === 'confirmed' && new Date(a.startsAt) < nowUtc,
  };
});

// Todo bloqueio que toca o dia aparece na lista. Até 27/09/2026 o filtro era
// `durationMin > 0` — a altura na linha do tempo fixa de 08:00 → 19:00, que nem
// existe mais na tela —, e bloqueio fora dessa janela (das 19:30 às 20:30, por
// exemplo) sumia da agenda sem aviso. O `gte` da consulta traz também o que
// termina exatamente à meia-noite em que o dia começa: esse não toca o dia.
const blockList: BlockView[] = timeOffRows
  .filter(b => new Date(b.endsAt) > new Date(dayStart))
  .map(b => {
  return {
    id:           b.id,
    reason:       b.reason ?? 'Bloqueado',
    timeLocal:    formatInTimeZone(new Date(b.startsAt), fuso, 'HH:mm'),
    endTimeLocal: formatInTimeZone(new Date(b.endsAt),   fuso, 'HH:mm'),
  };
});

// Receita do dia: o valor de cada confirmado e concluído — a soma das linhas que contam —,
// mais a venda avulsa. A regra, e por que ela mora num lugar só: `lib/valorDoAtendimento.ts`.
const receitaDoDia = receitaDe(apptRows.map(paraOValor), salesCents);
const revenueLabel = reais(receitaDoDia.centavos);
const revenueCount = receitaDoDia.considerados;

// Próximo agendamento (confirmed que ainda não acabou)
const nextAppt = apptList.find(a => a.status === 'confirmed' && !a.isPast) ?? null;

// Hoje, no fuso da barbearia.
const todayStr = formatInTimeZone(new Date(), fuso, 'yyyy-MM-dd');
const isToday  = date === todayStr;

// Day navigation
function offsetDate(d: string, days: number): string {
  const [y, mo, day] = d.split('-').map(Number);
  const dt = new Date(Date.UTC(y, mo - 1, day + days, 12));
  return dt.toISOString().slice(0, 10);
}
const prevDate = offsetDate(date, -1);
const nextDate = offsetDate(date, 1);

const MONTHS   = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const WEEKDAYS = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
const [y, m, d] = date.split('-').map(Number);
const weekday    = WEEKDAYS[diaDaSemana(date)];
const formattedDate = `${d} de ${MONTHS[m - 1]} de ${y}`;

// ─── Insight de ocupação da próxima semana (só admin, só na visão de hoje) ────
// "Terça (16/06) de manhã está 80% vazia" — empurra o dado pra onde o dono já olha.
let occupancyInsight: { text: string; pct: number } | null = null;
if (session.role === 'admin' && isToday) {
  const nextDays = Array.from({ length: 7 }, (_, i) => {
    const ds = offsetDate(todayStr, i + 1);
    const [yy, mm, dd] = ds.split('-').map(Number);
    return { dateStr: ds, weekday: new Date(Date.UTC(yy, mm - 1, dd, 12)).getUTCDay() };
  });
  const weekStartIso = fromZonedTime(`${nextDays[0].dateStr}T00:00:00`, fuso).toISOString();
  const weekEndIso   = fromZonedTime(`${nextDays[6].dateStr}T23:59:59`, fuso).toISOString();

  const whRows = (await db
    .select({ barberId: workingHours.barberId, weekday: workingHours.weekday, startTime: workingHours.startTime, endTime: workingHours.endTime })
    .from(workingHours)
    .innerJoin(barbers, eq(barbers.id, workingHours.barberId))
    .where(and(eq(barbers.active, true), eq(workingHours.tenantId, tenant.id)))
    );
  const weekAppts = (await db
    .select({ barberId: appointments.barberId, startsAt: appointments.startsAt, endsAt: appointments.endsAt })
    .from(appointments)
    .where(and(eq(appointments.status, 'confirmed'), gte(appointments.startsAt, weekStartIso), lt(appointments.startsAt, weekEndIso), eq(appointments.tenantId, tenant.id)))
    );
  const weekTimeOff = (await db
    .select({ barberId: timeOff.barberId, startsAt: timeOff.startsAt, endsAt: timeOff.endsAt })
    .from(timeOff)
    .where(and(lt(timeOff.startsAt, weekEndIso), gt(timeOff.endsAt, weekStartIso), eq(timeOff.tenantId, tenant.id)))
    );

  const occ  = computeOccupancy({ days: nextDays, workingHours: whRows, timeOff: weekTimeOff, appointments: weekAppts, tz: fuso });
  const pick = pickEmptiestBand(occ);
  if (pick) {
    const ddmm = pick.dateStr.split('-').reverse().slice(0, 2).join('/');
    occupancyInsight = {
      text: `${WEEKDAYS[pick.weekday]} (${ddmm}) ${pick.bandLabel}`,
      pct:  pick.freePct,
    };
  }
}

const filterQs = filterBarberId ? `?barber=${filterBarberId}` : '';

// Dados leves dos agendamentos pra usar no client (modal de detalhes / reschedule)
const apptsLite = apptList.map(a => ({
  id:                a.id,
  startsAt:          a.startsAt,
  status:            a.status,
  customerName:      a.customerName,
  customerPhone:     a.customerPhone,
  customerPhoneDisplay: a.customerPhoneDisplay,
  customerBirthdate: a.customerBirthdate,
  notes:             a.notes,
  lastModifiedLabel: a.lastModifiedLabel,
  serviceName:       a.serviceName,
  barberName:        a.barberName,
  barberId:          a.barberId,
  durationMinutes:   a.durationMinutes,
  priceCents:        a.priceCents,
  items:             itensDe(a.id),
  itemsCents:        somaDosItens(itensDe(a.id)),
  price:             a.price,
  timeLocal:         a.timeLocal,
  endTimeLocal:      a.endTimeLocal,
  wa:                a.wa,
  telUrl:            a.telUrl,
}));

// O expediente de verdade (`working_hours`), por barbeiro e dia da semana. Vai para
// o navegador montar a grade de "Mover horário", e dá a faixa do topo da agenda —
// as duas eram 08:00 → 19:00 fixo até 27/09/2026 (`lib/gradeDeHorarios.ts`).
const linhasDeExpediente = await db
  .select({ barberId: workingHours.barberId, weekday: workingHours.weekday, startTime: workingHours.startTime, endTime: workingHours.endTime })
  .from(workingHours)
  .where(eq(workingHours.tenantId, tenant.id));
const expediente: Record<number, Semana> = {};
for (const l of linhasDeExpediente) {
  ((expediente[l.barberId] ??= {})[l.weekday] ??= []).push({ inicio: l.startTime, fim: l.endTime });
}
const faixaDoExpediente = faixaDoDia(
  Object.entries(expediente)
    .filter(([id]) => !filterBarberId || Number(id) === filterBarberId)
    .flatMap(([, semana]) => semana[diaDaSemana(date)] ?? []),
);

const clientData: DadosDaAgenda = {
  date,
  role:              session.role,
  sessionBarberId:   session.barberId,
  filterBarberId,
  allBarbers,
  todayStr,
  appts:             apptsLite,
  salesCents,
  products:          productListForSale,
  // O fuso vai para o navegador por aqui, e não por `define:vars` — ver o
  // comentário no <script> lá embaixo.
  tz:                fuso,
  // Assina as mensagens prontas de WhatsApp (`buildWaMessages`).
  businessName:      (await getSettings(tenant)).businessName,
  expediente,
};
---

<AdminLayout title={`${weekday}, ${formattedDate}`} barberName={barberRow.name} role={session.role}>

  <div id="admin-data-container" data-client={JSON.stringify(clientData)} class="hidden"></div>

  <style is:global>
    /* Barra de rolagem discreta no tema escuro (substitui a branca do sistema) */
    .modal-scroll { scrollbar-width: thin; scrollbar-color: #3a3a3a transparent; }
    .modal-scroll::-webkit-scrollbar { width: 8px; }
    .modal-scroll::-webkit-scrollbar-track { background: transparent; }
    .modal-scroll::-webkit-scrollbar-thumb {
      background: #333; border-radius: 9999px; border: 2px solid transparent; background-clip: content-box;
    }
    .modal-scroll::-webkit-scrollbar-thumb:hover { background: #4a4a4a; background-clip: content-box; }
  </style>


  <!-- Date navigation header -->
  <div class="border-b border-slate-200 px-4 py-3">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3">
      <a href={`/admin/dia/${prevDate}${filterQs}`}
         class="text-slate-500 hover:text-slate-800 transition-colors p-2 -ml-2 rounded hover:bg-slate-100"
         aria-label="Dia anterior">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>

      <div class="relative flex items-center gap-3 min-w-0">
        <div class="text-center min-w-0">
          <p class="text-sm font-medium text-slate-800 truncate">
            {weekday}{isToday && <span class="text-teal"> · Hoje</span>}
          </p>
          <p class="text-xs text-slate-500 truncate">{formattedDate}</p>
        </div>
        <button id="cal-toggle" type="button"
                class="inline-flex items-center text-slate-500 hover:text-teal transition-colors p-1.5 rounded hover:bg-slate-100"
                aria-label="Escolher data">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </button>

        <!-- Calendário custom popover -->
        <div id="cal-popover"
             class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 z-50 bg-white border border-slate-200 rounded-lg shadow-2xl shadow-black/50 w-[300px] p-3 select-none">
          <!-- Header: mês/ano e setas -->
          <div class="flex items-center justify-between mb-3 px-1">
            <button id="cal-prev" type="button"
                    class="p-1.5 rounded text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors"
                    aria-label="Mês anterior">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <p id="cal-title" class="text-sm font-medium text-slate-900 tabular-nums">—</p>
            <button id="cal-next" type="button"
                    class="p-1.5 rounded text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors"
                    aria-label="Próximo mês">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <!-- Dias da semana -->
          <div class="grid grid-cols-7 gap-1 mb-1 px-1">
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">D</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">S</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">T</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">Q</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">Q</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">S</span>
            <span class="text-[10px] text-center text-slate-400 uppercase tracking-wider py-1">S</span>
          </div>

          <!-- Grid de dias (renderizado via JS) -->
          <div id="cal-grid" class="grid grid-cols-7 gap-1 px-1"></div>

          <!-- Footer -->
          <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-200 px-1">
            <button id="cal-today" type="button"
                    class="text-xs text-teal hover:text-teal font-medium transition-colors">
              Hoje
            </button>
            <button id="cal-close" type="button"
                    class="text-xs text-slate-500 hover:text-slate-800 transition-colors">
              Fechar
            </button>
          </div>
        </div>
      </div>

      <a href={`/admin/dia/${nextDate}${filterQs}`}
         class="text-slate-500 hover:text-slate-800 transition-colors p-2 -mr-2 rounded hover:bg-slate-100"
         aria-label="Próximo dia">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {!isToday && (
