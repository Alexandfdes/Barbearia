  // Selo de aniversário no header (compara dia/mês no fuso da barbearia).
  function setBirthdayBadge(iso: string | null | undefined) {
    if (!dmBirthday) return;
    dmBirthday.classList.add('hidden');
    dmBirthday.textContent = '';
    if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
    const [, bm, bd] = iso.split('-').map(Number);
    const agoraNaBarbearia = new Date(new Date().toLocaleString('en-US', { timeZone: TZ }));
    const tMonth = agoraNaBarbearia.getMonth() + 1, tDay = agoraNaBarbearia.getDate();
    if (bm === tMonth && bd === tDay) {
      dmBirthday.textContent = '🎂 Aniversário hoje!';
      dmBirthday.classList.remove('hidden');
    } else if (bm === tMonth) {
      dmBirthday.textContent = '🎂 Aniversário este mês';
      dmBirthday.classList.remove('hidden');
    }
  }

  // Ficha do cliente: faixa de stats agregados.
  function renderClientStats(stats: FichaDoCliente | null | undefined, total: number | undefined) {
    if (!dmStats) return;
    const brl = (c: number) => reais(c || 0);

    // Primeira visita: só existe o agendamento atual.
    if (!stats || (total ?? stats.totalCount) <= 1) {
      dmStats.className = '';
      dmStats.innerHTML = '<p class="text-xs text-teal bg-teal/10 border border-teal/20 rounded px-3 py-2">✨ Primeira visita deste cliente</p>';
      return;
    }

    const riskColor = stats.noShowRate >= 25 ? 'text-red-600'
                    : stats.noShowRate >= 10 ? 'text-amber-600'
                    : 'text-slate-800';

    let since = '';
    if (stats.firstVisitAt) {
      const d = new Date(stats.firstVisitAt);
      since = d.toLocaleDateString('pt-BR', { month: 'short', year: '2-digit', timeZone: TZ });
    }

    const cell = (label: string, value: string, cls = 'text-slate-800') => `
      <div class="bg-slate-100 border border-slate-200 rounded p-2 text-center">
        <p class="text-[9px] text-slate-500 uppercase tracking-wider">${label}</p>
        <p class="text-sm font-bold ${cls} tabular-nums mt-0.5">${value}</p>
      </div>`;

    dmStats.className = '';
    dmStats.innerHTML = `
      <div class="grid grid-cols-3 gap-2">
        ${cell('Gasto total', brl(stats.totalSpentCents), 'text-teal')}
        ${cell('Visitas', String(stats.completedCount))}
        ${cell('Faltas', `${stats.noShowCount}${stats.noShowRate ? ` · ${stats.noShowRate}%` : ''}`, riskColor)}
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-[11px] text-slate-500">
        ${stats.favoriteService ? `<span>Favorito: <span class="text-slate-700">${stats.favoriteService}</span></span>` : ''}
        ${since ? `<span>Cliente desde <span class="text-slate-700">${since}</span></span>` : ''}
      </div>`;
  }

  async function loadHistory(id: string) {
    if (!dmHistory) return;
    dmHistory.innerHTML = '<p class="text-slate-400 italic">Carregando...</p>';
    if (dmHistoryCount) dmHistoryCount.textContent = '';
    try {
      const res = await fetch(`/api/admin/appointments/${id}/history?limit=5`);
      const data = await res.json();
      if (!res.ok) {
        dmHistory.innerHTML = '<p class="text-red-600">Erro ao carregar histórico</p>';
        if (dmStats) { dmStats.className = 'text-xs text-slate-400 italic'; dmStats.textContent = ''; }
        return;
      }
      renderClientStats(data.stats, data.total);
      if (!data.history?.length) {
        dmHistory.innerHTML = '<p class="text-slate-400">Primeira visita deste cliente.</p>';
        if (dmHistoryCount) dmHistoryCount.textContent = '1 total';
        return;
      }
      if (dmHistoryCount) dmHistoryCount.textContent = `${data.total} no total`;
      dmHistory.innerHTML = data.history.map((h: VisitaDoHistorico) => {
        const d = new Date(h.startsAt);
        // O dia também no fuso da barbearia, como a hora: sem ele, o navegador usa
        // o fuso de quem abre — e um corte às 23:30 saía com a data do dia seguinte.
        const dateLabel = d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: '2-digit', timeZone: TZ });
        const timeLabel = d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
        // A visita concluída vale o serviço e os itens da comanda — como na linha da agenda.
        const price = reais(valorDoAtendimento(h));
        const statusColor = h.status === 'completed' ? 'text-teal'
                         : h.status === 'cancelled' ? 'text-red-600/70'
                         : h.status === 'no_show'   ? 'text-amber-600/80'
                         :                            'text-slate-700';
        const statusIcon = h.status === 'completed' ? '✓'
                        : h.status === 'cancelled' ? '✕'
                        : h.status === 'no_show'   ? '✗'
                        :                            '•';
        return `
          <div class="flex items-center gap-2 py-1.5 px-2 bg-slate-100/50 rounded border border-slate-200">
            <span class="${statusColor} text-xs w-3 text-center">${statusIcon}</span>
            <div class="flex-1 min-w-0">
              <p class="text-slate-700 truncate">${h.serviceName} <span class="text-slate-400">· ${h.barberName.split(' ')[0]}</span></p>
              <p class="text-slate-400 text-[10px] tabular-nums">${dateLabel} · ${timeLabel}</p>
            </div>
            <span class="text-slate-500 text-[11px] tabular-nums shrink-0">${price}</span>
          </div>
        `;
      }).join('');
    } catch {
      dmHistory.innerHTML = '<p class="text-red-600">Erro ao carregar histórico</p>';
    }
  }

  dmEditSave?.addEventListener('click', async () => {
    if (!currentApptId) return;
    const name = dmEditName.value.trim();
    const phoneDigits = dmEditPhone.value.replace(/\D/g, '');
    const birthdateIso = dmEditBirthdate.value.trim() === ''
      ? null
      : parseBirthdateInput(dmEditBirthdate.value);

    if (name.length < 2)         { dmEditStatus.textContent = 'Nome muito curto'; dmEditStatus.className = 'text-[10px] text-red-600'; return; }
    if (phoneDigits.length < 10) { dmEditStatus.textContent = 'Telefone inválido'; dmEditStatus.className = 'text-[10px] text-red-600'; return; }
    if (dmEditBirthdate.value.trim() !== '' && !birthdateIso) {
      dmEditStatus.textContent = 'Data inválida'; dmEditStatus.className = 'text-[10px] text-red-600'; return;
    }

    dmEditStatus.textContent = '';
    dmEditSave.disabled = true;
    dmEditSave.textContent = 'Salvando...';

    const { ok, data } = await callApi(`/api/admin/appointments/${currentApptId}/customer`, 'PATCH', {
      customerName:      name,
      customerPhone:     dmEditPhone.value,
      customerBirthdate: birthdateIso,
    });

    dmEditSave.disabled = false;
    dmEditSave.textContent = 'Salvar';
    if (ok) {
      editOriginal = { name: dmEditName.value, phone: dmEditPhone.value, birthdate: dmEditBirthdate.value };
      dmEditSave.classList.add('hidden');
      dmEditStatus.className = 'text-[10px] text-teal';
      dmEditStatus.textContent = data.propagated
        ? `Atualizado em ${data.updated} agendamento${data.updated > 1 ? 's' : ''}`
        : 'Atualizado';
      // Atualiza o appt no cache local + header do modal
      const appt = clientData.appts.find(a => String(a.id) === String(currentApptId));
      if (appt) {
        appt.customerName  = name;
        appt.customerPhone = dmEditPhone.value;
        appt.customerPhoneDisplay = maskPhone(dmEditPhone.value);
        // Recalcula telefone normalizado (wa.me) e tel:
        appt.wa = waPhone(phoneDigits);
        appt.telUrl = `tel:+${appt.wa ?? (phoneDigits.startsWith('55') ? phoneDigits : `55${phoneDigits}`)}`;
      }
      dmName.textContent  = name;
      dmPhone.textContent = maskPhone(dmEditPhone.value);
      dmTel.href = appt?.telUrl ?? '#';
      setWaButtonState(dmWhats, appt?.wa);
      // Atualiza data attrs do card na timeline
      const card = document.getElementById(`appt-${currentApptId}`);
      if (card) {
        card.dataset.customerName = name;
        card.dataset.phoneDisplay = maskPhone(dmEditPhone.value);
        const nameEl = card.querySelector('.flex.items-baseline span.text-sm.font-medium, .flex.items-baseline span:nth-child(2)');
        if (nameEl) nameEl.textContent = name;
      }
      toast('Cliente atualizado', 'success');
    } else {
      dmEditStatus.className = 'text-[10px] text-red-600';
      dmEditStatus.textContent = data.error ?? 'Erro';
    }
  });

  function openDetailModal(id: string) {
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (!appt) return;
    currentApptId = id;
    currentMoveSlot = null;

    // O valor, e o que ele soma: no concluído, o serviço e os itens da comanda — "Corte +
    // Barba · Zé · R$ 80" (`lib/valorDoAtendimento.ts`).
    const valor = reais(valorDoAtendimento(appt));
    const oQueSoma = [appt.serviceName, ...(itensContam(appt.status) ? appt.items : []).map(i => i.name)];
    dmName.textContent     = appt.customerName;
    dmService.textContent  = `${oQueSoma.join(' + ')} · ${appt.barberName} · ${valor}`;
    dmTime.textContent     = `${appt.timeLocal} → ${appt.endTimeLocal}`;
    dmDuration.textContent = `${appt.durationMinutes}min`;
    dmPrice.textContent    = valor;
    dmPhone.textContent    = appt.customerPhoneDisplay || '—';
    dmTel.href             = appt.telUrl;
    dmWhats.dataset.id     = String(appt.id);
    setWaButtonState(dmWhats, appt.wa);
    dmNotes.value          = appt.notes ?? '';
    notesOriginal          = dmNotes.value;
    dmNotesStatus.textContent = '';
    dmNotesSave.classList.add('hidden');

    // Edição de cliente
    dmEditName.value      = appt.customerName;
    dmEditPhone.value     = appt.customerPhoneDisplay;
    dmEditBirthdate.value = formatBirthdateDisplay(appt.customerBirthdate);
    editOriginal = { name: dmEditName.value, phone: dmEditPhone.value, birthdate: dmEditBirthdate.value };
    dmEditSave.classList.add('hidden');
    dmEditStatus.textContent = '';

    // Ficha do cliente: reseta, marca aniversário e carrega stats + histórico
    if (dmStats) { dmStats.className = 'text-xs text-slate-400 italic'; dmStats.textContent = 'Carregando…'; }
    setBirthdayBadge(appt.customerBirthdate);
    loadHistory(id);

    // Auditoria
    const auditEl = document.getElementById('dm-audit');
    const auditText = document.getElementById('dm-audit-text');
    if (appt.lastModifiedLabel) {
      auditEl?.classList.remove('hidden');
      if (auditText) auditText.textContent = appt.lastModifiedLabel;
    } else {
      auditEl?.classList.add('hidden');
    }

    [dmComplete, dmNoshow, dmCancel].forEach(b => b.dataset.id = id);

    // Mover horário: data atual default
    dmMoveDate.value = clientData.date;
    dmMoveDate.min = clientData.todayStr;
    dmMoveSlots.innerHTML = '<span class="text-slate-500">Selecione uma data acima.</span>';
    dmMoveConfirm.disabled = true;

    // Bloquear ações se status != confirmed — e, desde 26/10/2026, o que o servidor
    // recusaria nem fica clicável (`lib/fecharAtendimento.ts`): concluir só horário de
    // hoje ou de antes; falta só depois de o horário começar. O motivo fica escrito.
    const isConfirmed = appt.status === 'confirmed';
    const podeConcluir = isConfirmed && clientData.date <= clientData.todayStr;
    const podeFalta = isConfirmed && Date.parse(appt.startsAt) <= Date.now();
    const libera = (b: HTMLButtonElement, ok: boolean) => {
      b.disabled = !ok;
      b.classList.toggle('opacity-40', !ok);
      b.classList.toggle('cursor-not-allowed', !ok);
    };
    libera(dmComplete, podeConcluir);
    libera(dmNoshow, podeFalta);
    libera(dmCancel, isConfirmed);
    const motivo = document.getElementById('dm-acoes-motivo');
    if (motivo) {
      const texto = !isConfirmed ? ''
        : !podeConcluir ? 'Este horário é de outro dia: concluir e marcar falta só no dia dele.'
        : !podeFalta ? 'Falta só depois de o horário começar.'
        : '';
      motivo.textContent = texto;
      motivo.classList.toggle('hidden', !texto);
    }
    dmMoveDate.disabled = !isConfirmed;
    dmMoveConfirm.disabled = true;
    if (isConfirmed) loadMoveSlots();

    detailModal.classList.remove('hidden');
  }

