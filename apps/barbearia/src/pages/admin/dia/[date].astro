<script>
  // ⚠️ ESTE BLOCO JÁ FOI `<script define:vars={{ TZ }}>` — E A AGENDA INTEIRA PAROU.
  //
  // `define:vars` transforma o script em `is:inline`: o Astro deixa de processá-lo
  // e o navegador recebe o texto cru. Este bloco tem `import` e é TypeScript
  // (`as HTMLElement`, `!`, parâmetros tipados) — cru, nenhuma das duas coisas é
  // JavaScript válido. O navegador recusava o bloco INTEIRO ("Cannot use import
  // statement outside a module"): calendário, botões de WhatsApp, comanda, venda,
  // concluir atendimento — nada respondia. Achado em 25/09/2026 abrindo a tela
  // no navegador; nenhum teste abria. `tests/scripts-inline.test.ts` agora vigia.
  //
  // O fuso continua vindo do servidor — o navegador não enxerga variável de
  // ambiente, e cravar aqui faria a tela discordar do banco (`lib/timezone.ts`) —,
  // só que pelo mesmo caminho do resto dos dados: `clientData.tz`.
  import { waPhone, waLink, buildWaMessages } from '../../../lib/whatsapp';
  import { reais } from '../../../lib/dinheiro';
  import { fromZonedTime, formatInTimeZone } from 'date-fns-tz';
  import { diaDaSemana, horariosLivres, horariosParaMover, ocupacaoDoBarbeiro } from '../../../lib/gradeDeHorarios';
  import type { DadosDaAgenda, FichaDoCliente, VisitaDoHistorico } from '../../../lib/agendaDoDia';
  import { itensContam, receitaDe, somaDosItens, valorDoAtendimento } from '../../../lib/valorDoAtendimento';
  import { aparenciaDaSituacao, BORDAS_DA_SITUACAO, linhaApagada, nomeRiscado } from '../../../lib/situacaoNaAgenda';

  // Os tipos deste script (`as`, `!`, parâmetros) só servem ao conferidor de tipos:
  // somem no build e não mudam o que roda. Os elementos com `as` existem sempre no
  // HTML acima; os que podem faltar — o seletor de barbeiro, só do dono — ficam com
  // `| null` e a conferência no código.

  const container = document.getElementById('admin-data-container')!;
  const clientData: DadosDaAgenda = JSON.parse(container.dataset.client!);
  const { date, role, sessionBarberId, filterBarberId, allBarbers } = clientData;
  const TZ: string = clientData.tz;

  // ─── Calendário custom ──────────────────────────────────────────────────────
  (function setupCalendar() {
    const toggle  = document.getElementById('cal-toggle');
    const popover = document.getElementById('cal-popover');
    const title   = document.getElementById('cal-title');
    const grid    = document.getElementById('cal-grid');
    const prev    = document.getElementById('cal-prev');
    const next    = document.getElementById('cal-next');
    const todayBtn= document.getElementById('cal-today');
    const closeBtn= document.getElementById('cal-close');
    if (!toggle || !popover || !title || !grid || !prev || !next || !todayBtn || !closeBtn) return;

    const MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    const qs = filterBarberId ? `?barber=${filterBarberId}` : '';

    // Mês visualizado, com base na data da página
    const [py, pm] = date.split('-').map(Number);
    let viewYear  = py;
    let viewMonth = pm - 1; // 0-based

    // Hoje NA BARBEARIA (`TZ`, de `clientData.tz`) — o mesmo dia do "Agenda do
    // dia" do menu. Até 12/10/2026 era o relógio do navegador: perto da meia-noite,
    // um celular noutro fuso destacava outro dia, e o botão "Hoje" levava a ele.
    const partesDeHoje = new Intl.DateTimeFormat('en-US', {
      timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit',
    }).formatToParts(new Date());
    const parteDeHoje = (tipo: string) => Number(partesDeHoje.find((p) => p.type === tipo)?.value);
    const todayY = parteDeHoje('year');
    const todayM = parteDeHoje('month') - 1; // 0-based, como viewMonth
    const todayD = parteDeHoje('day');

    function pad(n: number) { return String(n).padStart(2, '0'); }
    function fmt(y: number, m: number, d: number) { return `${y}-${pad(m + 1)}-${pad(d)}`; }

    // Cache: "YYYY-MM" -> { "YYYY-MM-DD": qty }
    const monthCache = new Map();

    async function fetchMonth(yyyymm: string): Promise<Record<string, number>> {
      if (monthCache.has(yyyymm)) return monthCache.get(yyyymm);
      try {
        const params = new URLSearchParams({ month: yyyymm });
        if (filterBarberId) params.set('barber', String(filterBarberId));
        const res = await fetch(`/api/admin/appointments/calendar?${params}`);
        if (!res.ok) return {};
        const data = await res.json();
        const days = data.days ?? {};
        monthCache.set(yyyymm, days);
        return days;
      } catch {
        return {};
      }
    }

    // O `!` daqui para baixo: conferidos no começo de `setupCalendar` — o conferidor
    // não leva a conferência para dentro de função declarada.
    async function render() {
      title!.textContent = `${MONTHS[viewMonth]} ${viewYear}`;
      grid!.innerHTML = '';

      const startDow     = diaDaSemana(`${viewYear}-${pad(viewMonth + 1)}-01`); // 0 = domingo
      const daysInMonth  = new Date(viewYear, viewMonth + 1, 0).getDate();
      const daysInPrev   = new Date(viewYear, viewMonth, 0).getDate();

      // Busca contagem em paralelo: mês atual + adjacentes (pros dias de overflow)
      const ymCur  = `${viewYear}-${pad(viewMonth + 1)}`;
      const prevM  = viewMonth === 0 ? 11 : viewMonth - 1;
      const prevY  = viewMonth === 0 ? viewYear - 1 : viewYear;
      const nextM  = viewMonth === 11 ? 0 : viewMonth + 1;
      const nextY  = viewMonth === 11 ? viewYear + 1 : viewYear;
      const ymPrev = `${prevY}-${pad(prevM + 1)}`;
      const ymNext = `${nextY}-${pad(nextM + 1)}`;

      const [daysCur, daysPrev, daysNext] = await Promise.all([
        fetchMonth(ymCur), fetchMonth(ymPrev), fetchMonth(ymNext),
      ]);
      const allDays = { ...daysPrev, ...daysCur, ...daysNext };

      // Total de células: sempre 6 linhas pra altura consistente
      const totalCells = 42;
      for (let i = 0; i < totalCells; i++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'relative aspect-square text-xs rounded flex flex-col items-center justify-center tabular-nums transition-colors';

        let cellY, cellM, cellD;
        let inMonth = true;

        if (i < startDow) {
          cellD = daysInPrev - (startDow - 1 - i);
          cellM = prevM;
          cellY = prevY;
          inMonth = false;
        } else if (i >= startDow + daysInMonth) {
          cellD = i - (startDow + daysInMonth) + 1;
          cellM = nextM;
          cellY = nextY;
          inMonth = false;
        } else {
          cellD = i - startDow + 1;
          cellM = viewMonth;
          cellY = viewYear;
        }

        const dateStr = fmt(cellY, cellM, cellD);
        cell.dataset.date = dateStr;

        const isToday    = cellY === todayY && cellM === todayM && cellD === todayD;
        const isSelected = dateStr === date;
        const isSunday   = (i % 7) === 0;
        const qty        = allDays[dateStr] ?? 0;

        // Número do dia
        const num = document.createElement('span');
        num.textContent = String(cellD);
        cell.appendChild(num);

        // Ponto indicador
        if (qty > 0) {
          const dot = document.createElement('span');
          dot.className = 'absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full';
          // Cor depende do estado da célula pra contrastar
          if (isSelected) {
            dot.className += ' bg-white';
          } else if (!inMonth) {
            dot.className += ' bg-teal/40';
          } else {
            dot.className += ' bg-teal-light';
          }
          cell.appendChild(dot);
          cell.title = `${qty} agendamento${qty > 1 ? 's' : ''}`;
        }

        if (isSelected) {
          cell.className += ' bg-teal text-white font-bold ring-2 ring-teal/30';
        } else if (isToday) {
          cell.className += ' border border-teal/50 text-teal font-semibold hover:bg-teal/10';
        } else if (!inMonth) {
          cell.className += ' text-slate-300 hover:bg-slate-100';
        } else if (isSunday) {
          cell.className += ' text-slate-500 hover:bg-slate-100';
        } else {
          cell.className += ' text-slate-700 hover:bg-white/10';
        }

        cell.addEventListener('click', () => {
          location.href = `/admin/dia/${dateStr}${qs}`;
        });

        grid!.appendChild(cell);
      }
    }

    function open() {
      popover!.classList.remove('hidden');
      render();
    }
    function close() {
      popover!.classList.add('hidden');
    }
    function toggleOpen() {
      popover!.classList.contains('hidden') ? open() : close();
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleOpen();
    });
    closeBtn.addEventListener('click', close);

    prev.addEventListener('click', () => {
      if (viewMonth === 0) { viewMonth = 11; viewYear--; } else viewMonth--;
      render();
    });
    next.addEventListener('click', () => {
      if (viewMonth === 11) { viewMonth = 0; viewYear++; } else viewMonth++;
      render();
    });
    todayBtn.addEventListener('click', () => {
      location.href = `/admin/dia/${fmt(todayY, todayM, todayD)}${qs}`;
    });

    // Fecha ao clicar fora
    document.addEventListener('click', (e) => {
      if (popover.classList.contains('hidden')) return;
      if (popover.contains(e.target as Node) || toggle.contains(e.target as Node)) return;
      close();
    });
    // ESC fecha
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popover.classList.contains('hidden')) close();
    });
  })();

  // ─── Helpers ────────────────────────────────────────────────────────────────
  // Hora local da barbearia → instante UTC, pelo fuso que vem do servidor
  // (`clientData.tz`). Até 27/09/2026 esta conta somava 3 horas à mão: Fortaleza
  // cravada no código que roda no celular do dono (`PENDENCIAS-ABERTAS.md` §2.11).
  function localTimeToUtcIso(dateStr: string, timeStr: string) {
    return fromZonedTime(`${dateStr}T${timeStr}:00`, TZ).toISOString();
  }

  async function callApi(endpoint: string, method = 'POST', body: unknown = undefined) {
    const res = await fetch(endpoint, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    return { ok: res.ok, data: await res.json() };
  }

  // ─── Toast ──────────────────────────────────────────────────────────────────
  function toast(msg: string, kind = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const el = document.createElement('div');
    const color = kind === 'error'   ? 'border-red-500/30 bg-red-600 text-white'
               : kind === 'success' ? 'border-teal/30 bg-teal/15 text-teal'
               :                       'border-slate-200 bg-white text-slate-800';
    el.className = `pointer-events-auto px-4 py-2.5 rounded-md border backdrop-blur-sm text-sm shadow-lg transition-all duration-300 ${color}`;
    el.textContent = msg;
    el.style.opacity = '0';
    el.style.transform = 'translateY(8px)';
    container.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; });
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      setTimeout(() => el.remove(), 300);
    }, 3000);
  }

  // ─── Modal de confirmação ──────────────────────────────────────────────────
  const confirmModal = document.getElementById('confirm-modal');
  const confirmTitle = document.getElementById('confirm-title') as HTMLElement;
  const confirmMsg   = document.getElementById('confirm-message') as HTMLElement;
  const confirmOk    = document.getElementById('confirm-ok') as HTMLButtonElement;
  const confirmCancel= document.getElementById('confirm-cancel');
  let confirmResolve: ((resultado: boolean) => void) | null = null;

  function showConfirm(opts: { title?: string; message?: string; okLabel?: string; danger?: boolean }): Promise<boolean> {
    if (!confirmModal) return Promise.resolve(false);
    confirmTitle.textContent = opts.title ?? 'Confirmar?';
    confirmMsg.textContent   = opts.message ?? '';
    confirmOk.textContent    = opts.okLabel ?? 'Confirmar';
    confirmOk.className = `px-4 py-2 rounded text-sm font-bold text-white ${opts.danger === false ? 'bg-teal hover:bg-teal-hover' : 'bg-red-600 hover:bg-red-700'} transition-colors`;
    confirmModal.classList.remove('hidden');
    return new Promise((resolve) => { confirmResolve = resolve; });
  }
  function closeConfirm(result: boolean) {
    confirmModal?.classList.add('hidden');
    if (confirmResolve) { confirmResolve(result); confirmResolve = null; }
  }
  confirmOk?.addEventListener('click',     () => closeConfirm(true));
  confirmCancel?.addEventListener('click', () => closeConfirm(false));
  confirmModal?.addEventListener('click',  (e) => { if (e.target === confirmModal) closeConfirm(false); });

  // ─── Atualização local sem reload ───────────────────────────────────────────
  function updateApptCardStatus(id: string, newStatus: string) {
    // Atualiza o cache local primeiro (receita e modal usam isso)
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (appt) appt.status = newStatus;

    // Refaz a linha (AgendaLista) sem recarregar, igual à da página recarregada: a borda,
    // a hora e o nome apagados, o valor e o rótulo (`lib/situacaoNaAgenda.ts`). Até
    // 15/10/2026 a borda e a hora ficavam como estavam — o atendimento atrasado, concluído,
    // continuava com a borda vermelha do "Atrasado".
    const row = document.querySelector(`[data-list-appt="${id}"]`);
    if (row) {
      const st = aparenciaDaSituacao(newStatus);
      const apagada = linhaApagada(newStatus);
      row.classList.remove(...BORDAS_DA_SITUACAO);
      row.classList.add(st.borda);
      row.classList.toggle('opacity-70', apagada);
      const horaEl = row.querySelector('[data-list-hora]');
      if (horaEl) {
        horaEl.classList.toggle('text-slate-500', apagada);
        horaEl.classList.toggle('text-slate-900', !apagada);
      }
      const nameEl = row.querySelector('[data-list-nome]');
      if (nameEl) {
        nameEl.classList.toggle('text-slate-900', !apagada);
        nameEl.classList.toggle('text-slate-500', apagada);
        const riscado = nomeRiscado(newStatus);
        for (const c of ['line-through', 'decoration-1']) nameEl.classList.toggle(c, riscado);
      }
      const priceEl = row.querySelector('[data-list-valor]');
      if (priceEl) {
        priceEl.classList.toggle('text-teal', !apagada);
        priceEl.classList.toggle('text-slate-400', apagada);
        // O concluído passa a valer o serviço e os itens da comanda (`lib/valorDoAtendimento.ts`).
        if (appt) priceEl.textContent = reais(valorDoAtendimento(appt));
      }
      const badge = row.querySelector('[data-list-status]');
      if (badge) {
        badge.textContent = st.rotulo;
        badge.className = `text-[10px] tabular-nums ${st.classe}`.trim();
      }
    }

    recalculateRevenue();
  }

  function recalculateRevenue() {
    // A mesma conta do servidor: o valor de cada confirmado e concluído, mais a venda
    // avulsa — que não entra no contador de agendamentos (`lib/valorDoAtendimento.ts`).
    const { centavos: total, considerados: count } = receitaDe(clientData.appts, clientData.salesCents || 0);
    const rev = document.querySelector('section [class*="text-teal"][class*="text-3xl"]');
    if (rev) rev.textContent = reais(total);
    const countEl = document.querySelector('section .text-xs.text-slate-500.mt-0\\.5');
    if (countEl) countEl.textContent = `${count} ${count === 1 ? 'agendamento considerado' : 'agendamentos considerados'} (confirmados + concluídos)`;
  }

  // ─── Action buttons ─────────────────────────────────────────────────────────
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
    if (!btn) return;
    if (btn.hasAttribute('data-no-card-click')) return;

    const action = btn.dataset.action;
    const id     = btn.dataset.id;
    if (!id) return;

    if (action === 'open-detail') {
      e.preventDefault();
      e.stopPropagation();
      openDetailModal(id);
      return;
    }

    if (action === 'wa-menu') {
      e.preventDefault();
      e.stopPropagation();
      openWaMenu(id);
      return;
    }

    if (action === 'complete') {
      e.preventDefault();
      e.stopPropagation();
      openComanda(id);
      return;
    }

    if (action === 'no-show') {
      // Falta não volta atrás e libera o horário: pede confirmação, como o cancelar.
      const confirmado = await showConfirm({
        title:   'Marcar como falta?',
        message: 'O cliente não veio. O horário fica livre e isto não pode ser desfeito.',
        okLabel: 'Sim, faltou',
      });
      if (!confirmado) return;
      btn.disabled = true;
      const { ok, data } = await callApi(`/api/admin/appointments/${id}/no-show`);
      if (ok) {
        updateApptCardStatus(id, 'no_show');
        closeDetail();
        toast('Marcado como no-show', 'success');
      } else {
        toast(data.error ?? 'Erro', 'error');
        btn.disabled = false;
      }

    } else if (action === 'cancel') {
      const confirmed = await showConfirm({
        title:   'Cancelar agendamento?',
        message: 'O cliente será notificado se acessar o link novamente. Esta ação não pode ser desfeita.',
        okLabel: 'Sim, cancelar',
      });
      if (!confirmed) return;
      btn.disabled = true;
      const { ok, data } = await callApi(`/api/admin/appointments/${id}/cancel`);
      if (ok) {
        updateApptCardStatus(id, 'cancelled');
        closeDetail();
        toast('Agendamento cancelado', 'success');
      } else {
        toast(data.error ?? 'Erro', 'error');
        btn.disabled = false;
      }
    }
  });

