---
export const prerender = false;
import '../../styles/global.css';
import { getSession } from '../../lib/session.js';

const session = await getSession(Astro.request);
if (session) return Astro.redirect('/admin');
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Entrar — Barbearia no Ar</title>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm">

      <div class="text-center mb-8">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Barbearia no Ar</p>
        <h1 class="font-serif text-2xl font-medium text-slate-900">Painel</h1>
      </div>

      <form id="login-form" class="bg-white border border-slate-200 rounded-md p-6 space-y-4">
        <div>
          <!--
            "Seu WhatsApp" e não "Telefone", decidido em 14/09/2026.

            A chave de login é o telefone desde 09/09 (`PENDENCIAS-ABERTAS.md` §1.5), e
            está certa: é única no mundo e não muda por acidente, ao contrário do nome
            da barbearia, que o próprio dono edita no painel.

            O que estava errado era a palavra. Ninguém pensa "meu login é um telefone" —
            mas todo barbeiro sabe de cor o número do WhatsApp dele, porque atende por
            ele o dia inteiro. É o mesmo campo; muda de "identificador que preciso
            lembrar" para "o número que eu já uso".

            ⚠️ O que NÃO se faz aqui: mostrar o nome da barbearia enquanto ele digita.
            Isso exigiria o servidor responder "de quem é este número" a quem ainda não
            provou ser ninguém — um oráculo para varrer telefones e descobrir quem é dono
            de qual barbearia. O nome aparece no painel, um passo depois, de graça.
          -->
          <label for="identificador" class="block text-xs text-slate-500 uppercase tracking-widest mb-2">
            Seu WhatsApp
          </label>
          <input
            id="identificador"
            type="tel"
            inputmode="tel"
            placeholder="(84) 99999-0000"
            autocomplete="tel"
            autofocus
            class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-teal/50 transition-colors"
          />
          <p class="mt-1.5 text-[11px] text-slate-400">
            O mesmo número que você passou quando a barbearia entrou no ar.
          </p>
        </div>

        <div>
          <label for="password" class="block text-xs text-slate-500 uppercase tracking-widest mb-2">
            Senha
          </label>
          <div class="relative">
            <input
              id="password"
              type="password"
              autocomplete="current-password"
              class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2.5 pr-11 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-teal/50 transition-colors"
            />
            <button
              type="button"
              id="toggle-password"
              aria-label="Mostrar senha"
              aria-pressed="false"
              class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-500 hover:text-slate-800 focus:outline-none focus:text-slate-800 transition-colors"
            >
              <svg id="icon-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg id="icon-eye-off" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.88 9.88a3 3 0 0 0 4.24 4.24" />
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                <line x1="2" x2="22" y1="2" y2="22" />
              </svg>
            </button>
          </div>
        </div>

        <div id="login-error" class="hidden text-red-600 text-sm text-center py-1"></div>

        <button
          type="submit"
          id="login-btn"
          class="w-full bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest px-6 py-3 rounded transition-colors duration-300 text-sm"
        >
          Entrar
        </button>
      </form>

    </div>

    <script>
      const form     = document.getElementById('login-form') as HTMLFormElement;
      const identEl  = document.getElementById('identificador') as HTMLInputElement;
      const passEl   = document.getElementById('password') as HTMLInputElement;
      const errorEl  = document.getElementById('login-error') as HTMLDivElement;
      const btnEl    = document.getElementById('login-btn') as HTMLButtonElement;
      const toggleEl = document.getElementById('toggle-password') as HTMLButtonElement;
      const iconEye    = document.getElementById('icon-eye') as unknown as SVGElement;
      const iconEyeOff = document.getElementById('icon-eye-off') as unknown as SVGElement;

      toggleEl.addEventListener('click', () => {
        const show = passEl.type === 'password';
        passEl.type = show ? 'text' : 'password';
        iconEye.classList.toggle('hidden', show);
        iconEyeOff.classList.toggle('hidden', !show);
        toggleEl.setAttribute('aria-pressed', String(show));
        toggleEl.setAttribute('aria-label', show ? 'Ocultar senha' : 'Mostrar senha');
        passEl.focus();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
        btnEl.textContent   = 'Entrando...';
        btnEl.disabled      = true;

        try {
          const res = await fetch('/api/auth/login', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ identificador: identEl.value.trim(), password: passEl.value }),
          });

          if (res.ok) {
            location.href = '/admin';
            return;
          }

          const data = await res.json();
          errorEl.textContent = data.error ?? 'Erro ao fazer login';
          errorEl.classList.remove('hidden');
        } catch {
          errorEl.textContent = 'Erro de conexão. Tente novamente.';
          errorEl.classList.remove('hidden');
        }

        btnEl.textContent = 'Entrar';
        btnEl.disabled    = false;
      });
    </script>
  </body>
</html>
