---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../lib/session.js';
import { db } from '../../db/index.js';
import { barbers, barberServices, services } from '../../db/schema.js';
import { and, eq } from 'drizzle-orm';
import { tenantDaSessao } from '../../lib/tenant.js';
import { reais } from '../../lib/dinheiro.js';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login');
const tenant = tenantDaSessao(session);

const barberRow = (await db.select({ id: barbers.id, name: barbers.name, role: barbers.role })
  .from(barbers).where(and(eq(barbers.id, session.barberId), eq(barbers.tenantId, tenant.id))))[0];
if (!barberRow) return Astro.redirect('/admin/login');

const isAdmin = session.role === 'admin';

// Serviços do catálogo + a configuração deste barbeiro (toggle + duração).
// Admin vê também os inativos (para reativar); barbeiro vê só os ativos.
// Nos dois casos, só os desta barbearia — fora do ramo, para nenhum esquecê-lo.
const filtroServicos = and(
  eq(services.tenantId, tenant.id),
  isAdmin ? undefined : eq(services.active, true),
);

const baseSelect = db
  .select({
    id:           services.id,
    name:         services.name,
    priceCents:   services.priceCents,
    globalActive: services.active,
    bsActive:     barberServices.active,
    bsDuration:   barberServices.durationMinutes,
  })
  .from(services)
  .leftJoin(barberServices, and(
    eq(barberServices.serviceId, services.id),
    eq(barberServices.barberId,  session.barberId),
  ))
  .where(filtroServicos);

const rows = await baseSelect.orderBy(services.name);

const svcList = rows.map(r => ({
  id:           r.id,
  name:         r.name,
  // Com os centavos: `Math.floor` aqui apagava os 90 de R$ 39,90 ao salvar.
  priceNum:     (r.priceCents / 100).toFixed(2),
  price:        reais(r.priceCents),
  globalActive: r.globalActive,
  active:       r.bsActive ?? false,
  duration:     r.bsDuration ?? 30,
}));

const activeCount   = svcList.filter(s => s.globalActive).length;
const inactiveCount = svcList.length - activeCount;
---

<AdminLayout title="Serviços" barberName={barberRow.name} role={session.role}>
  <main class="max-w-3xl mx-auto px-4 py-6">

    <div class="flex items-center justify-between mb-6 gap-3">
      <div>
        <h1 class="text-lg font-medium text-slate-900">{isAdmin ? 'Serviços' : 'Meus Serviços'}</h1>
        <p class="text-sm text-slate-500 mt-1">
          {isAdmin
            ? `Configure o que você oferece. Como admin, também gerencia o catálogo (${activeCount} ativos · ${inactiveCount} inativos).`
            : 'Configure quais serviços você oferece e a duração de cada um.'}
        </p>
      </div>

      {isAdmin && (
        <button id="btn-new-svc"
          class="shrink-0 flex items-center gap-2 text-xs px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest rounded transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          Novo
        </button>
      )}
    </div>

    {isAdmin && (
      <div id="form-new" class="hidden bg-white border border-teal/20 rounded-md p-4 mb-4 space-y-3">
        <p class="text-sm font-medium text-slate-800">Novo serviço</p>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Nome</label>
            <input id="new-name" type="text" placeholder="ex: Progressiva"
              class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-teal/50" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Preço (R$)</label>
            <input id="new-price" type="number" min="0" step="0.01" placeholder="0"
              class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-teal/50" />
          </div>
        </div>
        <div id="new-error" class="hidden text-red-600 text-xs"></div>
        <div class="flex gap-2">
          <button id="new-submit"
            class="flex-1 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest py-2.5 rounded transition-colors text-xs">
            Criar serviço
          </button>
          <button id="new-cancel"
            class="px-4 border border-slate-200 text-slate-500 hover:text-slate-800 rounded transition-colors text-xs">
            Cancelar
          </button>
        </div>
      </div>
    )}

    {isAdmin && svcList.length === 0 && (
      <div class="bg-white border border-slate-200 rounded-md px-5 py-6 mb-4">
        <h2 class="text-sm font-medium text-slate-900">Sua lista de serviços está vazia</h2>
        <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
          Enquanto não houver serviço cadastrado, <strong>o site não recebe agendamento</strong>
          e a seção de serviços nem aparece. Comece pelo catálogo sugerido e ajuste: apague o
          que você não faz, renomeie o resto.
        </p>
        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
          Eles entram <strong>desligados e sem preço</strong> — de propósito. Preço de corte
          muda de bairro para bairro, e um valor sugerido que passa despercebido vira o preço
          no seu site. Digite o seu e ligue o serviço.
        </p>
        <button id="btn-catalogo"
          class="mt-4 inline-flex items-center gap-2 text-xs px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest rounded transition-colors">
          Usar catálogo sugerido
        </button>
        <p id="catalogo-erro" class="hidden mt-3 text-[11px] text-red-700 bg-red-50 border border-red-200 rounded px-3 py-2"></p>
      </div>
    )}

    <div class="space-y-2" id="services-list">
      {svcList.map(svc => (
        <div data-svc-id={String(svc.id)} class:list={[
          'bg-white border rounded-md',
          svc.globalActive ? 'border-slate-200' : 'border-white/[0.03] opacity-60'
        ]}>

          {svc.globalActive ? (
            <div class="flex items-center gap-3 flex-wrap px-4 py-3">

              <button
                data-toggle={String(svc.id)}
                data-active={String(svc.active)}
                class:list={[
                  'relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border-2 border-transparent transition-colors',
                  svc.active ? 'bg-teal' : 'bg-slate-200'
                ]}
                aria-label="Toggle serviço"
              >
                <span class:list={[
                  'pointer-events-none inline-block h-4 w-4 rounded-full bg-white shadow transition-transform',
                  svc.active ? 'translate-x-5' : 'translate-x-0.5'
                ]} />
              </button>

              <div class="flex-1 min-w-0">
                <p class:list={['text-sm font-medium', svc.active ? 'text-slate-900' : 'text-slate-500']}>
                  {svc.name}
                </p>
                <p class="text-xs text-slate-400">{svc.price}</p>
              </div>

              <div class:list={['flex items-center gap-1.5 transition-opacity', !svc.active && 'opacity-30']}>
                <input
                  data-duration={String(svc.id)}
                  type="number"
                  min="5" max="480" step="5"
                  value={svc.duration}
                  disabled={!svc.active}
                  class="w-16 bg-slate-100 border border-slate-200 rounded px-2 py-1 text-xs text-slate-800 text-center focus:outline-none focus:border-teal/50 disabled:cursor-not-allowed"
                />
                <span class="text-xs text-slate-400">min</span>
              </div>

              <button
                data-save={String(svc.id)}
                class="text-xs px-3 py-1.5 border border-slate-200 hover:border-teal/30 text-slate-500 hover:text-teal rounded transition-colors"
              >
                Salvar
              </button>

              <span data-feedback={String(svc.id)} class="text-xs text-slate-400 hidden"></span>
            </div>
          ) : (
            <div class="flex items-center gap-3 px-4 py-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-500">{svc.name}</p>
                <p class="text-xs text-slate-400">
                  {svc.price}<span class="ml-2 text-slate-300">· inativo no catálogo</span>
                </p>
              </div>
            </div>
          )}

          {isAdmin && (
            <div class="flex items-center justify-between gap-2 px-4 py-2 border-t border-slate-200">
              <span class="text-[11px] uppercase tracking-widest text-slate-400">Catálogo</span>
              <div class="flex items-center gap-2 shrink-0">
                <button data-edit={String(svc.id)}
                  class="text-xs text-slate-500 hover:text-slate-700 px-2 py-1 border border-slate-200 hover:border-slate-300 rounded transition-colors">
                  Editar
                </button>
                <button data-toggle-active={String(svc.id)} data-current-active={String(svc.globalActive)}
                  class:list={[
                    'text-xs px-2 py-1 border rounded transition-colors',
                    svc.globalActive
                      ? 'border-red-500/20 text-red-600/70 hover:border-red-500/40 hover:text-red-600'
                      : 'border-teal/20 text-teal/70 hover:border-teal/40 hover:text-teal'
                  ]}>
                  {svc.globalActive ? 'Desativar' : 'Ativar'}
                </button>
              </div>
            </div>
          )}

          {isAdmin && (
            <div data-edit-form={String(svc.id)} class="hidden px-4 pb-4 pt-3 space-y-3 border-t border-slate-200">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Nome</label>
                  <input data-edit-name={String(svc.id)} type="text" value={svc.name}
                    class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50" />
                </div>
                <div>
                  <label class="block text-xs text-slate-500 uppercase tracking-widest mb-1.5">Preço (R$)</label>
                  <input data-edit-price={String(svc.id)} type="number" min="0" step="0.01"
                    value={svc.priceNum}
                    class="w-full bg-slate-100 border border-slate-200 rounded px-3 py-2 text-sm text-slate-800 focus:outline-none focus:border-teal/50" />
                </div>
              </div>
              <div class="flex gap-2">
                <button data-edit-save={String(svc.id)}
                  class="flex-1 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest py-2 rounded transition-colors text-xs">
                  Salvar
                </button>
                <button data-edit-close={String(svc.id)}
                  class="px-4 border border-slate-200 text-slate-500 hover:text-slate-800 rounded transition-colors text-xs">
                  Cancelar
                </button>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

  </main>
</AdminLayout>

<script>
  // Catálogo sugerido (`PENDENCIAS-ABERTAS.md` §4.5). O botão só existe quando a
  // lista está vazia — o endpoint recusa em lista não vazia de qualquer jeito,
  // mas botão que só serve para levar erro não deveria aparecer.
  const btnCatalogo = document.getElementById('btn-catalogo') as HTMLButtonElement | null;
  const erroCatalogo = document.getElementById('catalogo-erro');

  btnCatalogo?.addEventListener('click', async () => {
    btnCatalogo.disabled = true;
    btnCatalogo.textContent = 'Criando...';
    erroCatalogo?.classList.add('hidden');

    try {
      const r = await fetch('/api/admin/services/catalogo-sugerido', { method: 'POST' });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error ?? 'Não deu para criar o catálogo.');
      location.reload();
    } catch (e) {
      if (erroCatalogo) {
        erroCatalogo.textContent = e instanceof Error ? e.message : String(e);
        erroCatalogo.classList.remove('hidden');
      }
      btnCatalogo.disabled = false;
      btnCatalogo.textContent = 'Usar catálogo sugerido';
    }
  });
</script>


<script>
  import { centavosDoCampo } from '../../lib/dinheiro';
  // ── Configuração do barbeiro (toggle "eu ofereço" + duração) ────────────────
  const list = document.getElementById('services-list')!;

  async function saveService(id: string) {
    const toggleBtn  = document.querySelector<HTMLButtonElement>(`[data-toggle="${id}"]`);
    const durationEl = document.querySelector<HTMLInputElement>(`[data-duration="${id}"]`);
    const feedbackEl = document.querySelector<HTMLSpanElement>(`[data-feedback="${id}"]`);
    const saveBtn    = document.querySelector<HTMLButtonElement>(`[data-save="${id}"]`);

    if (!toggleBtn || !feedbackEl) return;

    const active   = toggleBtn.dataset.active === 'true';
    const duration = parseInt(durationEl?.value ?? '30', 10);

    if (saveBtn) { saveBtn.textContent = '...'; saveBtn.disabled = true; }

    try {
      const res = await fetch(`/api/admin/barber-services/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ active, durationMinutes: duration }),
      });

      feedbackEl.textContent = res.ok ? '✓ Salvo' : '✕ Erro';
      feedbackEl.className   = `text-xs ${res.ok ? 'text-teal' : 'text-red-600'}`;
      feedbackEl.classList.remove('hidden');
      setTimeout(() => feedbackEl.classList.add('hidden'), 2000);
    } catch {
      feedbackEl.textContent = '✕ Erro de conexão';
      feedbackEl.className   = 'text-xs text-red-600';
      feedbackEl.classList.remove('hidden');
    }

    if (saveBtn) { saveBtn.textContent = 'Salvar'; saveBtn.disabled = false; }
  }

  list.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Toggle "eu ofereço"
    const toggleBtn = target.closest<HTMLButtonElement>('[data-toggle]');
    if (toggleBtn) {
      const id        = toggleBtn.dataset.toggle!;
      const wasActive = toggleBtn.dataset.active === 'true';
      const nowActive = !wasActive;

      toggleBtn.dataset.active = String(nowActive);
      toggleBtn.classList.toggle('bg-teal',        nowActive);
      toggleBtn.classList.toggle('bg-slate-200', !nowActive);

      const thumb = toggleBtn.querySelector('span');
      thumb?.classList.toggle('translate-x-5',   nowActive);
      thumb?.classList.toggle('translate-x-0.5', !nowActive);

      const durationEl   = document.querySelector<HTMLInputElement>(`[data-duration="${id}"]`);
      const durationWrap = durationEl?.parentElement;
      if (durationEl) durationEl.disabled = !nowActive;
      durationWrap?.classList.toggle('opacity-30', !nowActive);

      const nameEl = document.querySelector(`[data-svc-id="${id}"] .flex-1 p`);
      nameEl?.classList.toggle('text-slate-900', nowActive);
      nameEl?.classList.toggle('text-slate-500', !nowActive);
      return;
    }

    // Salvar config do barbeiro
    const saveBtn = target.closest<HTMLButtonElement>('[data-save]');
    if (saveBtn) { saveService(saveBtn.dataset.save!); return; }

    // ── Ações de catálogo (somente admin) ─────────────────────────────────────

    // Abrir form de edição
    const editBtn = target.closest<HTMLButtonElement>('[data-edit]');
    if (editBtn) {
      const id = editBtn.dataset.edit!;
      document.querySelector(`[data-edit-form="${id}"]`)?.classList.remove('hidden');
      return;
    }

    // Fechar form de edição
    const closeBtn = target.closest<HTMLButtonElement>('[data-edit-close]');
    if (closeBtn) {
      const id = closeBtn.dataset.editClose!;
      document.querySelector(`[data-edit-form="${id}"]`)?.classList.add('hidden');
      return;
    }

    // Salvar edição (nome/preço no catálogo global)
    const editSaveBtn = target.closest<HTMLButtonElement>('[data-edit-save]');
    if (editSaveBtn) {
      const id      = editSaveBtn.dataset.editSave!;
      const nameEl  = document.querySelector<HTMLInputElement>(`[data-edit-name="${id}"]`)!;
      const priceEl = document.querySelector<HTMLInputElement>(`[data-edit-price="${id}"]`)!;

      editSaveBtn.disabled = true; editSaveBtn.textContent = '...';

      const res = await fetch(`/api/admin/services/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameEl.value.trim(), priceCents: centavosDoCampo(priceEl.value) }),
      });

      if (res.ok) { location.reload(); }
      else { editSaveBtn.disabled = false; editSaveBtn.textContent = 'Salvar'; alert('Erro ao salvar'); }
      return;
    }

    // Ativar / Desativar no catálogo global (afeta toda a barbearia)
    const toggleActiveBtn = target.closest<HTMLButtonElement>('[data-toggle-active]');
    if (toggleActiveBtn) {
      const id       = toggleActiveBtn.dataset.toggleActive!;
      const isActive = toggleActiveBtn.dataset.currentActive === 'true';

      if (isActive && !confirm('Desativar este serviço para TODA a barbearia? Ele deixará de aparecer no site e no agendamento de todos os barbeiros.')) {
        return;
      }

      toggleActiveBtn.disabled = true;

      const res = isActive
        ? await fetch(`/api/admin/services/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } })
        : await fetch(`/api/admin/services/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active: true }) });

      if (res.ok) { location.reload(); }
      else { toggleActiveBtn.disabled = false; alert('Erro'); }
      return;
    }
  });

  // ── Novo serviço (admin) ────────────────────────────────────────────────────
  const formNew = document.getElementById('form-new');
  document.getElementById('btn-new-svc')?.addEventListener('click', () => formNew?.classList.toggle('hidden'));
  document.getElementById('new-cancel')?.addEventListener('click', () => formNew?.classList.add('hidden'));

  document.getElementById('new-submit')?.addEventListener('click', async () => {
    const nameEl  = document.getElementById('new-name')  as HTMLInputElement;
    const priceEl = document.getElementById('new-price') as HTMLInputElement;
    const errorEl = document.getElementById('new-error') as HTMLElement;
    const btn     = document.getElementById('new-submit') as HTMLButtonElement;

    errorEl.classList.add('hidden');
    const name  = nameEl.value.trim();
    const priceCents = centavosDoCampo(priceEl.value);

    if (!name)                                { errorEl.textContent = 'Informe o nome';   errorEl.classList.remove('hidden'); return; }
    if (isNaN(priceCents) || priceCents <= 0) { errorEl.textContent = 'Preço inválido';   errorEl.classList.remove('hidden'); return; }

    btn.disabled = true; btn.textContent = 'Criando...';

    const res  = await fetch('/api/admin/services', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, priceCents }),
    });
    const data = await res.json();

    if (res.ok) { location.reload(); }
    else { errorEl.textContent = data.error ?? 'Erro'; errorEl.classList.remove('hidden'); btn.disabled = false; btn.textContent = 'Criar serviço'; }
  });
</script>
