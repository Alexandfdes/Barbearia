# Segredo da sessão — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-de-32-chars

# Banco: Postgres. A URL inteira, com usuário, senha, host, porta e nome.
# Em produção, um usuário DONO das tabelas, não o superusuário: a troca é o
# `node scripts/usuario-do-app.mjs`, que lê a URL nova de DATABASE_URL_APP só durante
# a troca (docs/PENDENCIAS-ABERTAS.md §3.10).
DATABASE_URL=postgres://usuario:senha@host:5432/barbearia
# DATABASE_POOL_MAX=10            (conexões reservadas pelas requisições das barbearias; default 10)
# DATABASE_POOL_DONO_MAX=5        (conexões do dono das tabelas: login, roteamento, cobrança; default 5)
#   São dois pools de propósito — num só, o app travava (src/db/index.ts). A soma dos dois
#   tem de caber no max_connections do Postgres, junto com o que outros apps usam.
# DATABASE_ESPERA_MS=15000        (quanto uma requisição espera por conexão livre antes de desistir)
# Só durante a troca do superusuário: a URL com o usuário e a senha novos. Depois
# da troca, ela vira o DATABASE_URL e esta linha sai.
# DATABASE_URL_APP=postgres://usuario_do_app:outra-senha@host:5432/barbearia

# Onde a mídia enviada pelo dono da barbearia é gravada. **Precisa ser dentro
# do volume persistente**, senão as fotos somem no deploy seguinte. No Docker
# o Dockerfile já define /data/uploads; esta linha é para rodar fora dele.
# UPLOAD_ROOT=/data/uploads

# O fuso de cada barbearia NÃO mora aqui desde 12/10/2026: é a coluna
# tenants.timezone (migration 0013), escolhida pelo estado no cadastro e trocada
# em Configurações (src/lib/timezone.ts). A antiga TZ_BARBEARIA não é mais lida.

# Fuso do CONTAINER — usado só para decidir a hora do backup diário. Não mexe
# em horário de barbearia nenhuma.
TZ=America/Fortaleza

# Nº de proxies confiáveis à frente do app (pra ler o IP real e barrar spoofing).
# 1 = Traefik/EasyPanel direto no container (default). 2 = CDN (ex: Cloudflare) + Traefik.
# TRUSTED_PROXY_HOPS=1

# O domínio do produto. O site de cada barbearia é <slug>.<DOMINIO_BASE>, e o
# painel, painel.<DOMINIO_BASE>. Os links saem dela — o "ver meu site" do painel, o
# de cada e-mail, a tela final do cadastro (src/lib/tenant.ts). Sem ela, em produção,
# esses links somem e o e-mail de senha nova não sai: não tem para onde apontar.
# DOMINIO_BASE=exemplo.com.br
# Só se o painel NÃO morar em painel.<DOMINIO_BASE>. O link do e-mail de senha nova
# sai daqui, nunca do endereço da requisição (src/lib/tenant.ts, urlDoPainel).
# PAINEL_URL=https://painel.exemplo.com.br

# O cadastro público (/cadastrar). Sem =1, a página e a rota respondem 404 —
# fechado de propósito até o docs/PENDENCIAS-ABERTAS.md §2.31 estar resolvido.
# CADASTRO_ABERTO=1

# E-mail: a senha nova, os avisos do teste e da cobrança, o aviso de agendamento
# (src/lib/email.ts). Em produção, sem SMTP_URL, NADA sai — o boot avisa.
# SMTP_URL=smtps://usuario:senha@smtp.provedor.com:465
# Quem assina: um endereço do domínio verificado no provedor de envio. Sem ela,
# Fadeline <nao-responda@DOMINIO_BASE>.
# EMAIL_REMETENTE=Fadeline <nao-responda@exemplo.com.br>
# Opcional: para onde vai a resposta. Sem ela, quem responde o e-mail fala com ninguém.
# EMAIL_RESPONDER_PARA=suporte@exemplo.com.br
# Sem SMTP_URL, grava cada e-mail como .txt nesta pasta. Fora de produção já é o
# padrão (data/emails/); em produção, serve para testar sem provedor. Com SMTP_URL
# ela não vale: o e-mail sai pelo provedor.
# EMAIL_PASTA=data/emails

# Backup automático (opcionais — defaults entre parênteses)
#
# Cada dia gera DOIS arquivos: barbearia_<data>.sql.gz (o banco) e
# barbearia_<data>-fotos.tar.gz (o conteúdo de UPLOAD_ROOT). Separados de
# propósito: banco corrompido com fotos intactas é o caso comum, e nele
# ninguém quer mexer nas fotos. Restaurar as fotos:
#     tar -xzf barbearia_<data>-fotos.tar.gz -C /data/uploads
# BACKUP_DIR=/data/backups        (onde os dois arquivos diários ficam)
# BACKUP_RETENTION_DAYS=30        (apaga backups mais velhos que isso)
# BACKUP_HOUR=3                   (hora local do backup diário)
#
# Deploy com migration nova: antes de aplicá-la, o boot de produção faz um
# barbearia_<data>-antes-da-<NNNN>.sql.gz na mesma pasta — e, se esse backup
# falhar, o app NÃO sobe e nada é migrado (scripts/startup.mjs). Para subir
# assim mesmo, uma vez só, sabendo o que faz — e tire a variável depois:
# MIGRAR_SEM_BACKUP=1

# Upload off-site do backup (opcional — S3-compatível, ex: Backblaze B2).
# Se as 4 obrigatórias existirem, todo backup também sobe pro bucket em backups/.
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005
# S3_BUCKET=Bayron
# S3_ACCESS_KEY_ID=keyID-da-application-key
# S3_SECRET_ACCESS_KEY=applicationKey

# Senhas iniciais do seed do Bayron (npm run db:seed-bayron).
# Barbearia nova NÃO usa isto: `npm run db:provisionar` pede SENHA_INICIAL.
ADMIN_INITIAL_PASSWORD=troque-antes-do-seed
BARBER_INITIAL_PASSWORD=troque-antes-do-seed

# Cobrança pela Asaas (lib/cobranca.ts). Sem ASAAS_API_KEY, a tela de assinatura
# diz que ainda não dá para pagar por aqui, e nada é chamado.
# ⚠️ Sem ASAAS_AMBIENTE=producao é SANDBOX: a variável esquecida não cobra ninguém.
# ASAAS_API_KEY=a-chave-de-api-da-conta  (nunca no repositório: é dinheiro)
# ASAAS_AMBIENTE=sandbox                 (sandbox | producao)
# O token que você define no webhook do painel da Asaas. A rota /api/asaas/webhook
# recusa tudo sem ele — webhook aberto seria qualquer um marcando barbearia como paga.
# ASAAS_WEBHOOK_TOKEN=um-segredo-longo-e-aleatorio

# Painel do operador (/operador, só no endereço do painel): a lista das barbearias e
# as ações de estender o teste, tirar do ar e reativar (src/lib/operador.ts).
# Sem esta variável a página não existe (404). Gere com `npm run operador:senha` na
# sua máquina e cole a linha que ele imprime. ⚠️ É o HASH, nunca a senha — e trocar
# o hash derruba quem estiver dentro.
# OPERADOR_SENHA_HASH=scrypt:15:8:1:...
# O código de 6 dígitos do aplicativo do celular, além da senha (src/lib/segundoFator.ts).
# Gere com `npm run operador:segundo-fator` na sua máquina: ele mostra o QR code, confere
# um código e imprime a linha. Sem ela, só a senha. ⚠️ Fora do formato, o painel do
# operador fica DESLIGADO — cole a linha inteira. Trocar derruba quem estiver dentro.
# OPERADOR_SEGUNDO_FATOR=totp:...
