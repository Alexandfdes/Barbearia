---
export const prerender = false;

/**
 * "Entrar" leva ao painel central (`URL_PAINEL`, em `src/config.ts`).
 *
 * ⚠️ Até 12/10/2026 esta tela pedia o endereço do site da barbearia e levava ao
 * `/admin` dele, com um atalho para o último acesso guardado no navegador — o modelo
 * de um painel por barbearia. Com o painel central, o dono entra num endereço só, com
 * o WhatsApp e a senha, e é o login que descobre de qual barbearia ele é
 * (`docs/PENDENCIAS-ABERTAS.md` §4.15). O endereço `/acessar` continua existindo
 * porque é o que está nos links desta página e nos que já foram mandados.
 *
 * 302 e não 301: o endereço do painel ainda vai mudar, com o domínio definitivo — e o
 * navegador guarda o 301 para sempre.
 */
import { URL_PAINEL } from '../config';

return Astro.redirect(URL_PAINEL, 302);
---
