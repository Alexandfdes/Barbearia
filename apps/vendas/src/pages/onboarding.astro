---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { NOME_PRODUTO, whatsappUrl } from '../config';

const wa = whatsappUrl('Olá! Estou preenchendo o formulário e travei numa parte.');
---

<Layout title={`Informações da sua barbearia — ${NOME_PRODUTO}`}>
  <main class="min-h-screen">
    <header class="border-b border-line/60 sticky top-0 bg-card/95 backdrop-blur z-20">
      <div class="max-w-2xl mx-auto px-5 h-16 flex items-center justify-between">
        <a href="/" class="font-serif text-lg tracking-wide text-cream">{NOME_PRODUTO}</a>
        <a href={wa} target="_blank" rel="noopener" class="text-xs text-cream/40 hover:text-brand-light transition-colors">Preciso de ajuda</a>
      </div>
    </header>

    <div class="max-w-2xl mx-auto px-5 py-10 pb-32">
      <h1 class="font-serif text-3xl text-cream leading-tight">Me conta sobre a sua barbearia</h1>
      <p class="mt-3 text-cream/55 leading-relaxed">
        Só o que estiver marcado como obrigatório precisa ser preenchido agora. O resto,
        se não souber, deixa em branco que a gente resolve depois no WhatsApp.
      </p>

      <form id="form" class="mt-10 space-y-7">

        <!-- Básico -->
        <section class="border border-line/60 bg-card rounded-lg p-5 sm:p-6 space-y-5">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-cream/70">Sobre a barbearia</h2>

          <div>
            <label for="nomeNegocio" class="block text-xs font-medium text-cream/60 mb-1.5">Nome da barbearia <span class="text-brand-light">*</span></label>
            <input id="nomeNegocio" name="nomeNegocio" required placeholder="Barbearia do Zé"
              class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="responsavel" class="block text-xs font-medium text-cream/60 mb-1.5">Seu nome <span class="text-brand-light">*</span></label>
              <input id="responsavel" name="responsavel" required placeholder="José da Silva"
                class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="whatsapp" class="block text-xs font-medium text-cream/60 mb-1.5">WhatsApp da barbearia <span class="text-brand-light">*</span></label>
              <input id="whatsapp" name="whatsapp" required inputmode="tel" placeholder="(84) 99999-0000"
                class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
              <p class="text-[11px] text-cream/45 mt-1.5">É para onde os botões do site vão levar.</p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="endereco" class="block text-xs font-medium text-cream/60 mb-1.5">Rua e número</label>
              <input id="endereco" name="endereco" placeholder="R. Exemplo, 123"
                class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="cidade" class="block text-xs font-medium text-cream/60 mb-1.5">Cidade/UF</label>
              <input id="cidade" name="cidade" placeholder="Mossoró/RN"
                class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
            </div>
          </div>

          <div>
            <label for="instagram" class="block text-xs font-medium text-cream/60 mb-1.5">Instagram</label>
            <input id="instagram" name="instagram" placeholder="@suabarbearia"
              class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors" />
            <p class="text-[11px] text-cream/45 mt-1.5">Se tiver fotos boas por lá, me diz — eu aproveito de lá também.</p>
          </div>

          <div>
            <label for="sobre" class="block text-xs font-medium text-cream/60 mb-1.5">Como você descreveria a sua barbearia?</label>
            <textarea id="sobre" name="sobre" rows="3" placeholder="Escreva do seu jeito, sem se preocupar com português. Eu ajeito o texto."
              class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors resize-y"></textarea>
          </div>
        </section>

        <!-- Serviços -->
        <section class="border border-line/60 bg-card rounded-lg p-5 sm:p-6">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-cream/70 mb-1.5">Serviços e preços</h2>
          <p class="text-xs text-cream/40 mb-5">Coloque todos que você faz. Duração é quanto tempo cada um toma na cadeira — é o que faz a agenda não bater de frente.</p>
          <div id="servicos" class="space-y-2"></div>
          <button type="button" id="add-servico"
            class="mt-3 text-xs text-brand-light hover:text-brand border border-brand/30 hover:border-brand/50 px-3 py-1.5 rounded transition-colors">
            + Adicionar serviço
          </button>
        </section>

        <!-- Horários -->
        <section class="border border-line/60 bg-card rounded-lg p-5 sm:p-6">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-cream/70 mb-1.5">Horário de funcionamento</h2>
          <p class="text-xs text-cream/40 mb-5">Se fecha para almoço, escreva os dois turnos. Ex: 08:00 às 12:00 e 14:00 às 19:00.</p>
          <div id="horarios" class="space-y-2"></div>
          <button type="button" id="add-horario"
            class="mt-3 text-xs text-brand-light hover:text-brand border border-brand/30 hover:border-brand/50 px-3 py-1.5 rounded transition-colors">
            + Adicionar dia
          </button>
        </section>

        <!-- Fotos -->
        <section class="border border-line/60 bg-card rounded-lg p-5 sm:p-6">
          <h2 class="text-sm font-bold uppercase tracking-[0.15em] text-cream/70 mb-1.5">Logo e fotos</h2>
          <p class="text-xs text-cream/40 mb-4 leading-relaxed">
            Mande o logo e umas 15 a 20 fotos: cortes que você fez, a barbearia por dentro,
            e a fachada. Foto na horizontal costuma ficar melhor. Se estiver ruim, eu aviso.
          </p>
          <label for="arquivos"
            class="block border border-dashed border-line hover:border-brand/40 rounded-lg py-8 text-center cursor-pointer transition-colors">
            <span class="block text-brand-light text-sm font-medium">Escolher arquivos</span>
            <span class="block text-xs text-cream/45 mt-1">JPG, PNG ou WEBP · até 15 MB cada · no máximo 30</span>
            <input id="arquivos" name="arquivos" type="file" accept="image/*" multiple class="hidden" />
          </label>
          <p id="lista-arquivos" class="mt-3 text-xs text-cream/50"></p>
        </section>

        <!-- Observações -->
        <section class="border border-line/60 bg-card rounded-lg p-5 sm:p-6">
          <label for="observacoes" class="block text-sm font-bold uppercase tracking-[0.15em] text-cream/70 mb-1.5">Mais alguma coisa?</label>
          <p class="text-xs text-cream/40 mb-4">Algo que você faz diferente, um detalhe que não pode faltar, uma cor que gosta.</p>
          <textarea id="observacoes" name="observacoes" rows="3"
            class="w-full bg-ground border border-line rounded px-3 py-2.5 text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors resize-y"></textarea>
        </section>

        <div id="msg" class="hidden text-sm rounded px-4 py-3"></div>
      </form>
    </div>

    <div class="fixed bottom-0 left-0 right-0 border-t border-line/60 bg-card/95 backdrop-blur px-5 py-3 z-30">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-4">
        {import.meta.env.DEV ? (
          <button type="button" id="preencher-teste"
            class="shrink-0 text-[11px] font-medium text-cream/40 hover:text-brand-light border border-line hover:border-brand/40 px-3 py-1.5 rounded transition-colors"
            title="Só aparece em desenvolvimento">
            Preencher aleatório
          </button>
        ) : <span></span>}
        <span id="status" class="text-xs text-cream/45 flex-1 text-right"></span>
        <button id="enviar"
          class="shrink-0 bg-brand hover:bg-brand-hover text-on-brand font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition-colors text-sm disabled:opacity-50">
          Enviar
        </button>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // Sem w-full aqui de propósito: a largura vem de cada campo. Com w-full no
  // estilo base, ele vencia o w-24 do preço e estourava a linha.
  const CAMPO = 'bg-ground border border-line rounded px-3 py-2 text-sm text-cream placeholder:text-cream/40 focus:border-brand/50 focus:outline-none transition-colors';

  // Grid em vez de flex: input tem largura natural e NÃO encolhe em flexbox,
  // o que fazia cada campo cair numa linha própria no celular. Com grid,
  // as colunas mandam. min-w-0 é obrigatório para o input respeitar a coluna.
  function linha(campos, alvo, grid) {
    const div = document.createElement('div');
    div.className = `grid gap-2 items-center ${grid}`;
    div.innerHTML = campos.map((c) =>
      `<input data-${c.k} placeholder="${c.ph}" class="${CAMPO} min-w-0 ${c.cls}">`).join('') +
      `<button type="button" class="text-cream/40 hover:text-red-400 px-1 text-lg leading-none" aria-label="Remover">&times;</button>`;
    div.querySelector('button').addEventListener('click', () => div.remove());
    alvo.appendChild(div);
  }

  const servicos = document.getElementById('servicos');
  const horarios = document.getElementById('horarios');

  // Celular: nome ocupa a linha toda, preço e duração dividem a de baixo.
  // Desktop (sm+): tudo numa linha só.
  const GRID_SERVICO = 'grid-cols-[1fr_1fr_auto] sm:grid-cols-[2fr_6rem_6rem_auto]';
  const GRID_HORARIO = 'grid-cols-[1fr_1fr_auto]';

  const camposServico = [
    { k: 'nome', ph: 'Corte degradê', cls: 'col-span-3 sm:col-span-1' },
    { k: 'preco', ph: 'R$ 45', cls: '' },
    { k: 'duracao', ph: '40 min', cls: '' },
  ];
  const camposHorario = [
    { k: 'dia', ph: 'Segunda a sexta', cls: '' },
    { k: 'horario', ph: '09:00 às 19:00', cls: '' },
  ];

  for (let i = 0; i < 3; i++) linha(camposServico, servicos, GRID_SERVICO);
  for (let i = 0; i < 2; i++) linha(camposHorario, horarios, GRID_HORARIO);
  document.getElementById('add-servico').addEventListener('click', () => linha(camposServico, servicos, GRID_SERVICO));
  document.getElementById('add-horario').addEventListener('click', () => linha(camposHorario, horarios, GRID_HORARIO));

  const inputArquivos = document.getElementById('arquivos');
  const listaArquivos = document.getElementById('lista-arquivos');
  inputArquivos.addEventListener('change', () => {
    const n = inputArquivos.files.length;
    if (!n) { listaArquivos.textContent = ''; return; }
    const bytes = [...inputArquivos.files].reduce((s, f) => s + f.size, 0);
    const tamanho = bytes >= 1024 * 1024
      ? `${(bytes / 1024 / 1024).toFixed(1)} MB`
      : `${Math.max(1, Math.round(bytes / 1024))} KB`;
    listaArquivos.textContent = `${n} ${n === 1 ? 'arquivo selecionado' : 'arquivos selecionados'} · ${tamanho} no total`;
  });

  const msg = document.getElementById('msg');
  const status = document.getElementById('status');
  const btn = document.getElementById('enviar');

  function mostrar(html, erro) {
    msg.innerHTML = html;
    msg.className = erro
      ? 'text-sm rounded px-4 py-3 bg-red-500/10 border border-red-500/30 text-red-300'
      : 'text-sm rounded px-4 py-3 bg-brand/10 border border-brand/30 text-brand-light';
    msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function coletar(alvo, chaves) {
    return [...alvo.children]
      .map((l) => Object.fromEntries(chaves.map((k) => [k, l.querySelector(`[data-${k}]`).value.trim()])))
      .filter((o) => Object.values(o).some((v) => v));
  }

  btn.addEventListener('click', async () => {
    msg.className = 'hidden';
    const fd = new FormData();
    ['nomeNegocio', 'responsavel', 'whatsapp', 'endereco', 'cidade', 'instagram', 'sobre', 'observacoes']
      .forEach((id) => fd.append(id, document.getElementById(id).value.trim()));

    if (!fd.get('nomeNegocio') || !fd.get('responsavel') || !fd.get('whatsapp')) {
      mostrar('Preencha o nome da barbearia, o seu nome e o WhatsApp — o resto pode ficar para depois.', true);
      return;
    }

    fd.append('servicos', JSON.stringify(coletar(servicos, ['nome', 'preco', 'duracao'])));
    fd.append('horarios', JSON.stringify(coletar(horarios, ['dia', 'horario'])));
    for (const f of inputArquivos.files) fd.append('arquivos', f);

    btn.disabled = true;
    status.textContent = inputArquivos.files.length ? 'Enviando fotos…' : 'Enviando…';
    try {
      const res = await fetch('/api/onboarding', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('form').classList.add('hidden');
        mostrar(
          `<strong class="block text-base mb-1">Recebido!</strong>` +
          `Seu protocolo é <strong class="font-mono">${data.protocolo}</strong>. ` +
          `Guarde esse código — se precisar falar comigo, é por ele que eu acho o seu envio. ` +
          `Vou olhar tudo e te chamo no WhatsApp.`, false);
        status.textContent = '';
        btn.style.display = 'none';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        mostrar(data.error ?? 'Não consegui enviar. Tente de novo.', true);
        status.textContent = '';
        btn.disabled = false;
      }
    } catch {
      mostrar('Sem conexão com o servidor. Verifique a internet e tente de novo.', true);
      status.textContent = '';
      btn.disabled = false;
    }
  });
</script>

{import.meta.env.DEV && (
<script is:inline>
  // ─────────────────────────────────────────────────────────────────────────────
  // Preenchimento aleatório — APENAS em desenvolvimento.
  // O botão só é renderizado quando import.meta.env.DEV é verdadeiro, então em
  // produção este bloco não encontra o elemento e não faz nada.
  // ─────────────────────────────────────────────────────────────────────────────
  const btnTeste = document.getElementById('preencher-teste');
  if (btnTeste) {
    const sorteia = (a) => a[Math.floor(Math.random() * a.length)];
    const varios = (a, n) => [...a].sort(() => Math.random() - 0.5).slice(0, n);

    const NEGOCIOS = ['Barbearia do Zé', 'Navalha de Ouro', 'Barbearia Central', 'Corte & Cia',
      'Studio Barba Negra', 'Barbearia Imperial', 'Don Juan Barbearia', 'Barbearia Vintage',
      'Barbearia Sete Cortes', 'Reis da Navalha'];
    const PESSOAS = ['José da Silva', 'Marcos Antônio Lima', 'Emanuel Duarte', 'Rafael Nunes',
      'Jackson Oliveira', 'Paulo Henrique Souza', 'Wesley Cavalcante', 'Diego Fernandes'];
    const RUAS = ['R. Jaen Menescal, 174', 'Av. Rio Branco, 820', 'R. Dix-sept Rosado, 45',
      'Av. Presidente Dutra, 1290', 'R. Coronel Gurgel, 308', 'Av. Alberto Maranhão, 77'];
    const CIDADES = ['Mossoró/RN', 'Natal/RN', 'Assú/RN', 'Caraúbas/RN', 'Pau dos Ferros/RN', 'Apodi/RN'];
    const SOBRES = [
      'Barbearia de bairro, atendimento sem pressa, cliente sai satisfeito.',
      'Trabalho com corte e barba há doze anos. Aqui ninguém sai sem gostar.',
      'Ambiente tranquilo, café na casa e corte bem feito. Simples assim.',
      'Especialista em degradê e barba desenhada. Atendo com hora marcada.',
    ];
    const OBS = [
      'Gosto de verde escuro. Não curto site muito colorido.',
      'Queria destacar o combo de corte com barba, que é o que mais sai.',
      'Tenho um cachorro que fica na barbearia, os clientes adoram. Se der pra aparecer numa foto, seria legal.',
      'Fecho na segunda. Isso precisa ficar bem claro no site.',
      '',
    ];
    const SERVICOS = [
      { nome: 'Corte social', preco: 'R$ 40', duracao: '30 min' },
      { nome: 'Corte degradê', preco: 'R$ 45', duracao: '40 min' },
      { nome: 'Corte navalhado', preco: 'R$ 45', duracao: '40 min' },
      { nome: 'Só tesoura', preco: 'R$ 40', duracao: '30 min' },
      { nome: 'Barba simples', preco: 'R$ 30', duracao: '25 min' },
      { nome: 'Barba e pezinho', preco: 'R$ 35', duracao: '30 min' },
      { nome: 'Corte + barba', preco: 'R$ 65', duracao: '1h' },
      { nome: 'Pigmentação de barba', preco: 'R$ 45', duracao: '40 min' },
      { nome: 'Hidratação', preco: 'R$ 15', duracao: '15 min' },
      { nome: 'Sobrancelha na navalha', preco: 'R$ 10', duracao: '10 min' },
      { nome: 'Depilação nasal', preco: 'R$ 10', duracao: '10 min' },
      { nome: 'Primeiro corte (infantil)', preco: 'R$ 40', duracao: '40 min' },
    ];
    const HORARIOS = [
      [{ dia: 'Segunda a sexta', horario: '09:00 às 19:00' }, { dia: 'Sábado', horario: '08:00 às 17:00' }, { dia: 'Domingo', horario: 'Fechado' }],
      [{ dia: 'Terça a sábado', horario: '08:00 às 12:00 e 14:00 às 19:00' }, { dia: 'Domingo e segunda', horario: 'Fechado' }],
      [{ dia: 'Segunda a sábado', horario: '10:00 às 20:00' }, { dia: 'Domingo', horario: 'Fechado' }],
    ];

    function telefone() {
      const ddd = sorteia(['84', '84', '84', '81', '85']);
      const n = String(Math.floor(10000000 + Math.random() * 89999999));
      return `(${ddd}) 9${n.slice(0, 4)}-${n.slice(4)}`;
    }

    /** Gera imagens de verdade no navegador para testar o upload sem procurar arquivo. */
    async function fotosFalsas(quantidade) {
      const arquivos = [];
      for (let i = 0; i < quantidade; i++) {
        const c = document.createElement('canvas');
        c.width = 640; c.height = 480;
        const x = c.getContext('2d');
        const h = Math.floor(Math.random() * 360);
        x.fillStyle = `hsl(${h} 35% 22%)`;
        x.fillRect(0, 0, 640, 480);
        x.fillStyle = `hsl(${h} 45% 60%)`;
        x.font = 'bold 46px sans-serif';
        x.textAlign = 'center';
        x.fillText(`FOTO ${i + 1}`, 320, 250);
        const blob = await new Promise((r) => c.toBlob(r, 'image/png'));
        arquivos.push(new File([blob], `foto-teste-${i + 1}.png`, { type: 'image/png' }));
      }
      const dt = new DataTransfer();
      arquivos.forEach((f) => dt.items.add(f));
      return dt.files;
    }

    btnTeste.addEventListener('click', async () => {
      btnTeste.disabled = true;
      const texto = btnTeste.textContent;
      btnTeste.textContent = 'Preenchendo…';

      const negocio = sorteia(NEGOCIOS);
      document.getElementById('nomeNegocio').value = negocio;
      document.getElementById('responsavel').value = sorteia(PESSOAS);
      document.getElementById('whatsapp').value = telefone();
      document.getElementById('endereco').value = sorteia(RUAS);
      document.getElementById('cidade').value = sorteia(CIDADES);
      document.getElementById('instagram').value = '@' + negocio.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
      document.getElementById('sobre').value = sorteia(SOBRES);
      document.getElementById('observacoes').value = sorteia(OBS);

      servicos.innerHTML = '';
      varios(SERVICOS, 4 + Math.floor(Math.random() * 5)).forEach((sv) => {
        linha(camposServico, servicos, GRID_SERVICO);
        const l = servicos.lastElementChild;
        l.querySelector('[data-nome]').value = sv.nome;
        l.querySelector('[data-preco]').value = sv.preco;
        l.querySelector('[data-duracao]').value = sv.duracao;
      });

      horarios.innerHTML = '';
      sorteia(HORARIOS).forEach((h) => {
        linha(camposHorario, horarios, GRID_HORARIO);
        const l = horarios.lastElementChild;
        l.querySelector('[data-dia]').value = h.dia;
        l.querySelector('[data-horario]').value = h.horario;
      });

      inputArquivos.files = await fotosFalsas(2 + Math.floor(Math.random() * 3));
      inputArquivos.dispatchEvent(new Event('change'));

      btnTeste.disabled = false;
      btnTeste.textContent = texto;
      status.textContent = 'Preenchido com dados falsos';
    });
  }
</script>
)}
