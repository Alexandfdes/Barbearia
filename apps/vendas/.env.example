# quando o formulário da montagem assistida (/onboarding, /envios, /obrigado) saiu.

# Os botões da landing. A MESMA variável que abre o /cadastrar no app da barbearia: sem ela,
# os botões de cadastro não aparecem.
# CADASTRO_ABERTO=1
# Para onde os botões levam. ⚠️ Sem as duas, eles apontam para o localhost — em produção,
# preencha com o endereço do painel.
# URL_CADASTRO=https://painel.<seu-dominio>/cadastrar
# URL_PAINEL=https://painel.<seu-dominio>/admin/login
