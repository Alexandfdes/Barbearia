# Caminho do banco (default: ./data/produto.db)
# DATABASE_PATH=./data/produto.db

# Pasta onde ficam as fotos enviadas no onboarding (default: ./data/uploads)
# UPLOAD_ROOT=./data/uploads

# Senha da área de envios (/envios). Mínimo 6 caracteres.
# SEM ela a área fica fechada — é o padrão seguro, não um bug.
ADMIN_SENHA=troque-por-uma-senha-sua

# Assinatura do cookie da área de envios. Sem ela, o cookie é assinado com a própria
# ADMIN_SENHA — quem tiver um cookie pode testar senhas fora do ar. Use um valor longo e aleatório.
# SESSION_SECRET=

# Os botões da landing. A MESMA variável que abre o /cadastrar no app da barbearia: sem ela,
# os botões de cadastro não aparecem.
# CADASTRO_ABERTO=1
# Para onde os botões levam. ⚠️ Sem as duas, eles apontam para o localhost — em produção,
# preencha com o endereço do painel.
# URL_CADASTRO=https://painel.<seu-dominio>/cadastrar
# URL_PAINEL=https://painel.<seu-dominio>/admin/login
